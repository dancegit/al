def unit_spec(kind: str, name: str, ir: dict) -> dict[str, str]:
    """The facts of one unit (kind: cron | webhook | dashboard | stand-in), shared by systemd_unit() and the Home
    Manager module of a (host …) (tools/al_provision.py), so the two cannot drift apart:
    description, the layer-relative script ExecStart runs, Restart, RestartSec ("" = none) and the
    token env-file lines (comment and EnvironmentFile=, "" = none)."""
    if kind == "cron":
        return {"description": f"Agentic layer cron trigger for {name}", "script": "adws/triggers/trigger_cron.py",
                "restart": "on-failure", "restart_sec": "10", "env_file": ""}
    if kind == "webhook":
        t = next(t for t in ir["triggers"] if t["kind"] == "webhook")
        return {"description": f"Agentic layer webhook trigger for {name} ({t['bind']}:{t['port']}{t['path']})",
                "script": "adws/triggers/trigger_webhook.py", "restart": "on-failure", "restart_sec": "", "env_file": ""}
    if kind == "stand-in":   # the stand-in's loop without the page: the dashboard script with --stand-in-only
        return {"description": f"Stand-in of the {name} agentic layer (its loop, without the page)",
                "script": "adws/dashboard.py", "restart": "on-failure", "restart_sec": "5", "env_file": "",
                "extra_args": "--stand-in-only"}
    if kind == "dashboard":
        d = ir.get("dashboard") or DEFAULT_DASHBOARD
        env_file = (f"# The access token: put {d['tokenEnv']}=… in this file (chmod 600), or remove the line.\n"
                    f"EnvironmentFile=-%h/.config/al/{name}-dashboard.env\n") if d["tokenEnv"] else ""
        return {"description": f"Work dashboard of the {name} agentic layer ({dashboard_url_of(d)})",
                "script": "adws/dashboard.py", "restart": "on-failure", "restart_sec": "5", "env_file": env_file}
    raise AlError(f"no systemd unit for {kind!r}")
def nested_engine_module():
    """kit/runtime/adw_modules/nested_engine.py, loaded by path: the image recipe takes the inner
    engine's packages and configuration texts from the runtime's own module (one source)."""
    import importlib.util

    path = KIT / "runtime" / "adw_modules" / "nested_engine.py"
    spec = importlib.util.spec_from_file_location("al_kit_nested_engine", path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def systemd_unit(kind: str, name: str, layer: Path | str, ir: dict, *, header: str | None = None,
                 path_env: str = "", env_file: str = "", extra_args: str = "") -> str:
    """The text of one systemd user unit (kind: cron | webhook | dashboard) that keeps a part of the
    layer at `layer` running, built from unit_spec(). The one source of unit text: `al gen` calls it
    with the defaults (the unit names this machine's paths, so it is never committed), `al deploy`
    with the paths of the host it deploys to (header, the host's login PATH, an EnvironmentFile for
    secrets, extra arguments for ExecStart) and writes the result only on that host."""
    spec = unit_spec(kind, name, ir)
    first = header if header is not None else (
        f"# Generated by al. Install: cp to ~/.config/systemd/user/ && systemctl --user enable --now al-{name}-{kind}")
    service = (f"Environment=PATH={path_env}\n" if path_env else "") + (f"EnvironmentFile=-{env_file}\n" if env_file else "")
    extra_args = " ".join(part for part in (spec.get("extra_args", ""), extra_args) if part)
    args = f" {extra_args}" if extra_args else ""
    restart_sec = f"RestartSec={spec['restart_sec']}\n" if spec["restart_sec"] else ""
    return f"""{first}
[Unit]
Description={spec['description']}

[Service]
{service}ExecStart=/usr/bin/env uv run {layer}/{spec['script']}{args}
{spec['env_file']}Restart={spec['restart']}
{restart_sec}
[Install]
WantedBy=default.target
"""


