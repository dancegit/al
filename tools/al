def lock_line(layer: Path, ir: dict) -> str | None:
    """`al gen`: write env/flake.lock when a toolchain exists and there is none; one line saying what happened."""
    if not ir.get("toolchains"):
        return None
    if (layer / "env/flake.lock").is_file():
        return f"lock: env/flake.lock kept (`al sandbox {layer} update` re-pins it)"
    if os.environ.get("AL_SANDBOX_OFFLINE") == "1":
        return (f"lock: env/flake.lock not written: AL_SANDBOX_OFFLINE=1 (`al sandbox {layer} update` writes it)")
    try:
        images = _layer_images(layer)
        way = images.choose_way()
        images.lock(layer / "env", way=way)
        return f"lock: env/flake.lock written ({images.way_sentence(way)})"
    except Exception as exc:  # noqa: BLE001 — pinning is best effort here; `al gen` itself succeeded
        first = str(exc).splitlines()[0] if str(exc) else type(exc).__name__
        return f"warning: lock: env/flake.lock not written: {first} (run `al sandbox {layer} update` once it can)"


def cmd_sandbox_update(a: argparse.Namespace) -> int:
    """al sandbox LAYER update: re-pin the toolchains' nixpkgs in env/flake.lock and show what changed."""
    layer = a.layer.resolve()
    _sandbox_ir(layer)
    images = _layer_images(layer)
    try:
        way = images.choose_way()
        rows = images.update(layer / "env", way=way)
    except images.BuildError as exc:
        raise AlError(f"sandbox: {exc}") from exc
    print(f"sandbox: env/flake.lock re-pinned ({images.way_sentence(way)})")
    for line in images.describe_lock_diff(rows):
        print(f"  {line}")
    if any(r["changed"] for r in rows):
        print(f"run `al sandbox {layer} build` to rebuild")
    else:
        print("env/flake.lock unchanged: nothing to rebuild")
    return 0


def layer_placement_module(layer: Path):
    """The layer's own scheduler and host link (adw_modules/placement.py, hostlink.py), so `al hosts`
    and `al host` see exactly what a starting run sees."""
    if not (layer / "agentic-layer.json").is_file() or not (layer / "adws/adw_modules/placement.py").is_file():
        if (layer / "agentic-layer.json").is_file() and (layer / "adws/adw_modules").is_dir():
            raise AlError(f"{layer} was generated before `al hosts`: run `al gen {layer}`")
        raise AlError(f"{layer} is not a generated layer: run `al gen {layer}` first")
    for name in [n for n in sys.modules if n == "adw_modules" or n.startswith("adw_modules.")]:
        del sys.modules[name]   # another layer's runtime may have been imported before
    sys.path.insert(0, str(layer / "adws"))
    try:
        from adw_modules import errors, hostlink, ir as ir_module, placement
    except ImportError as exc:
        raise AlError(f"cannot import the layer runtime from {layer / 'adws'}: {exc}") from exc
    return placement, hostlink, ir_module, errors


NO_PLACEMENT = ("declares no (placement …), so every run executes on this machine; declare one in agentic.rkt, "
                "e.g. (placement auto #:hosts (home build-1)), and run al gen")


def _placed_layer(layer: Path, command: str):
    """(placement module, hostlink module, the loaded layer) of a layer that declares a placement; exits 2 otherwise."""
    placement, hostlink, ir_module, errors = layer_placement_module(layer)
    try:
        loaded = ir_module.load(layer)
    except errors.LayerError as exc:
        raise AlError(str(exc)) from exc
    if placement.declared(loaded) is None:
        print(f"al {command}: {loaded.name} {NO_PLACEMENT}", file=sys.stderr)
        raise SystemExit(2)
    return placement, hostlink, loaded


def hosts_cli(a: argparse.Namespace) -> int:
    """al hosts LAYER status: one survey, printed as the table the scheduler decides from."""
    placement, _hostlink, loaded = _placed_layer(a.layer.resolve(), "hosts")
    found = placement.survey(loaded)
    if a.json:
        print(json.dumps({"layer": loaded.name, "placement": placement.declared(loaded), "hosts": found}, indent=2))
        return 0
    print(placement.headline(loaded))
    print(placement.render(placement.table(found)))
    return 0


def host_cli(a: argparse.Namespace) -> int:
    """al host LAYER HOST doctor: the host's own check of what a run needs there. Exit 1 when something is missing."""
    placement, hostlink, loaded = _placed_layer(a.layer.resolve(), "host")
    hosts = [h for h in placement.declared(loaded)["hosts"] if h != placement.HOME]
    if a.host not in hosts:
        print(f"al host: {a.host} is not a host of {loaded.name}'s (placement …); hosts other than home: "
              f"{', '.join(hosts) or '(none)'}", file=sys.stderr)
        return 2
    try:
        answer = hostlink.link_for(loaded, a.host).tool(loaded, a.host, "doctor", timeout=90)
    except hostlink.HostSilent as exc:
        print(f"host {a.host}: no answer: {exc.reason}")
        print(f"  fix: check that `ssh` reaches it with {hostlink.env_name(a.host)}, and that the layer is deployed "
              f"there: al deploy {a.layer} --to HOST --as {a.host}")
        return 1
    rows = [r for r in answer.get("rows") or [] if isinstance(r, dict)]
    width = max([len(str(r.get("name"))) for r in rows] or [0])
    print(f"host {a.host}:")
    for row in rows:
        print(f"  {'ok     ' if row.get('ok') else 'MISSING'} {str(row.get('name')).ljust(width)}  {row.get('detail')}")
        if not row.get("ok") and row.get("fix"):
            print(f"          fix: {row['fix']}")
    missing = [r for r in rows if not r.get("ok")]
    print(f"{len(missing)} missing" if missing else "a run can execute on this host")
    return 1 if missing else 0


