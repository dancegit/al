def duration_cell(row: dict | None) -> str:
    """The `typical duration` cell of a command: what `al scout --into` measured, else UNVERIFIED."""
    if not row:
        return "UNVERIFIED"
    if row.get("exit") == 0:
        return f"{row['seconds']}s (measured by al scout, exit 0)"
    return f"UNVERIFIED ({row.get('result') or 'not run'})"


