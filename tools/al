def sha256_text(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def sha256_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def load_manifest(layer: Path) -> dict[str, str | None]:
    """Generated file -> sha256 recorded by the last `al gen`. A manifest written by al 0.1 is a
    plain file list: its files map to None (hash unknown: never reported as hand-edited)."""
    entries: dict[str, str | None] = {}
    for name in (MANIFEST, LOCAL_MANIFEST):
        path = layer / name
        if not path.is_file():
            continue
        try:
            files = json.loads(path.read_text()).get("files", [])
        except (json.JSONDecodeError, AttributeError) as exc:
            raise AlError(f"{path} is not a manifest written by al ({exc}); delete it and run `al gen` again") from exc
        if isinstance(files, dict):
            entries.update({str(k): (str(v) if v else None) for k, v in files.items()})
        else:
            entries.update({str(f): None for f in files})
    return entries


