# check
# ------------------------------------------------------------------------------------------

def check_layer(layer: Path) -> list[str]:
    import yaml
    problems: list[str] = []
    ir = json.loads((layer / "agentic-layer.json").read_text())
    if ir != compile_layer(layer):
        problems.append("agentic-layer.json is stale: run `al gen`")
    need = [f"commands/{c['name']}.md" for c in ir["commands"]] + [f"hops/{h['name']}.md" for h in ir["hops"]]
    need += [f"adws/adw_{a['name']}.py" for a in ir["adws"]] + ["adws/adw_modules/runner.py", "adws/dispatch.py", "AL-DSL.llms.txt"]
    kinds = {e["kind"] for e in ir["environments"]}
    need += [f for k, f in (("nix-devshell", "env/flake.nix"), ("home-manager", "env/home-manager.nix"), ("podman", "env/Containerfile")) if k in kinds]
    for c in ir["commands"]:
        need += [f"fabric/{p}/system.md" for p in c["fabric"]]
    for rel in need:
        if not (layer / rel).is_file():
            problems.append(f"missing {rel}")
    for f in list((layer / "commands").glob("*.md")) + list((layer / "hops").glob("*.md")):
        left = re.findall(r"\{\{[a-z_]+\}\}", f.read_text())
        if left:
            problems.append(f"{f.relative_to(layer)}: unfilled placeholders {sorted(set(left))}")
    for f in layer.glob("forge/**/*.yml"):
        try:
            doc = yaml.safe_load(f.read_text())
            if "jobs" not in doc or not (doc.get("on") or doc.get(True)):
                problems.append(f"{f.relative_to(layer)}: not a workflow (no on/jobs)")
        except yaml.YAMLError as e:
            problems.append(f"{f.relative_to(layer)}: invalid YAML: {e}")
    for f in layer.glob("adws/**/*.py"):
        cp = run([sys.executable, "-m", "py_compile", str(f)], check=False)
        if cp.returncode != 0:
            problems.append(f"{f.relative_to(layer)}: does not compile: {cp.stderr.strip().splitlines()[-1]}")
    app = (layer / ir["codebase"]["root"]).resolve()
    if not app.exists():
        problems.append(f"application checkout {app} not found")
    else:
        dirty = git(app, "status", "--porcelain")
        if dirty:
            problems.append(f"application working tree is not clean:\n{dirty}")
        if layer.resolve() == app or app in layer.resolve().parents:
            problems.append("layer lives inside the application tree")
    return problems


