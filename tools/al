def apt_guarded(packages: list[str], why: str) -> str:
    """A RUN line installing Debian packages into an image al did not choose: when the image has no
    apt-get it says what to do instead of failing obscurely."""
    names = " ".join(packages)
    return (f"RUN if command -v apt-get >/dev/null 2>&1; then apt-get update && apt-get install -y --no-install-recommends "
            f"{names} && rm -rf /var/lib/apt/lists/*; else echo 'al: this image has no apt-get; install {names} ({why}) "
            f"with #:setup' >&2; exit 1; fi")


