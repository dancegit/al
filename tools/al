def cycle_cli(a: argparse.Namespace) -> int:
    """`al cycle LAYER status|start|close`: 0 on success, 1 with `al cycle: <reason>: <words>`."""
    layer = a.layer.resolve()
    delivery, ir_module, errors = layer_delivery_module(layer)
    try:
        loaded = ir_module.load(layer)
        if a.action == "status":
            result = delivery.cycle_status(loaded)
            lines = delivery.status_lines(result)
        elif a.action == "start":
            result = delivery.cycle_start(loaded, name=a.name, version=a.version, push=a.push)
            lines = []
            kind = loaded.ir["cycle"]["kind"]
            if result.get("closed"):
                lines.append(_closed_line(kind, result["closed"], delivery.cycle_status(loaded)["into"]["branch"]))
            current = result["current"]
            lines.append(f"cycle: {kind} {current['name']} opened: branch {current['branch']} from "
                         f"{result['source']['branch']} at {current['from_commit'][:7]}")
            if result.get("pushed"):
                lines.append(f"pushed: {current['branch']} to {result['pushed']}")
        else:
            if a.name or a.version or a.push:
                print("al cycle: --name, --version and --push go with start", file=sys.stderr)
                return 2
            result = delivery.cycle_close(loaded)
            lines = [_closed_line(loaded.ir["cycle"]["kind"], result["closed"], result["into"]), f"next: {result['next']}"]
    except delivery.DeliveryError as exc:
        print(f"al cycle: {exc.reason}: {exc.message}", file=sys.stderr)
        return 1
    except errors.LayerError as exc:
        print(f"al cycle: {exc}", file=sys.stderr)
        return 1
    print(json.dumps(result, indent=2, sort_keys=True) if a.json else "\n".join(lines))
    return 0


def _closed_line(kind: str, closed: dict, into: str) -> str:
    how = f"already in {into}" if closed.get("accepted") else f"not merged into {into}; a person accepts it"
    return f"cycle: {kind} {closed['name']} closed ({how})"


