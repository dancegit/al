    # ---------------------------------------------------------------- environments the repository describes

    def app_file(self, rel: str, who: str) -> str:
        """A file of the application as it is on its default branch (`git show`), never the working tree."""
        app, branch = app_root_of(self.layer, self.ir), self.cb["defaultBranch"]
        cp = run(["git", "-C", str(app), "show", f"{branch}:{rel}"], check=False)
        if cp.returncode != 0:
            raise AlError(f"{who}: {rel} is not on branch {branch} of the application ({app})")
        return cp.stdout

    @staticmethod
    def flake_file(flake: str) -> str:
        directory = flake.strip("/")
        return "flake.nix" if directory in ("", ".") else f"{directory}/flake.nix"

    def flake_wrapper(self, e: dict, hook: str) -> None:
        """env/flake.nix wrapping the repository's own dev shell (inputsFrom) and adding the extras.
        It names this machine's checkout of the application, so it is a local file."""
        name, branch = self.ir["name"], self.cb["defaultBranch"]
        self.app_file(self.flake_file(e["flake"]), "(environment nix-devshell)")
        directory = e["flake"].strip("/")
        url = (f"git+file://{app_root_of(self.layer, self.ir)}?ref={branch}"
               + ("" if directory in ("", ".") else f"&dir={directory}"))
        packages = f"(with pkgs; [ {' '.join(e['packages'])} ])" + (BROWSER_NIX_PACKAGES if e["browser"] else "")
        self.write("env/flake.nix", f'''# Generated by al from agentic.rkt — do not edit.
# Wraps the dev shell `{e['shell']}` of the application's own flake ({self.flake_file(e['flake'])} on branch {branch}):
# its packages, inputs and shellHook come from there (inputsFrom); al adds only what is below. The
# `app` input is refreshed at the start of every run, so each run uses the default branch as it is then.
{{
  description = "Agentic layer toolchain for {name}: the application's dev shell {e['shell']}";

  inputs.nixpkgs.url = "{e['nixpkgs']}";
  inputs.app.url = "{url}";

  outputs = {{ self, nixpkgs, app }}:
    let
      systems = [ "x86_64-linux" "aarch64-linux" "x86_64-darwin" "aarch64-darwin" ];
      forAllSystems = nixpkgs.lib.genAttrs systems;
      lib = nixpkgs.lib;
    in {{
      devShells = forAllSystems (system:
        let pkgs = import nixpkgs {{ inherit system; }};
        in {{
          default = pkgs.mkShell {{
            inputsFrom = [ app.devShells.${{system}}."{e['shell']}" ];
            packages = {packages};
            shellHook = \'\'
              export AL_LAYER="{name}"
              {hook}
            \'\'{BROWSER_NIX_HOOK if e["browser"] else ""};
          }};
        }});
    }};
}}
''', local=True)

    def flake_source_md(self, e: dict) -> list[str]:
        return [f"## Nix dev shell (`{e['id']}`)", "",
                f"- reused: dev shell `{e['shell']}` of `{self.flake_file(e['flake'])}` on branch `{self.cb['defaultBranch']}` "
                "(inputsFrom: its packages, inputs and shellHook)",
                "- refreshed at the start of every run (`nix flake lock --update-input app`)",
                *([f"- added: {' '.join(e['packages'])}"] if e["packages"] else []),
                *(["- added: a headless Chromium (Linux) with AL_BROWSER and CHROME_BIN"] if e["browser"] else []),
                "- not reused: plain attributes set on the repository's shell derivation (inputsFrom carries only "
                "its inputs and shellHook)", ""]

    def agent_cli_lines(self, option_id: str) -> list[str]:
        """RUN lines installing the agent CLIs of the ADWs whose stack has this podman option."""
        agents = {a["id"]: a for a in self.ir["agents"]}
        kinds: list[str] = []
        for adw in self.ir["adws"]:
            if option_id in adw["environment"]:
                for agent_id in [adw["agent"], *(s.get("agent") for s in adw["steps"] if s.get("kind") == "run")]:
                    kind = agents.get(agent_id or "", {}).get("kind")
                    if kind in AGENT_CLI_INSTALL and kind not in kinds:
                        kinds.append(kind)
        return [f"RUN {AGENT_CLI_INSTALL[k]}" for k in kinds]

    def sourced_containerfile(self, e: dict) -> tuple[dict, list[str]]:
        """The thin env/Containerfile on top of the repository's Containerfile or dev container.
        Returns (the `podman` entry of env/source.json, the lines of env/SOURCE.md)."""
        name, branch = self.ir["name"], self.cb["defaultBranch"]
        who = f"(environment podman #:id {e['id']})"
        base = f"localhost/al-{name}-base:latest"
        image, publish, prepare, not_honoured, packages = "", [], "", [], []
        container_env: dict[str, str] = {}
        md = [f"## Container image (`{e['id']}`)", ""]
        if e["containerfile"]:
            self.app_file(e["containerfile"], who)
            build = {"containerfile": e["containerfile"], "target": e["target"], "context": e["context"]}
            stage = f" (stage {e['target']})" if e["target"] else ""
            header = (f"# A thin layer on top of the repository's own {e['containerfile']}{stage}, context {e['context']},\n"
                      f"# which each run builds from its worktree (branch {branch}) as {base}.")
            md.append(f"- base: `{e['containerfile']}`{stage}, context `{e['context']}`, built by each run from its "
                      f"worktree (branch `{branch}`) as `{base}`")
        else:
            envscan = envscan_module()
            text = self.app_file(e["devcontainer"], who)
            try:
                plan = envscan.devcontainer_plan(envscan.read_devcontainer(text), os.path.dirname(e["devcontainer"]) or ".")
            except ValueError as exc:
                raise AlError(f"{who}: {e['devcontainer']} does not parse as JSON with comments: {exc}") from exc
            if plan["problems"]:
                raise AlError(f"{who}: {e['devcontainer']}: " + "; ".join(plan["problems"]))
            if not (plan["image"] or plan["build"]):
                raise AlError(f"{who}: {e['devcontainer']} names no `image` and no `build`"
                              + (" (a dev container made of compose services, dockerComposeFile, is not reused)" if plan["compose"] else "")
                              + "; declare the image with #:containerfile (e.g. the service's Dockerfile) or #:base-image instead")
            build, image = plan["build"], plan["image"]
            if build:
                self.app_file(build["containerfile"], who)
            packages, container_env = plan["packages"], plan["container_env"]
            publish, not_honoured = plan["forward_ports"], plan["not_honoured"]
            users = [a for a in self.ir["adws"] if e["id"] in a["environment"]]
            replaced = bool(users) and all(any(o["kind"] == "worktree" and o.get("prepare") for o in self.ir["environments"]
                                               if o["id"] in a["environment"]) for a in users)
            prepare = "" if replaced else plan["post_create"]
            what = f"its image {image}" if image else f"its build {build['containerfile']}, which each run builds from its worktree as {base}"
            header = f"# A thin layer on top of the repository's dev container {e['devcontainer']} (branch {branch}):\n# {what}."
            md.append(f"- base: dev container `{e['devcontainer']}` (branch `{branch}`): " + (
                f"image `{image}`" if image else f"build `{build['containerfile']}`"
                + (f" stage `{build['target']}`" if build["target"] else "") + f", context `{build['context']}`"))
            md += [f"- honoured: {h}" for h in plan["honoured"]]
            if plan["post_create"]:
                md.append("- postCreateCommand: replaced by #:prepare" if replaced
                          else f"- postCreateCommand: the run's prepare step (`{plan['post_create']}`)")
            md += [f"- not honoured: {n['item']} — {n['reason']}" for n in not_honoured]
            self.notes += [f"{who}: {n['item']} of {e['devcontainer']} is not honoured: {n['reason']}" for n in not_honoured]
        if build:
            image = ""
        lines = ["# Generated by al from agentic.rkt — do not edit.", header, f"FROM {image or base}", "USER root"]
        if packages:
            lines.append(apt_guarded(packages, "the dev container's features"))
        if e["browser"]:
            lines += [apt_guarded(BROWSER_APT, "#:browser"), BROWSER_ENV]
        if e["packages"]:
            lines.append(apt_guarded(e["packages"], "#:packages"))
        lines += [f"ENV {key}={json.dumps(value)}" for key, value in container_env.items()]
        lines += [f"RUN {s}" for s in e["setup"]]
        agent_lines = self.agent_cli_lines(e["id"]) if e["agentInside"] else []
        lines += agent_lines
        lines += ["ENV HOME=/tmp/home", "RUN mkdir -p /tmp/home && chmod 1777 /tmp/home", "WORKDIR /work",
                  "ENTRYPOINT []", "CMD []", ""]
        self.write("env/Containerfile", "\n".join(lines))
        added = (["the run user's home (/tmp/home)"] + (["a headless Chromium"] if e["browser"] else [])
                 + ([f"packages {' '.join(e['packages'])}"] if e["packages"] else [])
                 + ([f"{len(e['setup'])} #:setup line(s)"] if e["setup"] else []) + (["the agent CLI"] if agent_lines else []))
        if publish:
            md.append(f"- published: {' '.join(map(str, publish))} (forwardPorts, after #:publish)")
        md += [f"- added by al: {', '.join(added)}; the image's entrypoint and command are reset", ""]
        return ({"option": e["id"], "build": build, "image": image, "publish": publish, "prepare": prepare,
                 "notHonoured": not_honoured}, md)

    def hosts(self) -> None:
        """env/hosts/<id>/{home-manager.nix,nixos.nix,provision.sh} of each (host …): committed, they
        name no host, user, path or secret (tools/al_provision.py)."""
        hosts = self.ir.get("hosts") or []
        if not hosts:
            return
        prov = provision_module()
        pins = prov.load_pins()
        name = self.ir["name"]
        for h in hosts:
            ir = prov.with_host_port(self.ir, h)
            units = [(kind, unit_spec(kind, name, ir)) for kind in prov.host_units(self.ir, h)]
            base = f"env/hosts/{h['id']}"
            self.write(f"{base}/home-manager.nix", prov.home_manager_module(self.ir, name, f"al-{name}", [], units=units, host=h))
            self.write(f"{base}/nixos.nix", prov.nixos_module(self.ir, h))
            self.write(f"{base}/provision.sh", prov.provision_script(self.ir, h, pins), 0o755)

    # --- toolchains -------------------------------------------------------------------------

    def toolchain(self, tid: str) -> dict:
        return next(t for t in self.ir.get("toolchains") or [] if t["id"] == tid)

    @staticmethod
    def unfree_names(t: dict) -> list[str]:
        """The unfree packages a toolchain brings: agent CLIs that agent-cli.json lists as unfree."""
        if "agent-cli" not in t["features"]:
            return []
        unfree = json.loads((TOOLCHAIN_KIT / "agent-cli.json").read_text())["unfree"]
        return [k for k in t["agentClis"] if k in unfree]

    def toolchain_files(self, envs: dict[str, dict]) -> None:
        """env/ for a layer whose environments use a toolchain: the copied kit files, one
        toolchain-<id>.nix per toolchain (the one package set every consumer imports), the flake
        (dev shell, sandbox image, per-feature outputs for the size report) and the Containerfile
        that puts the #:setup lines on top of the Nix-built image."""
        name = self.ir["name"]
        toolchains = self.ir["toolchains"]
        for f in TOOLCHAIN_FILES:
            self.write(f"env/{f}", (TOOLCHAIN_KIT / f).read_text())
        for t in toolchains:
            self.write(f"env/toolchain-{t['id']}.nix", toolchain_nix(t))
        self.write("env/flake.nix", toolchain_flake(name, toolchains, envs.get("nix-devshell")))
        podman = envs.get("podman")
        if podman and podman.get("toolchain"):
            tid = podman["toolchain"]
            lines = ["# Generated by al from agentic.rkt — do not edit.",
                     f"# The base image is built from toolchain `{tid}` with Nix (`al sandbox LAYER build`).",
                     f"FROM localhost/{toolchain_image(name, tid)}:latest",
                     *[f"RUN {s}" for s in podman["setup"]], "WORKDIR /work", ""]
            self.write("env/Containerfile", "\n".join(lines))

    def triggers_and_forge(self) -> None:
        name, forge = self.ir["name"], self.ir["forge"]
        for t in self.ir["triggers"]:
            if t["kind"] == "cron" and t["systemd"]:
                self.write(f"systemd/al-{name}-cron.service", systemd_unit("cron", name, self.layer, self.ir), local=True)
            if t["kind"] == "webhook":
                self.write(f"systemd/al-{name}-webhook.service", systemd_unit("webhook", name, self.layer, self.ir), local=True)
            if t["kind"] == "forge-actions" and forge["kind"] in ("github", "forgejo"):
                ctx = "github"  # Forgejo Actions keeps the `github` context for compatibility
                on: list[str] = []
                ev = t["events"]
                if "issue-opened" in ev or "issue-labeled" in ev:
                    types = [x for x, k in (("opened", "issue-opened"), ("labeled", "issue-labeled")) if k in ev]
                    on.append(f"  issues:\n    types: [{', '.join(types)}]")
                if "issue-comment" in ev:
                    on.append("  issue_comment:\n    types: [created]")
                if "schedule" in ev and t["schedule"]:
                    on.append(f"  schedule:\n    - cron: \"{t['schedule']}\"")
                if "workflow-dispatch" in ev:
                    on.append("  workflow_dispatch:\n    inputs:\n      prompt:\n        description: High-level prompt\n        required: true\n"
                              "      adw:\n        description: ADW name (empty = pick automatically)\n        required: false")
                marker = forge["botMarker"]
                if self.in_repo:  # the layer is in the checkout: the workflow checks it out and runs it from there
                    where = f"the repository's own `{self.ir['layer']['dir']}/` directory"
                    layer_default = f"format('{{0}}/{self.ir['layer']['dir']}', {ctx}.workspace)"
                    checkout = "      - uses: actions/checkout@v4\n"
                else:
                    where = f"$AL_LAYER_DIR (default {self.layer})"
                    layer_default = f"'{self.layer}'"
                    checkout = ""
                label_cond = (f"contains({ctx}.event.issue.labels.*.name, '{t['label']}')" if t["label"] else "true")
                wf = f"""# Generated by al for the {name} agentic layer.
