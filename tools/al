ASSIGN_USAGE = ("usage: al assign LAYER RUN|BRANCH [--note TEXT] [--preview] [--approve ITEM [--who NAME]] "
                "[--override] [--detach] [--dry-run] [--model-set TIER] [--json]\n"
                "       al assign LAYER --all [--preview] [--dry-run] [--json]")


def assign_cli(a: argparse.Namespace) -> int:
    """`al assign LAYER [RUN|BRANCH] …`: 0 started or shown (an attached run: its exit code), 2 bad
    use, 3 refused (`al assign: <reason>: <words>`)."""
    layer = a.layer.resolve()
    assign = layer_assign_module(layer)
    as_json = ["--json"] if a.json else []
    dry = ["--dry-run"] if a.dry_run else []
    if a.all:
        if a.run or a.approve or a.note or a.override:
            print(f"al assign: --all takes no RUN, --approve, --note or --override\n{ASSIGN_USAGE}", file=sys.stderr)
            return 2
        # the runs under Needs you, as `al runs` lists them: a run that landed by a squash merge or was
        # replaced is not given to an agent, although nothing in its own record says it is done
        needs = runs_module().needs_you(layer, sys.modules[__name__])
        if not needs:
            print(json.dumps({"plans": []} if a.preview else {"results": []}) if a.json else "no run needs you")
            return 0
        return assign.main(layer, ["all", *needs, *(["--preview"] if a.preview else []), *dry, *as_json], prog="al ")
    if not a.run:
        print(f"al assign: RUN is required (a run id or its branch), or --all\n{ASSIGN_USAGE}", file=sys.stderr)
        return 2
    if a.preview and a.approve:
        print(f"al assign: --preview and --approve cannot be combined\n{ASSIGN_USAGE}", file=sys.stderr)
        return 2
    note = ["--note", a.note] if a.note else []
    if a.preview:
        return assign.main(layer, ["preview", a.run, *note, *as_json], prog="al ")
    who = a.who
    if not who:
        ir = json.loads((layer / "agentic-layer.json").read_text())
        who = git(Path(app_root_of(layer, ir)), "config", "user.name")
    if a.approve:
        if not who:
            print("al assign: --who NAME is required: who approves (git config user.name is not set)", file=sys.stderr)
            return 2
        return assign.main(layer, ["approve", a.run, a.approve, "--who", who, *as_json], prog="al ")
    argv = ["give", a.run, *note, *(["--who", who] if who else []), *(["--override"] if a.override else []),
            *(["--detach"] if a.detach else []), *dry, *(["--model-set", a.model_set] if a.model_set else []), *as_json]
    return assign.main(layer, argv, prog="al ")


INTEGRATE_USAGE = ("usage: al integrate LAYER RUN|BRANCH [--model-set TIER] [--detach] [--dry-run] [--preview] "
                   "[--approve [--who NAME]] [--json]\n"
                   "       al integrate LAYER [--conflicts | --set KEY=VALUE … | --reset] [--json]")


def integrate_cli(a: argparse.Namespace) -> int:
    """`al integrate LAYER [RUN|BRANCH] …`: the integration run's exit code (0 landed or handed over,
    1 failed, 75 waiting for approval), 2 bad use, 3 refused (`al integrate: <reason>: <words>`)."""
    layer = a.layer.resolve()
    integrate = layer_integrate_module(layer)
    as_json = ["--json"] if a.json else []
    modes = [name for name, on in (("--preview", a.preview), ("--approve", a.approve), ("--conflicts", a.conflicts),
                                   ("--set", bool(a.set)), ("--reset", a.reset)) if on]
    if len(modes) > 1:
        print(f"al integrate: {' and '.join(modes)} cannot be combined\n{INTEGRATE_USAGE}", file=sys.stderr)
        return 2
    if a.conflicts or a.set or a.reset:
        if a.run:
            print(f"al integrate: {modes[0]} takes no RUN\n{INTEGRATE_USAGE}", file=sys.stderr)
            return 2
        if a.conflicts:
            return integrate.main(layer, ["conflicts", *as_json], prog="al ")
        try:
            if a.reset:
                integrate.write_settings(layer, None)
            else:
                changes = {}
                for item in a.set:
                    key, sep, value = item.partition("=")
                    if not sep or key not in integrate.SETTABLE:
                        print(f"al integrate: --set KEY=VALUE with KEY one of {', '.join(integrate.SETTABLE)} "
                              f"(\"generated\" is edited in {integrate.SETTINGS_SHOWN}), got {item!r}", file=sys.stderr)
                        return 2
                    changes[key] = {"true": True, "false": False}.get(value, value) if key != "approval" else value
                integrate.write_settings(layer, changes)
        except Exception as exc:  # the layer's LayerError (a wrong value, a broken file): its words name the file
            if type(exc).__name__ != "LayerError":
                raise
            print(f"al integrate: {exc}", file=sys.stderr)
            return 2
        return integrate.main(layer, ["settings", *as_json], prog="al ")
    if not a.run:
        code = integrate.main(layer, ["settings", *as_json], prog="al ")
        if not a.json:
            print(INTEGRATE_USAGE)
        return code
    if a.preview:
        return integrate.main(layer, ["preview", a.run, *as_json], prog="al ")
    if a.approve:
        who = a.who
        if not who:
            ir = json.loads((layer / "agentic-layer.json").read_text())
            who = git(Path(app_root_of(layer, ir)), "config", "user.name")
        if not who:
            print("al integrate: --who NAME is required: who approves (git config user.name is not set)", file=sys.stderr)
            return 2
        return integrate.main(layer, ["approve", a.run, "--who", who, *(["--detach"] if a.detach else []), *as_json],
                              prog="al ")
    argv = ["run", a.run, *(["--model-set", a.model_set] if a.model_set else []), *(["--detach"] if a.detach else []),
            *(["--dry-run"] if a.dry_run else []), *as_json]
    return integrate.main(layer, argv, prog="al ")


