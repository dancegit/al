def sha256_text(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def sha256_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def load_manifest(layer: Path) -> dict[str, str | None]:
    """Generated file -> sha256 recorded by the last `al gen`. A manifest written by al 0.1 is a
    plain file list: its files map to None (hash unknown: never reported as hand-edited)."""
    entries: dict[str, str | None] = {}
    for name in (MANIFEST, LOCAL_MANIFEST):
        path = layer / name
        if not path.is_file():
            continue
        try:
            files = json.loads(path.read_text()).get("files", [])
        except (json.JSONDecodeError, AttributeError) as exc:
            raise AlError(f"{path} is not a manifest written by al ({exc}); delete it and run `al gen` again") from exc
        if isinstance(files, dict):
            entries.update({str(k): (str(v) if v else None) for k, v in files.items()})
        else:
            entries.update({str(f): None for f in files})
    return entries


class HandEditError(AlError):
    def __init__(self, message: str, files: list[str]):
        super().__init__(message)
        self.files = files


def eject_hint(layer: Path, rel: str) -> str:
    """How to make a hand edit of the generated file `rel` permanent."""
    parts = rel.split("/")
    if parts[0] in ("commands", "hops") and len(parts) == 2 and rel.endswith(".md"):
        kind = "command" if parts[0] == "commands" else "hop"
        return f"al eject {layer} {kind} {parts[1][:-3]}"
    if parts[0] == "experts" and len(parts) == 3:
        return f"al eject {layer} expert {parts[1]}"
    return "change agentic.rkt instead: this file is generated from the definition and the kit"


def app_root_of(layer: Path, ir: dict) -> Path:
    """The application checkout: AL_APP_ROOT when set (see `al improve`), else codebase.root
    resolved against the layer. The same rule as the runtime's ir.load."""
    override = os.environ.get("AL_APP_ROOT", "").strip()
    if override:
        return Path(override).expanduser().resolve()
    return (layer / ir["codebase"]["root"]).resolve()


def template_path(layer: Path, kind: str, filename: str) -> tuple[Path, bool]:
    """(path, is_layer_local): <layer>/templates/<kind>/<filename> first, then the kit."""
    local = layer / "templates" / kind / filename
    if local.is_file():
        return local, True
    return KIT / "templates" / kind / filename, False


class Generator:
    def __init__(self, layer: Path, ir: dict):
        self.layer, self.ir = layer, ir
        self.outputs: dict[str, tuple[str, int, bool, bool]] = {}  # rel -> (content, mode, keep_existing, local)
        self.template_sources: dict[str, Path] = {}             # "commands/plan-chore.md" -> the file used
        self.changed: list[str] = []
        self.scaffolded: list[str] = []
        self.cb = ir["codebase"]
        self.cmds = {c["name"]: c for c in self.cb["commands"]}
        self.in_repo = (ir.get("layer") or {}).get("kind") == "in-repo"

    @property
    def written(self) -> list[str]:
        """Every generated file (not the scaffolding that is written once and then belongs to you)."""
        return sorted(rel for rel, (_c, _m, keep, _l) in self.outputs.items() if not keep)

    def write(self, rel: str, content: str, mode: int = 0o644, keep_existing: bool = False, local: bool = False) -> None:
        """Queue a file; nothing touches the disk before generate() has checked for hand edits.
        `local`: the content names this machine's paths, so the file is git-ignored and recorded
        in the local manifest (a committed layer must generate identically on every machine)."""
        self.outputs[rel] = (content, mode, keep_existing, local)

    def template(self, kind: str, filename: str) -> Path:
        src, _ = template_path(self.layer, kind, filename)
        self.template_sources[f"{kind}/{filename}"] = src
        return src

    def render(self, src: Path, values: dict[str, str]) -> str:
        try:
            return fill(src.read_text(), values)
        except AlError as exc:
            raise AlError(f"{src}: {exc}") from exc

    def copy_tree(self, src: Path, rel: str) -> None:
        for f in sorted(src.rglob("*")):
            if f.is_file() and "__pycache__" not in f.parts and f.suffix != ".pyc":
                target = f"{rel}/{f.relative_to(src)}"
                self.write(target, f.read_text(), 0o755 if os.access(f, os.X_OK) else 0o644)

    def cmd_line(self, name: str) -> str:
        c = self.cmds[name]
        return f"`{c['run']}`" + (f" — {c['description']}" if c["description"] else f" — codebase cmd `{name}`")

    def base_values(self) -> dict[str, str]:
        cb, p = self.cb, self.cb["paths"]
        return {
            "name": self.ir["name"],
            "codebase_description": cb["description"] or self.ir["description"] or self.ir["name"],
            "languages": ", ".join(cb["languages"]),
            "readme": cb["readme"],
            "package_manager": cb["packageManager"] or "(not specified — do not add dependencies without flagging it)",
            "default_branch": cb["defaultBranch"],
            "protected_paths": bullets([f"`{x}`" for x in p["protected"]]),
            "all_commands": bullets([f"**{n}**: {self.cmd_line(n)}" for n in self.cmds]),
            "conditional_docs": bullets([f"`{d['path']}` — {d['when']}" for d in cb["conditionalDocs"]]),
            "relevant_files": bullets([f"`{x}`" for x in [cb["readme"], *p["source"], *p["tests"]] if x]),
            "validation_commands": bullets([self.cmd_line(n) for n in self.cmds if n in ("lint", "typecheck", "test", "build")]),
            "focus": "", "fabric": "", "output_contract": OUTPUT_CONTRACT["text"],
            "layer_change_rule": self.layer_change_rule(),
            "command_name": "", "description": "",
            "expert_name": "", "expert_domain": "", "expert_paths": "", "expert_max_lines": "", "expertise_path": "",
        }

    def layer_change_rule(self) -> str:
        """The meta HOPs' rule for changing the layer itself, by placement."""
        if self.in_repo:
            d = self.ir["layer"]["dir"]
            return (f"- This layer is checked in with the application (`{d}/` of its repository), and ordinary runs may not "
                    f"change it: do not edit any file under `${{layer_dir}}`. Where the instructions below say to write or edit "
                    f"a file of the layer, write it under `${{specs_dir}}/proposal-${{adw_id}}/` instead, with the same relative "
                    f"path (compile a copied definition with `${{layer_dir}}/bin/al compile <the copy>`). A person makes the "
                    f"change through review with `al improve {d} \"<request>\"`; end your report with that command.")
        return ("- Change only the layer's source: LAYER_SOURCE and files under `${layer_dir}/templates/` (to change a kit "
                "prompt, copy it there first with `${layer_dir}/bin/al eject ${layer_dir} command NAME`). These edits are not "
                "reviewed by anyone; for a reviewed change, a person runs `al improve ${layer_dir} \"<request>\"` instead, "
                "which makes the change in a worktree, checks and regenerates the layer, and opens a pull request.")

    def fabric_section(self, patterns: list[str]) -> str:
        if not patterns:
            return ""
        for pat in patterns:
            self.write(f"fabric/{pat}/system.md", fabric_pattern(pat).read_text())
        return ("## Method (Fabric patterns)\n\nBefore producing your output, read and apply the method in each of these "
                "pattern files. Where a pattern's output format differs from the Report section below, the Report section wins.\n\n"
                + bullets([f"`${{layer_dir}}/fabric/{pat}/system.md`" for pat in patterns]))

    def commands(self) -> None:
        base = self.base_values()
        for kind, items in (("commands", self.ir["commands"]), ("hops", self.ir["hops"])):
            for c in items:
                v = dict(base, command_name=c["name"], description=yaml_safe(c["description"] or f"{c['template']} for {self.ir['name']}"))
                if kind == "commands":
                    src = self.layer / c["file"] if c["template"] == "custom" else self.template(kind, f"{c['template']}.md")
                    if c["relevant"]:
                        v["relevant_files"] = bullets([f"`{x}`" for x in c["relevant"]])
                    if c["validation"]:
                        v["validation_commands"] = bullets([self.cmd_line(n) for n in c["validation"]])
                    v["focus"] = bullets(c["focus"], "")
                    v["fabric"] = self.fabric_section(c["fabric"])
                    contract = OUTPUT_CONTRACT[c["output"]]
                    schema = KIT / "schemas" / f"{c['template']}.schema.json"
                    if c["output"] == "json" and schema.exists():
                        contract += f"\n\nIt must validate against this JSON Schema:\n\n```json\n{schema.read_text().strip()}\n```"
                    v["output_contract"] = contract
                else:
                    src = self.template(kind, f"{c['template']}.md")
                if not src.exists():
                    raise AlError(f"{kind[:-1]} `{c['name']}`: template file {src} is missing")
                self.write(f"{kind}/{c['name']}.md", self.render(src, v))

    def experts(self) -> None:
        base = self.base_values()
        for e in self.ir["experts"]:
            rel = f"experts/{e['name']}"
            v = dict(base, expert_name=e["name"], expert_domain=e["domain"],
                     expert_paths=bullets(e["paths"]), expert_max_lines=str(e["maxLines"]),
                     expertise_path=f"${{layer_dir}}/{rel}/expertise.yaml", command_name=e["name"], description=yaml_safe(e["domain"]))
            self.write(f"{rel}/expertise.yaml", self.render(self.template("experts", "expertise.yaml"), v), keep_existing=True)
            for f in ("question.md", "self-improve.md"):
                self.write(f"{rel}/{f}", self.render(self.template("experts", f), v))

    def adws(self) -> None:
        self.copy_tree(KIT / "runtime/adw_modules", "adws/adw_modules")
        deps = '["boto3>=1.34"]' if self.ir["storage"]["kind"] == "s3" else "[]"
        header = f"#!/usr/bin/env -S uv run --quiet --script\n# /// script\n# requires-python = \">=3.11\"\n# dependencies = {deps}\n# ///\n"
