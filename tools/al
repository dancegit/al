    if box:
        return ("container" if box["agentInside"] else "your machine (`#:agent-inside #f`)"), "container"
    if "worktree" not in kinds:
        return "your machine", "—"
    host = "your machine (Nix shell)" if "nix-devshell" in kinds else "your machine"
    return host, host


