def nix_str(s: str) -> str:
    """A Nix string literal."""
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"').replace("${", "\\${") + '"'


def nix_id(tid: str) -> str:
    """A toolchain id as part of a Nix identifier."""
    return re.sub(r"[^A-Za-z0-9_]", "_", tid)


def toolchain_image(layer_name: str, tid: str) -> str:
    """The Nix-built image of a toolchain, before the #:setup layer."""
    return f"al-{layer_name}-toolchain-{tid}".lower()


def toolchain_nix(t: dict) -> str:
    """env/toolchain-<id>.nix: the one package set of the dev shell, the image and the Home Manager module."""
    hook = t["shellHook"].replace("''", "'''")
    variables = "".join(f"    {v['name']} = {nix_str(v['value'])};\n" for v in t["env"])
    return f"""# Generated by al from agentic.rkt — do not edit.
# Toolchain `{t['id']}`: the one package set of every environment that names it (the dev shell and the
# sandbox image in flake.nix, the Home Manager module). Called with the pinned nixpkgs (flake.nix) or
# with the user's own (Home Manager).
{{ pkgs, lib ? pkgs.lib }}:
let
  features = import ./features.nix {{
    inherit pkgs lib;
    agentCli = lib.importJSON ./agent-cli.json;
    agents = [ {' '.join(nix_str(k) for k in t['agentClis'])} ];
  }};
  names = [ {' '.join(nix_str(f) for f in t['features'])} ];
  declared = with pkgs; [ {' '.join(t['packages'])} ];
  variables = {{
{variables}  }};
in
{{
  id = {nix_str(t['id'])};
  inherit names declared;
  packages = declared ++ features.packagesFor names;
  env = features.envFor names // variables;
  imagePackages = declared ++ features.image.packagesFor names;
  imageEnv = features.image.envFor names // variables;
  imageBase = features.imageBase;
  featurePackages = lib.genAttrs names (name: features.byFeature.${{name}}.packages);
  shellHook = {f"''{chr(10)}    {hook}{chr(10)}  ''" if hook.strip() else '""'};
}}
"""


def toolchain_flake(name: str, toolchains: list[dict], devshell: dict | None) -> str:
    """env/flake.nix of a layer with toolchains: one pinned nixpkgs input per toolchain (plus
    `nixpkgs` for a dev shell in the #:packages form), the dev shell, and on Linux the sandbox
    image and the per-feature outputs the size report measures."""
    ids = [(t, nix_id(t["id"])) for t in toolchains]
    old_shell = devshell is not None and not devshell.get("toolchain")
    inputs = [f"  inputs.nixpkgs_{n}.url = {nix_str(t['nixpkgs'])};" for t, n in ids]
    args = [f"nixpkgs_{n}" for _t, n in ids]
    if old_shell:
        inputs.append(f"  inputs.nixpkgs.url = {nix_str(devshell['nixpkgs'])};")
        args.append("nixpkgs")
    lib = f"nixpkgs_{ids[0][1]}.lib"
    per_toolchain = "".join(
        f"      # toolchain `{t['id']}`, from its own pinned nixpkgs\n"
        f"      toolchain_{n} = system: import ./toolchain-{t['id']}.nix {{ pkgs = pkgsFrom nixpkgs_{n} system; }};\n"
        for t, n in ids)
    shells = ""
    if devshell is not None:
        hook = devshell["shellHook"].replace("''", "'''")
        if old_shell:
            shells = f"""      devShells = forAllSystems (system:
        let pkgs = import nixpkgs {{ inherit system; }};
        in {{
          default = pkgs.mkShell {{
            packages = with pkgs; [ {' '.join(devshell['packages'])} ];
            shellHook = ''
              export AL_LAYER="{name}"
              {hook}
            '';
          }};
        }});
"""
        else:
            n = nix_id(devshell["toolchain"])
            shells = f"""      devShells = forAllSystems (system:
        let
          pkgs = pkgsFrom nixpkgs_{n} system;
          tc = toolchain_{n} system;
        in {{
          default = pkgs.mkShell {{
            packages = tc.packages;
            env = tc.env;
            shellHook = ''
              export AL_LAYER="{name}"
{f"              {hook}{chr(10)}" if hook.strip() else ""}            '' + tc.shellHook;
          }};
        }});
"""
    images = []
    for t, n in ids:
        image = toolchain_image(name, t["id"])
        sizes = "".join(f"""
          "toolchain-{t['id']}-{f}" = pkgs.buildEnv {{ name = "toolchain-{t['id']}-{f}"; paths = tc.featurePackages.{f}; }};"""
                        for f in t["features"])
        images.append(f"""        (let
          pkgs = pkgsFrom nixpkgs_{n} system;
          tc = toolchain_{n} system;
        in {{
          "image-{t['id']}" = pkgs.dockerTools.streamLayeredImage {{
            name = "{image}";
            tag = "latest";
            contents = [
              (pkgs.buildEnv {{
                name = "{image}-root";
                paths = tc.imagePackages ++ tc.imageBase
                  ++ [ pkgs.dockerTools.binSh pkgs.dockerTools.usrBinEnv pkgs.dockerTools.caCertificates ];
                pathsToLink = [ "/bin" "/etc" "/lib" "/libexec" "/share" ];
                ignoreCollisions = true;
              }})
            ];
            # A normal filesystem layout, so the runtime's hardening flags work unchanged: a regular,
            # writable passwd and group (podman --userns=keep-id adds the user), /tmp, the home and
            # /work writable by anyone.
            extraCommands = ''
              rm -f etc/passwd etc/group
              printf 'root:x:0:0:root:/root:/bin/sh\\nnobody:x:65534:65534:nobody:/tmp/home:/bin/sh\\n' > etc/passwd
              printf 'root:x:0:\\nnobody:x:65534:\\n' > etc/group
              chmod 0666 etc/passwd etc/group
              mkdir -p tmp/home work
              chmod 1777 tmp tmp/home work
            '';
            config = {{
              Env = [ "PATH=/bin:/usr/bin" "HOME=/tmp/home" "SSL_CERT_FILE=/etc/ssl/certs/ca-bundle.crt" "LANG=C.UTF-8" ]
                ++ pkgs.lib.mapAttrsToList (name: value: "${{name}}=${{value}}") tc.imageEnv;
              WorkingDir = "/work";
              Cmd = [ "/bin/bash" ];
            }};
          }};
          # what the size report measures: the base (declared packages and what every image needs)
          # and each feature
          "toolchain-{t['id']}-base" = pkgs.buildEnv {{ name = "toolchain-{t['id']}-base"; paths = tc.declared ++ tc.imageBase; }};{sizes}
        }})""")
    packages = " //\n".join(images)
    return f"""# Generated by al from agentic.rkt — do not edit.
{{
  description = "Agentic layer toolchain for {name}";

{chr(10).join(inputs)}

  outputs = {{ self, {', '.join(args)} }}:
    let
      systems = {NIX_SYSTEMS};
      linux = [ "x86_64-linux" "aarch64-linux" ];
      forAllSystems = {lib}.genAttrs systems;
      forLinux = {lib}.genAttrs linux;
      # unfree packages are allowed by name only: the agent CLIs agent-cli.json lists
      unfree = (builtins.fromJSON (builtins.readFile ./agent-cli.json)).unfree;
      pkgsFrom = nixpkgs: system: import nixpkgs {{
        inherit system;
        config.allowUnfreePredicate = pkg: builtins.elem (nixpkgs.lib.getName pkg) unfree;
      }};
{per_toolchain}    in {{
{shells}      packages = forLinux (system:
{packages});
    }};
}}
"""


class Generator:
    def __init__(self, layer: Path, ir: dict):
        self.layer, self.ir = layer, ir
        self.outputs: dict[str, tuple[str, int, bool, bool]] = {}  # rel -> (content, mode, keep_existing, local)
        self.template_sources: dict[str, Path] = {}             # "commands/plan-chore.md" -> the file used
        self.changed: list[str] = []
        self.scaffolded: list[str] = []
        self.cb = ir["codebase"]
        self.cmds = {c["name"]: c for c in self.cb["commands"]}
        self.in_repo = (ir.get("layer") or {}).get("kind") == "in-repo"
        self.notes: list[str] = []  # what `al gen` does not honour of the application's own setup files

    @property
    def written(self) -> list[str]:
        """Every generated file (not the scaffolding that is written once and then belongs to you)."""
        return sorted(rel for rel, (_c, _m, keep, _l) in self.outputs.items() if not keep)

    def write(self, rel: str, content: str, mode: int = 0o644, keep_existing: bool = False, local: bool = False) -> None:
        """Queue a file; nothing touches the disk before generate() has checked for hand edits.
        `local`: the content names this machine's paths, so the file is git-ignored and recorded
        in the local manifest (a committed layer must generate identically on every machine)."""
        self.outputs[rel] = (content, mode, keep_existing, local)

    def template(self, kind: str, filename: str) -> Path:
        src, _ = template_path(self.layer, kind, filename)
        self.template_sources[f"{kind}/{filename}"] = src
        return src

    def render(self, src: Path, values: dict[str, str]) -> str:
        try:
            return fill(src.read_text(), values)
        except AlError as exc:
            raise AlError(f"{src}: {exc}") from exc

    def copy_tree(self, src: Path, rel: str) -> None:
        for f in sorted(src.rglob("*")):
            if f.is_file() and "__pycache__" not in f.parts and f.suffix != ".pyc":
                target = f"{rel}/{f.relative_to(src)}"
                self.write(target, f.read_text(), 0o755 if os.access(f, os.X_OK) else 0o644)

    def cmd_line(self, name: str) -> str:
        c = self.cmds[name]
        return f"`{c['run']}`" + (f" — {c['description']}" if c["description"] else f" — codebase cmd `{name}`")

    def base_values(self) -> dict[str, str]:
        cb, p = self.cb, self.cb["paths"]
        return {
