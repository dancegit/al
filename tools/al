class CompilerUnavailable(AlError):
    """The compiler was found but could not be started: the definition was never checked."""


def run(cmd: list[str], cwd: Path | None = None, check: bool = True, env: dict | None = None) -> subprocess.CompletedProcess:
    cmd = tools_module().argv(cmd)   # a bare racket / git / uv … becomes the path al_tools finds
    return subprocess.run(cmd, cwd=cwd, check=check, text=True, capture_output=True, env=env)


def git(app: Path, *args: str) -> str:
    cp = run(["git", "-C", str(app), *args], check=False)
    return cp.stdout.strip() if cp.returncode == 0 else ""


