# scout.json is written by `al init` and kept with a committed layer (the facts behind the draft).
SOURCE_FILES = ("agentic.rkt", "LLM.txt", "scout.json", "templates/README.md", ".gitignore")
CONDITIONAL_DOCS_SOURCE = "Generated by `al gen` from the `(conditional-doc …)` clauses of `agentic.rkt`; change them there.\n"
# Generated now; before, written once and yours. Each maps to what the older version wrote for the
# same definition, which `al gen` may replace without asking.
FORMERLY_SCAFFOLDED = {"conditional_docs.md": lambda text: text.replace(CONDITIONAL_DOCS_SOURCE, "")}
ADOPTED_DIR = "adopted"   # what `al adopt` wrote: included by agentic.rkt, regenerated by `al adopt`


def is_layer_file(rel: str, manifest: dict[str, str | None]) -> bool:
    """A file that belongs in a committed layer: source, scaffolding or generated."""
    return (rel in manifest or rel in SOURCE_FILES or rel in (MANIFEST,)
            or rel.startswith(("templates/", "mock/", ADOPTED_DIR + "/"))
            or bool(re.fullmatch(r"experts/[^/]+/expertise\.yaml", rel)))


def porcelain(repo: Path) -> list[tuple[str, str]]:
    """(XY, path) of `git status --porcelain -z --untracked-files=all`; rename sources included."""
    cp = run(["git", "-C", str(repo), "status", "--porcelain=v1", "-z", "--untracked-files=all"], check=False)
    if cp.returncode != 0:
        raise AlError(f"git status failed in {repo}: {cp.stderr.strip()}")
    entries, items = [], cp.stdout.split("\0")
    index = 0
    while index < len(items):
        item = items[index]
        index += 1
        if len(item) < 4:
            continue
        xy, path = item[:2], item[3:]
        entries.append((xy, path))
        if xy[0] in "RC":  # -z: the rename/copy source follows as its own field
            if index < len(items) and items[index]:
                entries.append((xy, items[index]))
            index += 1
    return entries


SCRATCH_PATH = re.compile(r"agents/[^/]+/scratch/")   # a run's scratch directory: run state, never source


def in_repo_problems(layer: Path, ir: dict, app: Path) -> list[str]:
    """`al check` for a layer checked in with the application: changes to the layer's own files
    (uncommitted edits, regenerated files) are fine; untracked run state that escaped the ignored
    directories is not. Changes outside the layer are the developer's own work in progress (or
    anyone's): nothing ties them to the layer, so they are notes (`in_repo_notes`), not problems."""
    try:
        rel = layer.resolve().relative_to(app).as_posix()
    except ValueError:
        return [f"in-repo layer {layer} is not inside the application repository {app}"]
    manifest = load_manifest(layer)
    return [f"untracked file in the layer that is neither source nor generated (run state outside "
            f"the ignored directories?): {path}"
            for xy, path in porcelain(app)
            if (path == rel or path.startswith(rel + "/")) and xy == "??" and not is_layer_file(path[len(rel) + 1:], manifest)
            and not SCRATCH_PATH.match(path[len(rel) + 1:])]


def step_block_notes(layer: Path, ir: dict) -> list[str]:
    """Layer-local command and hop templates without the "Your step" block (`{{step_block}}`):
    their prompts do not tell the agent which step it is and what it must leave undone."""
    notes = []
    for row in template_rows(layer, ir):
        if row["from"] != "layer" or row["kind"] not in ("commands", "hops"):
            continue
        try:
            text = Path(row["path"]).read_text(encoding="utf-8")
        except OSError:
            continue
        if "{{step_block}}" not in text:
            notes.append(f"template {row['kind']}/{row['template']} (yours) has no \"Your step\" block: add a line "
                         f"`{{{{step_block}}}}` right after its front matter (as in kit/templates/{row['kind']}/"
                         f"{row['template']}), then run `al gen`")
    return notes


def in_repo_notes(layer: Path, app: Path) -> list[str]:
    """Uncommitted changes outside an in-repo layer, reported by `al check` without failing it."""
    try:
        rel = layer.resolve().relative_to(app).as_posix()
    except ValueError:
        return []
    return [f"uncommitted change outside the layer (not checked): {xy} {path}"
            for xy, path in porcelain(app) if not (path == rel or path.startswith(rel + "/"))]


def check_layer(layer: Path) -> list[str]:
    import yaml
    problems: list[str] = []
    ir = json.loads((layer / "agentic-layer.json").read_text())
    if ir != compile_layer(layer):
        problems.append("agentic-layer.json is stale: run `al gen`")
    need = [f"commands/{c['name']}.md" for c in ir["commands"]] + [f"hops/{h['name']}.md" for h in ir["hops"]]
    need += [f"adws/adw_{a['name']}.py" for a in ir["adws"]] + ["adws/adw_modules/runner.py", "adws/dispatch.py", "adws/standin.py", "AL-DSL.llms.txt"]
    need += ["adws/integrate.py", "adws/verify_batch.py", "adws/assign.py"] + ([] if declares_kit_command(ir) else [f"commands/{KIT_COMMAND}.md"])
    need += ["adws/host.py"] if ir.get("placement") else []
    kinds = {e["kind"] for e in ir["environments"]}
    need += [f for k, f in (("nix-devshell", "env/flake.nix"), ("home-manager", "env/home-manager.nix"), ("podman", "env/Containerfile")) if k in kinds]
    need += [f"env/hosts/{h['id']}/{f}" for h in ir.get("hosts") or [] for f in ("home-manager.nix", "nixos.nix", "provision.sh")]
    if ir.get("toolchains"):
        need += ["env/flake.nix", *(f"env/{f}" for f in TOOLCHAIN_FILES), *(f"env/toolchain-{t['id']}.nix" for t in ir["toolchains"])]
    for c in ir["commands"]:
        need += [f"fabric/{p}/system.md" for p in c["fabric"]]
    dash = (ir.get("dashboard") or {}).get("kind", "none")
    if dash != "none":
        need += ["adws/dashboard.py", *(f"adws/dashboard/{f}" for f in DASHBOARD_FILES)]
        need += [f"adws/dashboard/{f}" for f in DASHBOARD_PODMAN_FILES] if dash == "podman" else []
    if ir.get("voice"):
        need += ["adws/voice/serve.py", "adws/voice/models.json", "adws/adw_modules/helper.py"]
    for rel in need:
        if not (layer / rel).is_file():
            problems.append(f"missing {rel}")
    custom = {f"{c['name']}.md" for c in ir["commands"] if c["template"] == "custom"}  # may keep {{…}} literally
    for f in list((layer / "commands").glob("*.md")) + list((layer / "hops").glob("*.md")):
        if f.parent.name == "commands" and f.name in custom:
            continue
        left = re.findall(r"\{\{[a-z_]+\}\}", f.read_text())
        if left:
            problems.append(f"{f.relative_to(layer)}: unfilled placeholders {sorted(set(left))}")
    for rel, recorded in sorted(load_manifest(layer).items()):
        if recorded and (layer / rel).is_file() and sha256_file(layer / rel) != recorded:
            problems.append(f"{rel} was edited by hand since the last `al gen` (`al gen` says how to keep or drop it)")
    for f in layer.glob("forge/**/*.yml"):
        try:
            doc = yaml.safe_load(f.read_text())
            if "jobs" not in doc or not (doc.get("on") or doc.get(True)):
                problems.append(f"{f.relative_to(layer)}: not a workflow (no on/jobs)")
        except yaml.YAMLError as e:
            problems.append(f"{f.relative_to(layer)}: invalid YAML: {e}")
    for f in layer.glob("adws/**/*.py"):
        cp = run([sys.executable, "-m", "py_compile", str(f)], check=False)
        if cp.returncode != 0:
            problems.append(f"{f.relative_to(layer)}: does not compile: {cp.stderr.strip().splitlines()[-1]}")
    for c in ir["commands"]:
        if c["template"] == "custom" and not (layer / c["file"]).is_file():
            problems.append(f"command `{c['name']}`: its template {c['file']} is missing")
    app = app_root_of(layer, ir)
    if app.exists():
        adopted_problems, _notes = adopt_module().check(layer, app)
        problems += adopted_problems
    if not app.exists():
        problems.append(f"application checkout {app} not found")
    elif (ir.get("layer") or {}).get("kind") == "in-repo":
        problems += in_repo_problems(layer, ir, app)
    else:
        dirty = git(app, "status", "--porcelain")
        if dirty:
            problems.append(f"application working tree is not clean:\n{dirty}")
        if layer.resolve() == app or app in layer.resolve().parents:
            problems.append("layer lives inside the application tree")
    tracked = run(["git", "-C", str(layer), "ls-files", "--error-unmatch", "--", "local.env"], check=False)
    if tracked.returncode == 0:  # the file's content is never read here; outside a git repository: non-zero, no problem
        problems.append("local.env is tracked by git: it holds private values (addresses, servers, passwords) and must "
                        "never be committed. Remove it from git with `git rm --cached local.env` in the layer directory, "
                        "commit, and change every password it held")
    if app.exists() or (layer / ".git").exists():
        problems += tracked_settings(layer, ir, app)
    return problems


LOCAL_SETTINGS = ("agents/settings/models.json", "agents/settings/decider.json", "agents/settings/testing.json",
                  "agents/settings/review.json")


def tracked_settings(layer: Path, ir: dict, app: Path) -> list[str]:
    """The layer's local settings (models, the stand-in decider's mode, the testing level, the
    ship-without-review limit) are machine-local: committing one is a problem."""
    if (ir.get("layer") or {}).get("kind") == "in-repo":
        try:
            repo, prefix = app, f"{layer.resolve().relative_to(app.resolve()).as_posix()}/"
        except ValueError:
            return []
    elif (layer / ".git").exists():
        repo, prefix = layer, ""
    else:
        return []
    problems = []
    for rel in LOCAL_SETTINGS:
        cp = run(["git", "-C", str(repo), "ls-files", "--", prefix + rel], check=False)
        problems += [f"{rel} is a local setting and must not be committed: git rm --cached {line}"
                     for line in cp.stdout.splitlines() if line.strip()]
    return problems


DIED_AFTER = 60          # seconds without a heartbeat before a run whose process is gone counts as dead
DIED_ANYWHERE = 600     # … and before one on another host (whose pid cannot be checked) does


def died_runs(layer: Path, now: float | None = None) -> list[str]:
    """Runs whose state says `running` but that stopped beating: the process is gone (killed, out of
    memory, the machine rebooted). Cheap: one small JSON read per running run. Runs from before the
    runtime wrote a heartbeat are never reported."""
    import socket
    from datetime import datetime
    now = time.time() if now is None else now
    found = []
    try:
        entries = sorted(e.name for e in os.scandir(layer / "agents") if re.fullmatch(r"[0-9a-fA-F]{8}", e.name))
    except OSError:
        return found
    for run_id in entries:
        try:
            state = json.loads((layer / "agents" / run_id / "state.json").read_text())
        except (OSError, ValueError):
            continue
        if not isinstance(state, dict) or state.get("status") != "running" or not state.get("heartbeat"):
            continue
        try:
            beat = datetime.fromisoformat(str(state["heartbeat"]).replace("Z", "+00:00")).timestamp()
        except ValueError:
            continue
        age = now - beat
        if age < DIED_AFTER:
            continue
        pid, host = int(state.get("pid") or 0), str(state.get("host") or "")
        if host == socket.gethostname() and pid > 0:
            try:
                os.kill(pid, 0)
                continue                         # alive, just slow to beat
            except ProcessLookupError:
                why = f"pid {pid} is gone"
            except PermissionError:
                continue
        elif age >= DIED_ANYWHERE:
            why = f"no heartbeat for {int(age // 60)} min" + (f" (host {host})" if host else "")
        else:
            continue
        seen = datetime.fromtimestamp(beat).astimezone().strftime("%Y-%m-%d %H:%M:%S %Z")
        found.append(f"run {run_id} ({state.get('adw', '?')}) died: last seen {seen} ({why}); "
                     f"its state still says running")
    return found


def template_rows(layer: Path, ir: dict) -> list[dict]:
    """Every template the layer uses (and every layer-local one it does not), where it resolves
    from, and how the layer's copy compares with the kit's current version."""
    used: dict[tuple[str, str], list[str]] = {}
    for c in ir["commands"]:
        if c["template"] != "custom":
            used.setdefault(("commands", f"{c['template']}.md"), []).append(c["name"])
    for h in ir["hops"]:
        used.setdefault(("hops", f"{h['template']}.md"), []).append(h["name"])
    for x in ir["experts"]:
        for f in EXPERT_TEMPLATES:
            used.setdefault(("experts", f), []).append(x["name"])
    if not declares_kit_command(ir):
        used.setdefault(("commands", f"{KIT_COMMAND}.md"), []).append(KIT_COMMAND_USER)
    local_dir = layer / "templates"
    for kind in TEMPLATE_KINDS:
        for f in sorted((local_dir / kind).glob("*")) if (local_dir / kind).is_dir() else []:
            if f.is_file():
                used.setdefault((kind, f.name), [])
    ejected = eject_record(layer)
    rows = []
    for (kind, filename), names in sorted(used.items()):
        src, is_local = template_path(layer, kind, filename)
        kit = KIT / "templates" / kind / filename
        row = {"kind": kind, "template": filename, "used_by": names, "from": "layer" if is_local else "kit",
               "path": str(src), "differs": False, "status": "kit"}
        if is_local:
            mine = sha256_file(src)
            theirs = sha256_file(kit) if kit.is_file() else ""
            at_eject = ejected.get(f"{kind}/{filename}", "")
            row["differs"] = mine != theirs
            if not theirs:
                row["status"] = "layer only (no kit template of this name)"
            elif mine == theirs:
                row["status"] = "layer copy, identical to the kit"
            else:
                notes = []
                if at_eject and at_eject != theirs:
                    notes.append("the KIT'S VERSION HAS CHANGED since you ejected it")
                if not at_eject or mine != at_eject:
                    notes.append("edited in the layer" if at_eject else "differs from the kit")
                row["status"] = "layer copy: " + " and ".join(notes or ["differs from the kit"])
            if not names:
                row["status"] += "; not used by any command, hop or expert"
        rows.append(row)
    return rows


EJECT_RECORD = "templates/.al-eject.json"


def eject_record(layer: Path) -> dict[str, str]:
    path = layer / EJECT_RECORD
    try:
        return json.loads(path.read_text()) if path.is_file() else {}
    except json.JSONDecodeError:
        return {}


def eject(layer: Path, kind: str, name: str, force: bool = False) -> list[tuple[Path, Path, list[str]]]:
    """Copy the kit template(s) NAME uses into <layer>/templates/…, unrendered. Returns
    (kit file, layer file, users) per copied file; refuses to overwrite an override unless forced."""
    ir = compile_layer(layer)
    if kind in ("command", "hop"):
        items = ir["commands"] if kind == "command" else ir["hops"]
        item = next((c for c in items if c["name"] == name), None)
        if item is None and kind == "command" and name == KIT_COMMAND and not declares_kit_command(ir):
            item = {"name": KIT_COMMAND, "template": KIT_COMMAND}    # the prompt of the kit workflow `integrate`
            items = [item]
        if item is None:
            raise AlError(f"`{name}` is not a declared {kind}; declared: {', '.join(c['name'] for c in items) or '(none)'}")
        if item["template"] == "custom":
            raise AlError(f"command `{name}` already uses a layer file (#:file \"{item['file']}\"): edit that file")
        folder = "commands" if kind == "command" else "hops"
        files = [(folder, f"{item['template']}.md")]
        users = [c["name"] for c in items if c["template"] == item["template"]]
        if item["template"] == KIT_COMMAND and not declares_kit_command(ir):
            users = [u for u in users if u != KIT_COMMAND] + [KIT_COMMAND_USER]
    elif kind == "expert":
        if not any(x["name"] == name for x in ir["experts"]):
            raise AlError(f"`{name}` is not a declared expert; declared: {', '.join(x['name'] for x in ir['experts']) or '(none)'}")
        files = [("experts", f) for f in EXPERT_TEMPLATES]
        users = [x["name"] for x in ir["experts"]]
    else:
        raise AlError(f"unknown template kind {kind!r}: command, hop or expert")
    taken = [layer / "templates" / k / f for k, f in files if (layer / "templates" / k / f).exists()]
    if taken and not force:
        raise AlError("already ejected (your copy would be overwritten): "
                      + ", ".join(str(t.relative_to(layer)) for t in taken) + "; use --force to replace it with the kit's version")
    record = eject_record(layer)
    copied = []
    for k, f in files:
        src, dst = KIT / "templates" / k / f, layer / "templates" / k / f
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(src, dst)
        record[f"{k}/{f}"] = sha256_file(src)
        copied.append((src, dst, users))
    (layer / EJECT_RECORD).write_text(json.dumps(dict(sorted(record.items())), indent=1) + "\n")
    return copied


# ------------------------------------------------------------------------------------------
# verify: the compiler proves the layer is coherent; this proves its codebase cmds are true
# ------------------------------------------------------------------------------------------

VERIFY_DESCRIPTION = """\
Run the layer's codebase cmds on a throwaway worktree of the default branch, in the environment of
the layer's workflows, and report which are true. Every distinct environment stack of the workflows
is verified once (each on its own worktree), named by the first workflow that uses it; --workflow
NAME verifies only that workflow's stack. With several stacks every result line ends in [stack].

The report, LAYER/agents/verify/report.json, keeps the latest result of every cmd in every stack: a
cmd run now replaces its earlier row of the same stack, the others keep theirs. Each row has name,
cmd, exit, seconds, log (the cmd's full output, LAYER/agents/verify/NAME.log, or NAME.STACK.log with
several stacks), at (when it ran, UTC), workflow and stack. --json prints only the rows of this
invocation.

Verify fails if the application checkout's HEAD, branch or index changed while it ran (only a git
command does that). Files edited in the checkout meanwhile are listed as a note: verify runs every
cmd in its own worktree, so it cannot tell them from your own work in progress.

Before the final `verify: N/M ok` line, `coverage:` lines say which checks declare no #:covers (they
run for every change) and which source paths no check covers (a change there runs every check);
`testing:` lines before them say how deep the checks go per run and per batch (or that the layer
declares no (testing …) clause, so every check runs its full form)."""

VERIFY_SKIPPED = ("deploy", "start", "install")  # side effects or long-running: only when named with --cmd
VERIFY_TAIL = 15


def coverage_lines(layer: Path, workflow: str | None = None) -> list[str]:
    """The `coverage:` lines of `al verify` and `al sandbox doctor`: checks that declare no #:covers
    and source paths no check covers, from the layer's own runtime (adw_modules/affected.py, already
    importable: both commands load the layer's runtime first). A layer generated before affected
    checks has no such module and prints nothing."""
    try:
        from adw_modules import affected, ir as ir_module
    except ImportError:
        return []
    report = getattr(affected, "coverage_report", None)
    lines = getattr(affected, "coverage_lines", None)
    if report is None or lines is None:
        return []
    try:
        return list(lines(report(ir_module.load(layer), workflow)))
    except Exception as exc:  # noqa: BLE001 — a report line never fails verify or doctor
        return [f"coverage: not reported ({type(exc).__name__}: {exc})"]


def testing_lines(layer: Path) -> list[str]:
    """The `testing:` lines of `al verify` and `al sandbox doctor`: the depth per run, per review round
    and per batch, the local setting, the batch rhythm, check cmds without a narrower form and cmds
    selecting by coverage without a recorded map, from the layer's own runtime
    (adw_modules/testing.py, importable as for coverage_lines). A layer generated before targeted
    testing has no such module and prints nothing."""
    try:
        from adw_modules import ir as ir_module, testing
    except ImportError:
        return []
    lines = getattr(testing, "verify_lines", None)
    if lines is None:
        return []
    try:
        return list(lines(ir_module.load(layer)))
    except Exception as exc:  # noqa: BLE001 — a report line never fails verify or doctor
        return [f"testing: not reported ({type(exc).__name__}: {exc})"]


def app_fingerprint(app: Path) -> dict[str, str]:
    """What `al verify` may not change in the application checkout: what only a git command changes
    there (the commit checked out, the branch, the index). A person editing files changes none of
    them; a cmd or al itself running git against the checkout does. The working tree is not part
    of it: edits made while verify runs (by the developer, an editor, another process) are not
    attributable to verify, which runs every cmd in its own worktree (see `worktree_changes`)."""
    def out(*args: str) -> str:
        cp = run(["git", "-C", str(app), *args], check=False)
        if cp.returncode != 0:
            raise AlError(f"git {' '.join(args)} failed in {app}: {cp.stderr.strip()}")
        return cp.stdout.rstrip("\n")
    return {"head": out("rev-parse", "HEAD"), "branch": out("branch", "--show-current"),
            "index": hashlib.sha256(out("ls-files", "--stage").encode()).hexdigest()}


def worktree_status(app: Path) -> set[str]:
    return set(git(app, "status", "--porcelain", "--untracked-files=all").splitlines())


def worktree_changes(before: set[str], after: set[str]) -> list[str]:
    """Paths whose `git status` entry differs between two snapshots."""
    return sorted({line[3:] for line in before ^ after})


def _run_group(argv: list[str], cwd: Path, env: dict[str, str], timeout: int) -> tuple[int, str]:
    """Same contract as the runtime's check runner: own process group, combined output, 124 on timeout."""
    try:
        proc = subprocess.Popen(argv, cwd=cwd, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                text=True, errors="replace", start_new_session=True)
    except OSError as exc:
        return 127, f"could not start {argv[0]!r}: {exc}\n"
    try:
        output, _ = proc.communicate(timeout=max(1, timeout))
        return int(proc.returncode or 0), output
    except subprocess.TimeoutExpired:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        output, _ = proc.communicate()
        return 124, output + f"\ncommand timed out after {timeout}s\n"
    except BaseException:  # Ctrl-C: do not leave the command running in the worktree we are about to remove
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        raise


class _VerifyState:
    """Stand-in for the runtime's ADWState: just what adw_modules.envs reads and writes."""

    def __init__(self, adw_id: str, adw: str, worktree: Path) -> None:
        self.adw_id, self.adw = adw_id, adw
        self.klass, self.prompt, self.source = "chore", "al verify", "verify"
        self.worktree, self.branch = str(worktree), ""
        self.ports: list[int] = []
        self.dry_run, self.status = True, "running"


def notify_test(layer: Path, event: str) -> int:
    """`al notify-test`: one marked test message through every notifier of a generated layer. Prints the
    notifier's id, kind and a fixed reason; never a recipient, a server or a variable's value."""
    if not (layer / "agentic-layer.json").is_file() or not (layer / "adws/adw_modules/notify.py").is_file():
        raise AlError(f"{layer} is not a generated layer (or was generated before notifications existed): "
                      f"run `al gen {layer}` first")
    sys.path.insert(0, str(layer / "adws"))  # the layer's own runtime, as `al verify` uses it
    try:
        from adw_modules import ir as ir_module, notify
        from adw_modules.errors import LayerError
    except ImportError as exc:
        raise AlError(f"cannot import the layer runtime from {layer / 'adws'}: {exc}") from exc
    try:
        loaded = ir_module.load(layer)
    except LayerError as exc:
        raise AlError(str(exc)) from exc
    rows = notify.test(loaded, event)
    if not rows:
        print("notify-test: no notifier is declared in agentic.rkt. Add e.g. (notify email), run al gen, and put "
              "AL_NOTIFY_TO, AL_NOTIFY_FROM and AL_NOTIFY_SMTP_URL in <layer>/local.env (see AL-DSL.llms.txt, family notify)")
        return 1
    print(f"notify-test: layer {loaded.name}, event {event}: a marked test message, no run behind it")
    for row in rows:
        print(f"  {row['id']} ({row['kind']})  " + ("accepted" if row["accepted"] else f"FAILED: {row['reason']}")
              + ("" if row["reports"] else f"  (does not report {event} in real runs)"))
    accepted = sum(1 for row in rows if row["accepted"])
    print(f"notify-test: {accepted}/{len(rows)} accepted")
    return 0 if accepted == len(rows) else 1


def verify_layer(layer: Path, names: list[str], timeout: int | None, say=print,
                 workflow: str | None = None) -> tuple[list[dict], list[str]]:
    """Run codebase cmds of a generated layer in its workflows' environment stacks (each distinct
    stack once, or only `workflow`'s); returns (report rows, skipped names)."""
    if not (layer / "agentic-layer.json").is_file() or not (layer / "adws/adw_modules/envs.py").is_file():
        raise AlError(f"{layer} is not a generated layer: run `al gen {layer}` first")
    sys.path.insert(0, str(layer / "adws"))  # the layer's own runtime: identical environment semantics
    try:
        from adw_modules import envs, ir as ir_module
        from adw_modules.errors import LayerError, StepFailed
    except ImportError as exc:
        raise AlError(f"cannot import the layer runtime from {layer / 'adws'}: {exc}") from exc
    try:  # a layer generated before environment sources existed has neither module: nothing to prepare
        from adw_modules import envsource, prepare
    except ImportError:
        envsource = prepare = None
    try:
        loaded = ir_module.load(layer)
    except LayerError as exc:
        raise AlError(str(exc)) from exc
    declared = loaded.ir["codebase"]["commands"]
    by_name = {c["name"]: c for c in declared}
    unknown = [n for n in names if n not in by_name]
    if unknown:
        raise AlError(f"not a declared codebase cmd: {', '.join(unknown)}; declared: {', '.join(by_name)}")
    selected = [c for c in declared if (c["name"] in names if names else c["name"] not in VERIFY_SKIPPED)]
    skipped = [] if names else [c["name"] for c in declared if c["name"] in VERIFY_SKIPPED]
    adws = loaded.ir.get("adws", [])
    if not adws:
        raise AlError("the layer declares no ADW, so there is no environment to verify in")
    if workflow is not None:
        chosen = next((a for a in adws if a["name"] == workflow), None)
        if chosen is None:
            raise AlError(f"no workflow `{workflow}`; workflows: {', '.join(a['name'] for a in adws)}")
        stacks = [(tuple(chosen.get("environment", [])), chosen)]
    else:
        stacks = []
        for adw in adws:   # every distinct environment stack once; the first workflow using it names it
            if not any(tuple(adw.get("environment", [])) == env for env, _ in stacks):
                stacks.append((tuple(adw.get("environment", [])), adw))
    app = Path(loaded.app_root)
    if not (app / ".git").exists():
        raise AlError(f"application checkout {app} not found")
    out_dir = layer / "agents" / "verify"
    out_dir.mkdir(parents=True, exist_ok=True)
    before, files_before = app_fingerprint(app), worktree_status(app)
    heads_before = set(git(app, "for-each-ref", "--format=%(refname:short)", "refs/heads").splitlines())
    report: list[dict] = []
    made_branches: set[str] = set()
    problems: list[str] = []
    prepared: list[str] = []
    try:
        for index, (env_ids, adw) in enumerate(stacks):
            rows, branch, trouble = _verify_stack(loaded, layer, app, adw, list(env_ids), selected, timeout, say,
                                                  out_dir, envs, (LayerError, StepFailed), several=len(stacks) > 1,
                                                  skipped=skipped if index == 0 else [],
                                                  envsource=envsource, prepare=prepare)
            report += rows
            problems += trouble
            prepared += [row["name"] for row in rows
                         if row["name"].startswith("prepare:") and row["name"] not in prepared]
            if branch:
                made_branches.add(branch)
    finally:
        for branch in set(git(app, "for-each-ref", "--format=%(refname:short)", "refs/heads").splitlines()) - heads_before:
            if branch in made_branches:  # only a branch the runtime made for one of these very runs
                run(["git", "-C", str(app), "branch", "-D", branch], check=False)
        write_verify_report(out_dir / "report.json", report, prepared + [c["name"] for c in declared])
        after = app_fingerprint(app)
        if after != before:
            changed = ", ".join(k for k in before if before[k] != after[k])
            problems.append(f"THE APPLICATION CHECKOUT CHANGED DURING VERIFY ({changed}) — {app}\n"
                            f"  before: {before}\n  after:  {after}")
        edited = worktree_changes(files_before, worktree_status(app))
        if edited:
            say(f"note: {len(edited)} file(s) changed in the checkout while verify ran (not by verify, which works "
                f"in its own worktree, unless a cmd writes outside it): {', '.join(edited[:10])}"
                + (" …" if len(edited) > 10 else ""))
        if problems:
            raise AlError("verify: " + "\n".join(problems))
    return report, skipped


def stack_label(env_ids: list[str]) -> str:
    return " → ".join(env_ids) or "host"


def _verify_stack(loaded, layer: Path, app: Path, adw: dict, env_ids: list[str], selected: list[dict],
                  timeout: int | None, say, out_dir: Path, envs, failures: tuple, *, several: bool,
                  skipped: list[str], envsource=None, prepare=None) -> tuple[list[dict], str, list[str]]:
    """Run the selected cmds in one environment stack, on its own throwaway worktree, after the
    stack's prepare commands (if any; `envsource` and `prepare` are the layer runtime's modules, None
    for a layer generated before they existed). Returns (rows, the branch the runtime made for this
    run or "", cleanup problems)."""
    label = stack_label(env_ids)
    tree_dir = "trees"
    for env_id in env_ids:
        option = loaded.option("environments", env_id)
        if option["kind"] == "worktree":
            tree_dir = str(option.get("dir") or "trees")
    run_id = f"verify-{secrets.token_hex(4)}"
    worktree = (layer / tree_dir / run_id).resolve()
    inside_ignored = bool(loaded.in_repo_dir) and layer.resolve() in worktree.parents  # in-repo: an ignored dir of the layer
    if (worktree == app or app in worktree.parents) and not inside_ignored:
        raise AlError(f"refusing to verify: {worktree} is inside the application tree")
    worktree.parent.mkdir(parents=True, exist_ok=True)
    cp = run(["git", "-C", str(app), "worktree", "add", "--detach", str(worktree), loaded.default_branch], check=False)
    if cp.returncode != 0:
        raise AlError(f"cannot create the verify worktree: {cp.stderr.strip()}")
    state = _VerifyState(run_id, adw["name"], worktree)
    rows: list[dict] = []
    stack = None
    problems: list[str] = []
    suffix = f"  [{label}]" if several else ""
    try:
        podman = next((o for o in (loaded.option("environments", i) for i in env_ids) if o["kind"] == "podman"), None)
        if podman and podman.get("toolchain"):  # the image the runtime runs in is built from the toolchain first
            from adw_modules import sandbox   # the layer's own runtime (verify_layer put it on sys.path)
            try:
                with contextlib.redirect_stdout(sys.stderr):
                    sandbox.ensure_image(loaded, say=lambda line: print(line, file=sys.stderr, flush=True))
            except failures as exc:
                raise AlError(f"sandbox image of toolchain `{podman['toolchain']}`: {exc}") from exc
        try:
            stack = envs.build(loaded, state, env_ids)
            if envsource is not None:
                envsource.apply_publish(loaded, stack)
            with contextlib.redirect_stdout(sys.stderr):  # runtime progress lines never mix into our stdout
                stack.setup()
                if envsource is not None:
                    envsource.ensure_ready(loaded, state, stack)  # the repository's own image or dev shell
        except failures as exc:
            raise AlError(f"environment setup failed ({label}): {exc}") from exc
        if Path(state.worktree).resolve() != worktree:
            raise AlError(f"the runtime moved the run to {state.worktree}; refusing to continue")
        stack.cwd = worktree  # also for host-only stacks: never the application's own working tree
        say(f"verify: {len(selected)} cmd(s) of `{loaded.name}` in the environment of ADW `{adw['name']}` "
            f"({label}), worktree {worktree}")
        for name in skipped:
            say(f"  skip  {name}  (never run implicitly; name it with --cmd {name})")
        slug = re.sub(r"[^A-Za-z0-9_.-]+", "-", "-".join(env_ids) or "host")
        if prepare is not None:
            with contextlib.redirect_stdout(sys.stderr):
                prepared = prepare.run_for_verify(loaded, stack, out_dir)
            for row in prepared:
                row.update({"workflow": adw["name"], "stack": label})
                if several:  # each stack keeps its own log, as its cmds do
                    log = layer / row["log"]
                    own = log.with_name(f"{log.stem}.{slug}{log.suffix}")
                    if log.is_file():
                        log.replace(own)
                    row["log"] = own.relative_to(layer).as_posix()
                say(f"  {'ok  ' if row['exit'] == 0 else 'FAIL'}  {row['name']}  exit {row['exit']}  "
                    f"{row['seconds']}s{suffix}")
                if row["exit"] != 0:
                    for line in (layer / row["log"]).read_text(errors="replace").splitlines()[-VERIFY_TAIL:]:
                        say(f"        {line}")
            rows += prepared
            if any(row["exit"] != 0 for row in prepared):
                say(f"  stop  the prepare step failed: no cmd runs in an environment that is not prepared{suffix}")
                selected = []
        for c in selected:
            limit = int(timeout if timeout is not None else c.get("timeout", 1800))
            started = time.monotonic()
            try:
                with contextlib.redirect_stdout(sys.stderr):
                    argv = stack.wrap(str(c["run"]))  # may build an image / start the run's container
                code, output = _run_group(argv, worktree, stack.process_env(), limit)
            except failures as exc:  # e.g. the podman image does not build
                code, output = 125, f"environment failed before the command ran: {exc}\n"
            seconds = round(time.monotonic() - started, 1)
            log = out_dir / (f"{c['name']}.{slug}.log" if several else f"{c['name']}.log")
            log.write_text(output)
            rows.append({"name": c["name"], "cmd": c["run"], "exit": code, "seconds": seconds,
                         "log": log.relative_to(layer).as_posix(),
                         "at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
                         "workflow": adw["name"], "stack": label})
            say(f"  {'ok  ' if code == 0 else 'FAIL'}  {c['name']}  exit {code}  {seconds}s{suffix}")
            if code != 0:
                for line in output.splitlines()[-VERIFY_TAIL:]:
                    say(f"        {line}")
    finally:
        if stack is not None:
            try:
                with contextlib.redirect_stdout(sys.stderr):
                    stack.teardown(True)  # removes the run container, releases ports, usually removes the worktree
            except Exception as exc:  # noqa: BLE001 — foreign runtime code; cleanup below must still happen
                problems.append(f"environment teardown failed ({label}): {exc}")
        for tree in {worktree, Path(state.worktree).resolve()}:
            if tree.exists() and tree != app:
                run(["git", "-C", str(app), "worktree", "remove", "--force", str(tree)], check=False)
                shutil.rmtree(tree, ignore_errors=True)
        run(["git", "-C", str(app), "worktree", "prune"], check=False)
    return rows, state.branch, problems


def write_verify_report(path: Path, rows: list[dict], declared: list[str]) -> None:
    """agents/verify/report.json keeps the latest result of every cmd in every environment stack:
    this invocation's rows replace earlier rows of the same cmd and stack, the others stay (each
    row says when it ran: `at`). Rows are in declaration order, then by stack; a cmd no longer
    declared is dropped. A row of an older report without `stack` counts as stack ""."""
    try:
        old = json.loads(path.read_text()) if path.is_file() else []
    except ValueError:
        old = []
    key = lambda row: (row["name"], str(row.get("stack") or ""))  # noqa: E731
    latest = {key(row): row for row in old if isinstance(row, dict) and "name" in row}
    latest.update({key(row): row for row in rows})
    order = {name: index for index, name in enumerate(declared)}
    kept = sorted((k for k in latest if k[0] in order), key=lambda k: (order[k[0]], k[1]))
    path.write_text(json.dumps([latest[k] for k in kept], indent=2) + "\n")


