SCOUT_JSON = "scout.json"


def facts_for_layer(facts: dict) -> dict:
    """The scout facts as kept in LAYER/scout.json: without the absolute `app` path (a layer may be committed)."""
    return {k: v for k, v in facts.items() if k != "app"}


def write_scout_json(layer: Path, facts: dict) -> None:
    (layer / SCOUT_JSON).write_text(json.dumps(facts_for_layer(facts), indent=2) + "\n")


def init_facts(app: Path, layer: Path) -> None:
    """`al init`: the draft LLM.txt and scout.json (each only when absent), from one scout of APP."""
    if (layer / "LLM.txt").exists() and (layer / SCOUT_JSON).exists():
        return
    facts = scout(app)
    if not (layer / "LLM.txt").exists():
        (layer / "LLM.txt").write_text(render_llm_txt(facts))
    if not (layer / SCOUT_JSON).exists():
        write_scout_json(layer, facts)


def init_in_repo(app: Path, directory: str, layer_arg: Path | None) -> None:
    if layer_arg:
        raise AlError("--layer and --in-repo exclude each other: an in-repo layer is <repository>/<--dir>")
    top = git(app, "rev-parse", "--show-toplevel")
    if not top or Path(top).resolve() != app:
        raise AlError(f"{app} is not the top directory of a git repository")
    parts = [x for x in directory.split("/") if x not in ("", ".")]
    if not parts or ".." in parts or directory.startswith("/"):
        raise AlError(f"--dir must be a relative directory inside the repository without `..` (got {directory!r})")
    rel = "/".join(parts)
    layer = app / rel
    layer.mkdir(parents=True, exist_ok=True)
    init_facts(app, layer)
    shutil.copy(REFERENCE, layer / "AL-DSL.llms.txt")
    if not (layer / ".gitignore").exists():  # `al gen` replaces it with the full list
        (layer / ".gitignore").write_text(f"/trees/\n/agents/\n/artefacts/\n/specs/\n/docs/\n/{IMPROVE_DIR}/\n/tasks.md\n/local.env\n__pycache__/\n*.lock\n")
    up = "/".join([".."] * len(parts))
    print(f"layer: {layer}   (in-repo: committed with the application)\n"
          f"  LLM.txt          draft — complete it with meta/commands/scout-codebase.md\n"
          f"  scout.json       the facts behind the draft (al scout {app} --into {layer} measures the commands)\n"
          f"  AL-DSL.llms.txt  language reference\n"
          f"next: author {rel}/agentic.rkt (meta/commands/author-layer.md) with\n"
          f"        (codebase #:root \"{up}\" …)\n        (layer in-repo #:dir \"{rel}\")\n"
          f"      then `al gen {layer}` and commit the directory: git add {rel} && git commit")


def layer_models_module(layer: Path):
    """The layer's own runtime modules (models, ir, errors), so `al models` and the layer's runs
    read and write the local setting with the same code."""
    if not (layer / "agentic-layer.json").is_file() or not (layer / "adws/adw_modules/models.py").is_file():
        raise AlError(f"{layer} is not a generated layer: run `al gen {layer}` first")
    for name in [n for n in sys.modules if n == "adw_modules" or n.startswith("adw_modules.")]:
        del sys.modules[name]   # another layer's runtime may have been imported before
    sys.path.insert(0, str(layer / "adws"))
    try:
        from adw_modules import errors, ir as ir_module, models
    except ImportError as exc:
        raise AlError(f"cannot import the layer runtime from {layer / 'adws'}: {exc}") from exc
    if not hasattr(models, "write_settings"):
        raise AlError(f"{layer} was generated before local model settings: run `al gen {layer}`")
    return models, ir_module, errors


def layer_runtime_modules(layer: Path, *names: str):
    """The layer's own runtime modules (adw_modules/NAME.py for each name), so `al` and the layer's
    runs apply the same code; `errors` and `ir` are always returned after them."""
    if not (layer / "agentic-layer.json").is_file() or not all(
            (layer / f"adws/adw_modules/{name}.py").is_file() for name in names):
        if (layer / "agentic-layer.json").is_file() and (layer / "adws/adw_modules").is_dir():
            missing = next(n for n in names if not (layer / f"adws/adw_modules/{n}.py").is_file())
            what = "the stand-in decider" if missing in ("decide", "standin") else f"adw_modules/{missing}.py"
            raise AlError(f"{layer} was generated before {what}: run `al gen {layer}`")
        raise AlError(f"{layer} is not a generated layer: run `al gen {layer}` first")
    for name in [n for n in sys.modules if n == "adw_modules" or n.startswith("adw_modules.")]:
        del sys.modules[name]   # another layer's runtime may have been imported before
    sys.path.insert(0, str(layer / "adws"))
    try:
        import importlib
        modules = [importlib.import_module(f"adw_modules.{name}") for name in names]
        from adw_modules import errors, ir as ir_module
    except ImportError as exc:
        raise AlError(f"cannot import the layer runtime from {layer / 'adws'}: {exc}") from exc
    return (*modules, ir_module, errors)


def layer_decide_module(layer: Path):
    """The layer's own decider modules (adw_modules/decide.py and standin.py), so `al decider`,
    `al answer` and the layer's runs read the mode and scope and apply answers with the same code."""
    decide, standin, ir_module, errors = layer_runtime_modules(layer, "decide", "standin")
    return decide, ir_module, errors, standin


def approve_cli(a: argparse.Namespace) -> int:
    """`al approve LAYER RUN WHAT… [--who NAME]`: approve what a run stopped for and resume it.
    `al approve LAYER RUN --all [--who NAME] [--note TEXT]`: approve every item the run waits for a
    person's approval of (adw_modules/approvable.py) and resume it.
    `al approve LAYER RUN ship [--who NAME] [--note TEXT]`: approve a gate stop that only needs a
    person's yes; the runtime merges into the stage branch or settles the run as shipped
    (adw_modules/shipapproval.py).
    0 resumed, merged or shipped, 1 refused (unknown run, not stopped for an approver, nothing waits,
    checks not green), 2 bad use."""
    layer = a.layer.resolve()
    if bool(a.what) == bool(a.all):
        print("al approve: name what you approve (WHAT …) or --all", file=sys.stderr)
        return 2
    ship = a.what == ["ship"]
    if a.note is not None and not (a.all or ship):
        print("al approve: --note goes with --all or ship", file=sys.stderr)
        return 2
    if ship:
        approvable, _shipapproval, ir_module, errors = layer_runtime_modules(layer, "approvable", "shipapproval")
        try:
            loaded = ir_module.load(layer)
        except errors.LayerError as exc:
            raise AlError(str(exc)) from exc
        for line in approvable.lines(approvable.derive(loaded, a.run)):
            print(f"approve: {line}", flush=True)
        result = approvable.approve_ship(loaded, a.run, a.who or _login_name(), "cli", note=a.note or "")
        if result["status"] in ("merged", "shipped"):
            print(f"approve: {result['message']}")
            return 0
        print(f"al approve: refused ({result.get('reason')}): {result.get('message')}", file=sys.stderr)
        return 1
    if a.all:
        approvable, ir_module, errors = layer_runtime_modules(layer, "approvable")
        try:
            loaded = ir_module.load(layer)
        except errors.LayerError as exc:
            raise AlError(str(exc)) from exc
        for line in approvable.lines(approvable.derive(loaded, a.run)):
            print(f"approve: {line}", flush=True)
        result = approvable.approve_resume(loaded, a.run, None, a.who or _login_name(), "cli", note=a.note or "")
        if result["status"] in ("resumed", "merged", "shipped"):
            print(f"approve: {result['message']}")
            return 0
        print(f"al approve: refused ({result.get('reason')}): {result.get('message')}", file=sys.stderr)
        return 1
    approvals, ir_module, errors = layer_runtime_modules(layer, "approvals")
    try:
        for what in a.what:
            approvals.parse(what)
    except ValueError as exc:
        print(f"al approve: {exc}", file=sys.stderr)
        return 2
    try:
        ir_module.load(layer)
    except errors.LayerError as exc:
        raise AlError(str(exc)) from exc
    result = approvals.grant_and_resume(layer, a.run, a.what, a.who or _login_name(), "cli")
    if result["status"] == "resumed":
        print(f"approve: {result['message']}")
        return 0
    print(f"al approve: refused ({result.get('reason')}): {result.get('message')}", file=sys.stderr)
    return 1


def _login_name() -> str:
    import getpass
    try:
        return os.environ.get("AL_APPROVED_BY") or getpass.getuser()
    except (KeyError, OSError):
        return "unknown"


def decider_cli(a: argparse.Namespace) -> int:
    """`al decider LAYER [--set MODE | --reset] [--may K,K] [--pause | --unpause]`: the stand-in's mode,
    scope and limits on this machine. 0 shown or changed, 1 a broken setting, 2 bad use."""
    layer = a.layer.resolve()
    decide, ir_module, errors, standin = layer_decide_module(layer)
    try:
        loaded = ir_module.load(layer)
    except errors.LayerError as exc:
        raise AlError(str(exc)) from exc
    changes: dict = {}
    if a.set:
        changes["mode"] = a.set
    if a.may is not None:
        changes["may"] = [kind.strip() for kind in a.may.split(",") if kind.strip()]
    if a.pause or a.unpause:
        changes["paused"] = bool(a.pause)
    try:
        if a.reset:
            standin.set_local(loaded, via="cli", drop=True)   # the whole local setting goes
        if changes:
            standin.set_local(loaded, via="cli", **changes)
    except ValueError as exc:
        print(f"al decider: {exc}", file=sys.stderr)
        return 2
    try:
        scope = standin.scope(loaded)
        local = decide.read_mode(layer)
    except errors.LayerError as exc:
        raise AlError(str(exc)) from exc
    mode, source, declared = scope["mode"], scope["source"], scope["declared"]
    print(f"mode: {mode} ({source})" + (", paused" if scope["paused"] else ""))
    print(f"scope: may {', '.join(scope['may']) or 'nothing'}; suggests {', '.join(scope['suggests']) or 'nothing'}"
          + (f"; never {', '.join(scope['never'])}" if scope["never"] else ""))
    print(f"limits: {scope['per_run']} actions per run, {scope['per_hour']} per hour")
    if declared:
        print(f"declared: (stand-in {declared.get('kind')} #:may ({' '.join(declared.get('may') or [])})"
              + (f" #:never ({' '.join(declared['never'])})" if declared.get("never") else "") + ")")
    else:
        print("declared: not declared")
    if source == decide.ENV_MODE and local:
        print(f"note: {decide.ENV_MODE} in this environment wins over the local setting ({local})")
    print("modes: off (a person reads every hand-off), suggest (the stand-in proposes, a person answers on the "
          "dashboard or with `al answer`), auto (the stand-in takes the decisions in its scope by itself, at most "
          f"{scope['per_run']} per run, and proposes the others)")
    print(f"settings: {layer / decide.SETTINGS_FILE} (local to this machine, never committed); "
          "applies to runs that stop from now on; one run: --decider MODE")
    return 0


def answer_cli(a: argparse.Namespace) -> int:
    """`al answer LAYER RUN go|alter|explain|reject [TEXT …]` or `al answer LAYER --mail`:
    0 applied, 1 refused (unknown run, nothing waiting), 2 bad use."""
    layer = a.layer.resolve()
    if a.mail:
        if a.run or a.answer:
            print("al answer: --mail takes no RUN or answer", file=sys.stderr)
            return 2
    elif not a.run or not a.answer:
        print("al answer: usage: al answer LAYER RUN go|alter|explain|reject [TEXT …]   or   al answer LAYER --mail",
              file=sys.stderr)
        return 2
    decide, ir_module, errors, _standin = layer_decide_module(layer)
    try:
        loaded = ir_module.load(layer)
    except errors.LayerError as exc:
        raise AlError(str(exc)) from exc
    if a.mail:
        sys.path.insert(0, str(layer / "adws"))
        from adw_modules import localenv
        if not localenv.lookup(decide.ENV_IMAP, localenv.load(loaded)).strip():
            print(f"al answer: {decide.ENV_IMAP} is not set (put imaps://USER:PASSWORD@HOST/INBOX in "
                  f"{layer / 'local.env'} or the environment)", file=sys.stderr)
            return 1
        applied = decide.poll_mail(loaded, out=lambda line: print(line, flush=True))
        print(f"answer: {applied} repl{'y' if applied == 1 else 'ies'} applied")
        return 0
    if a.answer not in decide.ANSWERS:
        print(f"al answer: unknown answer {a.answer!r}; use one of {', '.join(decide.ANSWERS)}", file=sys.stderr)
        return 2
    text = " ".join(a.text or []).strip()
    if a.answer == "alter" and not text:
        print(f'al answer: alter needs the changes as text, e.g. al answer LAYER {a.run} alter "use the v2 API"',
              file=sys.stderr)
        return 2
    result = decide.answer(loaded, a.run, a.answer, text, via="cli")
    if result["status"] == "refused":
        print(f"al answer: {result['message']}", file=sys.stderr)
        return 2 if result["reason"] == "bad-answer" else 1
    print(f"run {a.run}: {a.answer}: {result['message']}")
    return 0


