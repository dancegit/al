#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["jsonschema>=4.20", "pyyaml>=6"]
# ///
"""al — generate an agentic layer for any codebase.

  al init    APP [--layer DIR]     create the layer directory beside the app and scout a draft LLM.txt
  al scout   APP [-o LLM.txt]      deterministic LLM.txt draft (an LLM completes it: meta/commands/scout-codebase.md)
  al compile LAYER                 agentic.rkt -> agentic-layer.json (validated against the schema)
  al gen     LAYER                 compile + generate commands, HOPs, ADWs, env, triggers, forge files
  al check   LAYER                 verify a generated layer and that the application tree is untouched

LAYER is the directory holding agentic.rkt. Nothing is ever written into APP.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tomllib
from collections import Counter
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
KIT = ROOT / "kit"
SCHEMA = ROOT / "schemas" / "agentic-layer-v1.schema.json"
REFERENCE = ROOT / "docs" / "AL-DSL.llms.txt"
FABRIC_DIRS = [Path(p) for p in os.environ.get("AL_FABRIC_DIR", "").split(":") if p] + [
    Path.home() / ".claude/skills/Fabric/Patterns",
    Path.home() / ".config/fabric/patterns",
]


class AlError(Exception):
    pass


def run(cmd: list[str], cwd: Path | None = None, check: bool = True, env: dict | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, cwd=cwd, check=check, text=True, capture_output=True, env=env)


def git(app: Path, *args: str) -> str:
    cp = run(["git", "-C", str(app), *args], check=False)
    return cp.stdout.strip() if cp.returncode == 0 else ""


# ------------------------------------------------------------------------------------------
# scout: deterministic facts about a codebase -> LLM.txt draft
