def layer_reviewpolicy_module(layer: Path):
    """The layer's own review-limit module (adw_modules/reviewpolicy.py), so `al review`, the dashboard's
    "Ship without review" card and the layer's gate read and write the local setting with the same code."""
    if not (layer / "agentic-layer.json").is_file() or not (layer / "adws/adw_modules/reviewpolicy.py").is_file():
        if (layer / "agentic-layer.json").is_file() and (layer / "adws/adw_modules").is_dir():
            raise AlError(f"{layer} was generated before the local review limit: run `al gen {layer}`")
        raise AlError(f"{layer} is not a generated layer: run `al gen {layer}` first")
    for name in [n for n in sys.modules if n == "adw_modules" or n.startswith("adw_modules.")]:
        del sys.modules[name]   # another layer's runtime may have been imported before
    sys.path.insert(0, str(layer / "adws"))
    try:
        from adw_modules import errors, ir as ir_module, reviewpolicy
    except ImportError as exc:
        raise AlError(f"cannot import the layer runtime from {layer / 'adws'}: {exc}") from exc
    return reviewpolicy, ir_module, errors


def review_cli(a: argparse.Namespace) -> int:
    """`al review LAYER [--set ID=N … | --reset [ID]] [--who NAME] [--json]`: each auto review option's
    ship-without-review limit on this machine and where it comes from. Exit 0 shown or changed; 2 bad
    use, or a layer whose gate does not read the local limit (nothing is written)."""
    layer = a.layer.resolve()
    reviewpolicy, _ir_module, _errors = layer_reviewpolicy_module(layer)
    kit = dashboard_kit_module()
    loaded = kit.load_layer(layer, set())
    if loaded is None:
        raise AlError(f"cannot read {layer / 'agentic-layer.json'}")
    known = [option["id"] for option in loaded.review_policy_view()["options"]]

    def refuse(message: str) -> int:
        print(f"al review: {message}", file=sys.stderr)
        return 2

    def unknown(option_id: str) -> str:
        return f"no auto review option named {option_id!r}; this layer has: {', '.join(known) or 'none'}"

    if a.set:
        changes: list[tuple[str, int]] = []
        for item in a.set:
            match = re.fullmatch(r"([^=\s]+)=(\d+)", item)
            if not match:
                return refuse(f"--set takes ID=N (a review option and a whole number of changed lines), not {item!r}")
            if match.group(1) not in known:
                return refuse(unknown(match.group(1)))
            try:
                changes.append((match.group(1), reviewpolicy.check_limit(int(match.group(2)))))
            except ValueError as exc:
                return refuse(str(exc))
        try:
            who = reviewpolicy.check_who(a.who or _login_name())
        except ValueError as exc:
            return refuse(str(exc))
        if not reviewpolicy.gate_reads_limit():
            return refuse(f"refused: this layer's gate does not read the local limit: run `al gen {a.layer}`")
        for option_id, limit in changes:
            reviewpolicy.write_setting(layer, option_id, limit, who=who, via="cli")
    elif a.reset == "*":
        reviewpolicy.write_setting(layer, None, None)   # removes the file, a broken one too
    elif a.reset:
        if a.reset not in known:
            return refuse(unknown(a.reset))
        reviewpolicy.write_setting(layer, a.reset, None)
    view = loaded.review_policy_view()
    settings_file = layer / reviewpolicy.SETTING_FILE
    if a.json:
        print(json.dumps({"options": view["options"], "settings_file": str(settings_file),
                          "gate_reads": view["gate_reads"], "error": view["error"]}, indent=2, sort_keys=True))
        return 0
    lines = kit.review_policy_lines(view)
    for line in lines:
        print(line)
    if not lines:
        print("this layer has no auto review option: every run goes to a person")
    if view["error"]:
        print(f"note: the local setting is ignored: {view['error']}")
    print(f"settings: {settings_file} (local to this machine, never committed); applies to every gate from now on")
    return 0


def _explain_limits(layer: Path) -> None:
    """After `al explain LAYER` on a generated layer: the ship-without-review limits on this machine.
    Never fails the explanation: anything that goes wrong prints nothing."""
    try:
        if not (layer / "agentic-layer.json").is_file():
            return
        kit = dashboard_kit_module()
        lines = kit.review_policy_lines(kit.load_layer(layer.resolve(), set()).review_policy_view())
    except Exception:  # noqa: BLE001 — the explanation was printed; this is an extra
        return
    if lines:
        print("\nShip without review, on this machine")
        for line in lines:
            print(f"    - {line}")


def _minutes(value) -> str:
    return "-" if value is None else f"about {value:g} min"


def testing_cli(a: argparse.Namespace) -> int:
    """`al testing LAYER [--set LEVEL | --reset | --full-before-ship RUN] [--json]`: the testing policy,
    the level on this machine, typical minutes per level and the miss rates. Exit 0; 2 bad use or a
    level the layer's rules refuse; 3 --full-before-ship for a run that is not running; 4 no such run."""
    layer = a.layer.resolve()
    testing, ir_module, errors = layer_testing_module(layer)
    try:
        loaded = ir_module.load(layer)
    except errors.LayerError as exc:
        raise AlError(str(exc)) from exc
    if a.full_before_ship:
        run_id = a.full_before_ship
        if not re.fullmatch(r"[0-9a-f]{8}", run_id):
            print(f"al testing: --full-before-ship takes a run id (8 hexadecimal characters), not {run_id!r}",
                  file=sys.stderr)
            return 2
        try:
            state = json.loads((layer / "agents" / run_id / "state.json").read_text())
        except (OSError, ValueError):
            print(f"al testing: no run {run_id} in {layer}", file=sys.stderr)
            return 4
        if state.get("status") != "running" or any(line.startswith(f"run {run_id} ") for line in died_runs(layer)):
            print(f"al testing: refused: run {run_id} is not running (it is {state.get('status') or 'unknown'}); "
                  "full before it ships applies to a run that has not shipped yet", file=sys.stderr)
            return 3
        request = testing.request_full(layer, run_id, "cli")
        if a.json:
            print(json.dumps({"run": run_id, **request}, indent=2, sort_keys=True))
        else:
            print(f"run {run_id}: full before it ships: its gate runs the full suites "
                  f"({layer / 'agents' / run_id / testing.REQUEST_FILE})")
        return 0
    if a.set:
        allowed, why = testing.setting_allowed(loaded, a.set)
        if not allowed:
            print(f"al testing: refused: {why}", file=sys.stderr)
            return 2
        testing.write_setting(layer, a.set)
    elif a.reset:
        testing.write_setting(layer, None)
    pol = testing.policy(loaded)
    notes: list[str] = []
    try:
        setting = testing.read_setting(layer)
    except errors.LayerError as exc:
        setting = None
        notes.append(f"the local setting is ignored: {exc}")
    if setting:
        depth, source = testing.LEVELS[setting], testing.SOURCE_SETTING
    elif pol["declared"]:
        depth, source = str(pol["perRun"]), testing.SOURCE_POLICY
    else:
        depth, source = "full", testing.SOURCE_UNDECLARED
    level = testing.level_of(depth)
    minutes = testing.typical_minutes(loaded)
    rates = testing.miss_rates(loaded)
    lines = testing.verify_lines(loaded)
    if a.json:
        print(json.dumps({"declared": pol["declared"], "policy": pol, "level": level, "depth": depth, "source": source,
                          "setting": setting, "typical_minutes": minutes, "miss_rates": rates, "lines": lines,
                          "notes": notes, "settings_file": str(layer / testing.SETTING_FILE)},
                         indent=2, sort_keys=True))
        return 0
    for line in lines:
        print(line)
    for note in notes:
        print(f"note: {note}")
    print(f"level: {level} = {depth} ({source})")
    for name, value in testing.LEVELS.items():
        print(f"  {name:<9} {value:<9} {_minutes(minutes.get(name)):<16}{'  <- this machine' if name == level else ''}".rstrip())
    threshold = int(pol.get("maxMissPercent") or 0)
    print("miss rates (targeted runs a batch verified" + (f"; above {threshold}% a command runs full):"
                                                         if threshold else "):"))
    if not rates:
        print("  no targeted runs yet")
    for cmd, rate in sorted(rates.items()):
        share = "-" if rate.get("rate") is None else f"{rate['rate']:g}%"
        strategies = ", ".join(f"{name} {item['misses']}/{item['targeted']}"
                               for name, item in (rate.get("by_strategy") or {}).items())
        print(f"  {cmd}: {rate['misses']} missed of {rate['targeted']} targeted runs ({share})"
              + (": runs full" if rate.get("fallback") else "") + (f"; by strategy {strategies}" if strategies else ""))
    print(f"settings: {layer / testing.SETTING_FILE} (local to this machine, never committed); "
          "applies to runs started from now on; one run: al run … --testing LEVEL")
    return 0


def layer_batch_module(layer: Path):
    """The layer's own batch module (adw_modules/batch.py) and its entry script adws/verify_batch.py,
    so `al batch`, a landed run's ship step and the dashboard start the same kit workflow."""
    if (not (layer / "agentic-layer.json").is_file() or not (layer / "adws/adw_modules/batch.py").is_file()
            or not (layer / "adws/verify_batch.py").is_file()):
        if (layer / "agentic-layer.json").is_file() and (layer / "adws/adw_modules").is_dir():
            raise AlError(f"{layer} was generated before `al batch`: run `al gen {layer}`")
        raise AlError(f"{layer} is not a generated layer: run `al gen {layer}` first")
    for name in [n for n in sys.modules if n == "adw_modules" or n.startswith("adw_modules.")]:
        del sys.modules[name]   # another layer's runtime may have been imported before
    sys.path.insert(0, str(layer / "adws"))
    try:
        from adw_modules import batch
    except ImportError as exc:
        raise AlError(f"cannot import the layer runtime from {layer / 'adws'}: {exc}") from exc
    return batch


def batch_cli(a: argparse.Namespace) -> int:
    """`al batch LAYER run|status …`: the layer's adws/verify_batch.py (adw_modules/batch.main)."""
    layer = a.layer.resolve()
    batch = layer_batch_module(layer)
    if a.action == "status":
        if a.stage or a.if_due or a.detach or a.adw_id:
            print("al batch: --stage, --if-due, --detach and --adw-id go with run", file=sys.stderr)
            return 2
        argv = ["status"]
    else:
        argv = ["run", *(["--stage", a.stage] if a.stage else []), *(["--if-due"] if a.if_due else []),
                *(["--detach"] if a.detach else []), *(["--adw-id", a.adw_id] if a.adw_id else [])]
    argv += ["--json"] if a.json else []
    return int(batch.main(layer, argv) or 0)


def dashboard_command(a: argparse.Namespace) -> tuple[list[str], dict[str, str]]:
    """The kit's dashboard over the given layers and directories (no layer needs to declare one)."""
    dirs = [d.resolve() for d in (a.dirs or [Path(".")])]
    for d in dirs:
        if not d.is_dir():
            raise AlError(f"not a directory: {d}")
    env = dict(os.environ)
    workspace = [w.resolve() for w in (a.workspace or [])]
    for w in workspace:
        if not w.is_dir():
            raise AlError(f"not a directory: {w}")
    if a.podman and (workspace or a.workspace_depth is not None or a.no_workspace or a.no_actions):
        raise AlError("--workspace and actions need the host (git and al); not with --podman")
    if a.podman:
        if a.bind or a.token or a.open:
            raise AlError("--podman publishes on 127.0.0.1 with its own token; --bind, --token and --open do not apply")
        return [str(DASHBOARD_KIT / "run-in-podman.sh"), "--port", str(a.port or 8765),
                *(["--read-only"] if a.read_only else []), *(["--no-start"] if a.no_start else []),
                *map(str, dirs)], env
    argv = [sys.executable, str(DASHBOARD_KIT / "dashboard.py"), "--port", str(a.port or 8765)]
    for d in dirs:
        argv += ["--layer" if (d / "agentic-layer.json").is_file() else "--scan", str(d)]
    argv += ["--bind", a.bind] if a.bind else []
    argv += ["--open"] if a.open else []
    argv += ["--read-only"] if a.read_only else []
    argv += ["--no-start"] if a.no_start else []
    for w in workspace:
        argv += ["--workspace", str(w)]
    argv += ["--workspace-depth", str(a.workspace_depth)] if a.workspace_depth is not None else []
    argv += ["--no-workspace"] if a.no_workspace else []
    argv += ["--no-actions"] if a.no_actions else []
    if a.token:
        env["AL_DASHBOARD_TOKEN"] = a.token   # not on argv, where `ps` would show it
    return argv, env


def dashboard_cli(a: argparse.Namespace) -> int:
    if a.remote is not None:        # the dashboard of a deployed layer, through an ssh tunnel; nothing starts here
        return deploy_module().dashboard_remote(a, sys.modules[__name__])
    if a.remote_port is not None:
        raise AlError("--remote-port goes with --remote HOST")
    argv, env = dashboard_command(a)
    if os.environ.get("AL_DASHBOARD_DRY_RUN"):
        print(json.dumps({"argv": argv, "token": bool(env.get("AL_DASHBOARD_TOKEN"))}))
        return 0
    try:
        return subprocess.call(argv, env=env)
    except KeyboardInterrupt:
        return 130


def eject_cli(a: argparse.Namespace) -> int:
    layer = a.layer.resolve()
    if a.list:
        rows = template_rows(layer, compile_layer(layer))
        width = max([len(f"{r['kind']}/{r['template']}") for r in rows] + [8])
        print(f"{'template'.ljust(width)}  from   used by / status")
        for r in rows:
            print(f"{(r['kind'] + '/' + r['template']).ljust(width)}  {r['from'].ljust(5)}  "
                  f"{', '.join(r['used_by']) or '-'}  [{r['status']}]")
            if r["from"] == "layer" and r["differs"] and (KIT / "templates" / r["kind"] / r["template"]).is_file():
                print(f"{''.ljust(width)}         compare: diff -u {KIT / 'templates' / r['kind'] / r['template']} {r['path']}")
        return 0
    if not a.kind or not a.name:
        raise AlError("usage: al eject LAYER (command|hop|expert) NAME [--force]   or   al eject LAYER --list")
    for src, dst, users in eject(layer, a.kind, a.name, a.force):
        print(f"ejected {dst.relative_to(layer)}  (the kit's {src.name}, unrendered; used by {', '.join(users)})")
    print(f"next:\n  1. edit the copy under {layer / 'templates'}; keep its {{{{placeholders}}}} (an unknown one is an error)\n"
          f"  2. al gen {layer}    every {a.kind} using this template now renders from your copy\n"
          f"  3. al eject {layer} --list   shows when the kit's own version changes, so you can take its improvements")
    return 0


