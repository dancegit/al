    layer = a.layer.resolve()
    decide, ir_module, errors = layer_decide_module(layer)
    try:
        loaded = ir_module.load(layer)
    except errors.LayerError as exc:
        raise AlError(str(exc)) from exc
    if a.set:
        decide.write_mode(layer, a.set)
    elif a.reset:
        decide.write_mode(layer, "")
    try:
        mode, source = decide.mode_for(loaded, None)
        local = decide.read_mode(layer)
    except errors.LayerError as exc:
        raise AlError(str(exc)) from exc
    print(f"mode: {mode} ({source})")
    if source == decide.ENV_MODE and local:
        print(f"note: {decide.ENV_MODE} in this environment wins over the local setting ({local})")
    print("modes: off (a person reads every hand-off), suggest (the decider proposes, a person answers with "
          f"`al answer`), auto (the decider resumes by itself, at most {decide.MAX_AUTO_ROUNDS} times per run)")
    print(f"settings: {layer / decide.SETTINGS_FILE} (local to this machine, never committed); "
          "applies to runs that stop from now on; one run: --decider MODE")
    return 0


def answer_cli(a: argparse.Namespace) -> int:
    """`al answer LAYER RUN go|alter|explain|reject [TEXT …]` or `al answer LAYER --mail`:
    0 applied, 1 refused (unknown run, nothing waiting), 2 bad use."""
    layer = a.layer.resolve()
    if a.mail:
        if a.run or a.answer:
            print("al answer: --mail takes no RUN or answer", file=sys.stderr)
            return 2
    elif not a.run or not a.answer:
        print("al answer: usage: al answer LAYER RUN go|alter|explain|reject [TEXT …]   or   al answer LAYER --mail",
              file=sys.stderr)
        return 2
    decide, ir_module, errors = layer_decide_module(layer)
    try:
        loaded = ir_module.load(layer)
    except errors.LayerError as exc:
        raise AlError(str(exc)) from exc
    if a.mail:
        sys.path.insert(0, str(layer / "adws"))
        from adw_modules import localenv
        if not localenv.lookup(decide.ENV_IMAP, localenv.load(loaded)).strip():
            print(f"al answer: {decide.ENV_IMAP} is not set (put imaps://USER:PASSWORD@HOST/INBOX in "
                  f"{layer / 'local.env'} or the environment)", file=sys.stderr)
            return 1
        applied = decide.poll_mail(loaded, out=lambda line: print(line, flush=True))
        print(f"answer: {applied} repl{'y' if applied == 1 else 'ies'} applied")
        return 0
    if a.answer not in decide.ANSWERS:
        print(f"al answer: unknown answer {a.answer!r}; use one of {', '.join(decide.ANSWERS)}", file=sys.stderr)
        return 2
    text = " ".join(a.text or []).strip()
    if a.answer == "alter" and not text:
        print(f'al answer: alter needs the changes as text, e.g. al answer LAYER {a.run} alter "use the v2 API"',
              file=sys.stderr)
        return 2
    result = decide.answer(loaded, a.run, a.answer, text, via="cli")
    if result["status"] == "refused":
        print(f"al answer: {result['message']}", file=sys.stderr)
        return 2 if result["reason"] == "bad-answer" else 1
    print(f"run {a.run}: {a.answer}: {result['message']}")
    return 0


