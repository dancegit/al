LANG_BY_EXT = {
    ".py": "python", ".rs": "rust", ".go": "go", ".ts": "typescript", ".tsx": "typescript",
    ".js": "javascript", ".jsx": "javascript", ".mjs": "javascript", ".c": "c", ".h": "c",
    ".cc": "cpp", ".cpp": "cpp", ".hpp": "cpp", ".java": "java", ".kt": "kotlin", ".rb": "ruby",
    ".php": "php", ".cs": "csharp", ".swift": "swift", ".ex": "elixir", ".exs": "elixir",
    ".hs": "haskell", ".rkt": "racket", ".zig": "zig", ".scala": "scala", ".lua": "lua",
    ".sh": "shell", ".nix": "nix", ".vue": "vue", ".svelte": "svelte", ".dart": "dart",
    ".ml": "ocaml", ".clj": "clojure", ".erl": "erlang", ".jl": "julia", ".r": "r", ".tcl": "tcl",
}
NIX_BY_LANG = {
    "python": ["python312", "uv"], "rust": ["cargo", "rustc", "clippy", "rustfmt", "gcc"],
    "go": ["go"], "typescript": ["nodejs_22"], "javascript": ["nodejs_22"],
    "c": ["gcc", "gnumake", "pkg-config"], "cpp": ["gcc", "gnumake", "cmake", "pkg-config"],
    "java": ["jdk21", "maven"], "kotlin": ["jdk21", "gradle"], "ruby": ["ruby"], "php": ["php"],
    "csharp": ["dotnet-sdk"], "elixir": ["elixir"], "haskell": ["ghc", "cabal-install"],
    "racket": ["racket"], "zig": ["zig"], "tcl": ["tcl"],
}
PROTECTED_CANDIDATES = [
    ".github", ".forgejo", ".gitea", ".gitlab-ci.yml", ".circleci", "LICENSE", "LICENSE.txt",
    "LICENSE.md", "COPYING", "SECURITY.md", "CODEOWNERS", "migrations", "release", "releases",
    ".goreleaser.yml", ".goreleaser.yaml", "Cargo.lock", "uv.lock", "package-lock.json",
    "pnpm-lock.yaml", "yarn.lock", "bun.lock", "bun.lockb", "go.sum", "flake.lock",
]


def scout(app: Path) -> dict:
    app = app.resolve()
    if not (app / ".git").exists():
        raise AlError(f"{app} is not a git checkout")
    files = [f for f in git(app, "ls-files").splitlines() if f]
    exts = Counter(LANG_BY_EXT[Path(f).suffix.lower()] for f in files if Path(f).suffix.lower() in LANG_BY_EXT)
    langs = [l for l, _ in exts.most_common() if l not in ("shell", "nix")][:4] or [l for l, _ in exts.most_common()][:1]
    top = Counter(f.split("/")[0] for f in files if "/" in f)
    has = lambda p: (app / p).exists()  # noqa: E731
    cmds: list[dict] = []
    evidence: list[str] = []
    notes: list[str] = []

    def add(name: str, shell: str, proves: str, ev: str, network: str = "no") -> None:
        if not any(c["name"] == name for c in cmds):
            cmds.append({"name": name, "shell": shell, "proves": proves, "network": network})
            evidence.append(f"{name}: {ev}")

    pm = ""
    if has("Cargo.toml"):
        pm = "cargo add"
        add("build", "cargo build --all-targets", "the workspace compiles", "Cargo.toml")
        add("test", "cargo test", "unit and integration tests pass", "Cargo.toml")
        add("lint", "cargo clippy --all-targets -- -D warnings", "no clippy warnings", "Cargo.toml")
        add("format", "cargo fmt --all -- --check", "formatting is canonical", "Cargo.toml")
    if has("go.mod"):
        pm = pm or "go get"
        add("build", "go build ./...", "all packages compile", "go.mod")
        add("test", "go test ./...", "all package tests pass", "go.mod")
        add("lint", "go vet ./...", "no vet findings", "go.mod")
    if has("package.json"):
        try:
            pkg = json.loads((app / "package.json").read_text())
        except json.JSONDecodeError:
            pkg = {}
        runner = ("bun" if has("bun.lock") or has("bun.lockb") else "pnpm" if has("pnpm-lock.yaml")
                  else "yarn" if has("yarn.lock") else "npm")
        pm = pm or {"bun": "bun add", "pnpm": "pnpm add", "yarn": "yarn add", "npm": "npm install"}[runner]
        add("install", f"{runner} install", "dependencies resolve", "package.json", "yes")
        for script in ("lint", "typecheck", "test", "build", "e2e", "start", "docs"):
            if script in (pkg.get("scripts") or {}):
                add(script, f"{runner} run {script}", f"package.json script `{script}`: {pkg['scripts'][script][:80]}",
                    f"package.json scripts.{script}")
    if has("pyproject.toml") or has("setup.py") or has("setup.cfg") or has("requirements.txt"):
        py = {}
        if has("pyproject.toml"):
            try:
                py = tomllib.loads((app / "pyproject.toml").read_text())
            except tomllib.TOMLDecodeError:
                notes.append("pyproject.toml did not parse")
        tool = py.get("tool", {})
        uv = has("uv.lock") or "uv" in tool
        pre = "uv run " if uv else ""
        pm = pm or ("uv add" if uv else "pip install")
        if uv:
            add("install", "uv sync", "the locked environment resolves", "uv.lock / [tool.uv]", "yes")
        elif has("pyproject.toml") or has("setup.py"):
            add("install", "python -m pip install -e .", "the package installs", "pyproject.toml / setup.py", "yes")
        if "pytest" in tool or has("pytest.ini") or has("tox.ini") or has("conftest.py") or has("tests"):
            add("test", f"{pre}pytest -q", "the test suite passes", "pytest config / tests dir")
        if "ruff" in tool or has("ruff.toml") or has(".ruff.toml"):
            add("lint", f"{pre}ruff check", "no lint findings", "[tool.ruff]")
        if "mypy" in tool or has("mypy.ini"):
            add("typecheck", f"{pre}mypy", "types check", "[tool.mypy]")
    if has("pom.xml"):
        add("build", "mvn -q -DskipTests package", "the project builds", "pom.xml", "yes")
        add("test", "mvn -q test", "tests pass", "pom.xml", "yes")
    if has("build.gradle") or has("build.gradle.kts"):
        add("build", "./gradlew assemble", "the project builds", "build.gradle", "yes")
        add("test", "./gradlew test", "tests pass", "build.gradle", "yes")
    if has("Gemfile"):
        add("install", "bundle install", "gems resolve", "Gemfile", "yes")
        add("test", "bundle exec rake test", "tests pass", "Gemfile (verify the rake task)")
    if has("mix.exs"):
        add("test", "mix test", "tests pass", "mix.exs")
    if has("CMakeLists.txt"):
        add("build", "cmake -S . -B build && cmake --build build -j", "the project builds", "CMakeLists.txt")
        add("test", "ctest --test-dir build --output-on-failure", "ctest passes", "CMakeLists.txt")
    if has("Makefile") or has("makefile") or has("GNUmakefile"):
        mk = next(p for p in ("Makefile", "makefile", "GNUmakefile") if has(p))
        targets = set(re.findall(r"^([A-Za-z0-9_.-]+)\s*:(?!=)", (app / mk).read_text(errors="replace"), re.M))
        add("build", "make -j", "the default target builds", mk)
        for t, name in (("test", "test"), ("check", "test"), ("lint", "lint"), ("fmt", "format"), ("docs", "docs")):
            if t in targets:
                add(name, f"make {t}", f"make target `{t}`", f"{mk} target {t}")
    if has("configure") or has("configure.ac") or has("autogen.sh"):
        notes.append("autotools project: build probably needs `autoreconf -i && ./configure` before make — verify")
    if has("tox.ini"):
        notes.append("tox.ini present: CI may run the suite through tox")
    if has("noxfile.py"):
        notes.append("noxfile.py present: CI may run the suite through nox")
    if has("justfile") or has("Justfile"):
        notes.append("justfile present: prefer its recipes where they exist")

    test_dirs = sorted({d for d in top if re.fullmatch(r"(tests?|spec|specs|__tests__|testing|e2e)", d)})
    doc_dirs = sorted({d for d in top if re.fullmatch(r"(docs?|documentation|website)", d)})
    skip = set(test_dirs) | set(doc_dirs) | {".github", ".forgejo", "examples", "benches", "scripts", "ci"}
    src_dirs = [d for d, _ in top.most_common(8) if d not in skip and not d.startswith(".")][:5]
    protected = [p for p in PROTECTED_CANDIDATES if has(p)]
    remote = git(app, "remote", "get-url", "origin")
    forge, repo = "none", ""
    m = re.search(r"[:/]([^/:]+/[^/]+?)(?:\.git)?$", remote)
    if m:
        repo = m.group(1)
        forge = "github" if "github.com" in remote else "forgejo" if re.search(r"forgejo|gitea|codeberg", remote) else "unknown"
    ci = [p for p in (".github/workflows", ".forgejo/workflows", ".gitea/workflows", ".gitlab-ci.yml", ".circleci") if has(p)]
    head = git(app, "symbolic-ref", "--short", "refs/remotes/origin/HEAD").removeprefix("origin/") or git(app, "branch", "--show-current") or "main"
    readme = next((p for p in ("README.md", "README.rst", "README.txt", "README") if has(p)), "")
    summary = ""
    if readme:
        for para in re.split(r"\n\s*\n", (app / readme).read_text(errors="replace")):
            text = " ".join(l.strip() for l in para.splitlines())
            if len(text) > 60 and not re.match(r"^(#|=|\.\.|\[!\[|<|!\[|-{3,}|\|)", text.strip()):
                summary = re.sub(r"\s+", " ", text)[:400]
                break
    license_file = next((p for p in ("LICENSE", "LICENSE.txt", "LICENSE.md", "COPYING", "LICENSE-MIT") if has(p)), "")
    nix = list(dict.fromkeys(pkg for l in langs for pkg in NIX_BY_LANG.get(l, [])))
    if has("bun.lock") or has("bun.lockb"):
        nix.append("bun")
    return {
        "name": re.sub(r"[^a-z0-9._-]", "-", app.name.lower()), "app": str(app), "summary": summary,
        "remote": remote, "repo": repo, "forge": forge, "ci": ci, "default_branch": head,
        "license": license_file, "languages": langs, "lang_counts": dict(exts.most_common(6)),
        "files": len(files), "top": top.most_common(14), "src": src_dirs, "tests": test_dirs,
        "docs": doc_dirs, "readme": readme, "commands": cmds, "evidence": evidence, "notes": notes,
        "protected": protected, "nix": nix + ["git"], "package_manager": pm,
        "contributing": next((p for p in ("CONTRIBUTING.md", "CONTRIBUTING.rst", "docs/contributing.rst", "HACKING.md") if has(p)), ""),
    }


def render_llm_txt(s: dict) -> str:
    def bullets(items, empty="- (none found)"):
        return "\n".join(f"- {i}" for i in items) or empty
    rows = "\n".join(f"| {c['name']} | `{c['shell']}` | {c['proves']} | UNVERIFIED | {c['network']} |" for c in s["commands"])
    layout = "\n".join(
        f"- `{d}/` — {n} files" + (" (tests)" if d in s["tests"] else " (docs)" if d in s["docs"] else "")
        for d, n in s["top"])
    return f"""# {s['name']}

> {s['summary'] or 'UNVERIFIED: no summary paragraph found in the README.'}

<!-- Draft produced by `al scout` from repository facts only. Every line marked UNVERIFIED
     must be confirmed or corrected by the scout-codebase meta command before authoring the layer. -->

## Identity

- Repository: {s['remote'] or 'UNVERIFIED (no origin remote)'}
- Default branch: {s['default_branch']}
- License: {s['license'] or 'UNVERIFIED'}
- Primary languages: {', '.join(s['languages'])} (tracked files by language: {s['lang_counts']})
- Kind: UNVERIFIED (library | cli | service | web-app | mobile | monorepo | data/ml | infra)
- Tracked files: {s['files']}

## Layout

{layout or '- (flat repository)'}
- Entry document: `{s['readme'] or 'UNVERIFIED'}`
- Source paths (guess): {', '.join(f'`{d}`' for d in s['src']) or 'UNVERIFIED'}
- Test paths: {', '.join(f'`{d}`' for d in s['tests']) or 'UNVERIFIED'}
- Doc paths: {', '.join(f'`{d}`' for d in s['docs']) or '(none)'}

## Commands

| name | shell command from repo root | proves what | typical duration | needs network? |
|---|---|---|---|---|
{rows or '| UNVERIFIED | | | | |'}

## Toolchain

- nixpkgs attributes (guess from languages): {' '.join(s['nix'])}
- Package manager: {s['package_manager'] or 'UNVERIFIED'}
- Services needed: UNVERIFIED

## Artefacts

- log — always (captured command output)
- junit / coverage / images / video / traces: UNVERIFIED — state the flag that emits each and the glob where it lands

## Conventions

- UNVERIFIED — extract from `{s['contributing'] or 'CONTRIBUTING / README'}`

## Protected paths

{bullets(f'`{p}`' for p in s['protected'])}

## Work classes

- chore / bug / feature: UNVERIFIED — describe a typical one here and which are safe for zero-touch

## Forge

- Forge: {s['forge']}{f" ({s['repo']})" if s['repo'] else ''}
- CI: {', '.join(f'`{c}`' for c in s['ci']) or '(none found)'}

## Conditional docs

- UNVERIFIED

## Evidence

{bullets(s['evidence'])}

## Unknowns

{bullets(s['notes'] + ['command durations', 'which commands need network', 'artefact globs'])}
"""


