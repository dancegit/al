IMPROVE_COMMANDS = ("improve", "improve-check")


def improve_parsers(sub) -> None:
    p = sub.add_parser("improve", help="change a layer through al's own reviewed workflow (ends in a pull request)")
    p.add_argument("layer", type=Path)
    p.add_argument("request", help="what to change, in plain words")
    p.add_argument("--dry-run", action="store_true", help="the mock agent does the work (no LLM, no cost)")
    p.add_argument("--review", default="human", metavar="human|agent",
                   help="human (default): a person reviews the pull request; agent: an agent reviews first, a person merges")
    p.add_argument("--mock-scripts", type=Path, metavar="DIR",
                   help="scripted mock responses (<step>.json) for --dry-run, copied into the workflow's mock/improve/")
    p.add_argument("--model-set", metavar="TIER", help="every agent step of the change uses TIER (also AL_MODEL_SET)")
    p.add_argument("--model", action="append", default=[], metavar="TIER=MODEL_ID",
                   help="use MODEL_ID for tier TIER in this change (repeatable; also AL_MODELS)")
    p.add_argument("--max-cost", metavar="USD", help="stop the change once its agent calls cost more (also AL_MAX_COST)")
    p.add_argument("--adw-id", help=argparse.SUPPRESS)
    p = sub.add_parser("improve-check", help="one check of the layer-change workflow (run by `al improve`, in its worktree)")
    p.add_argument("what", choices=("definition", "regenerate", "scope", "check", "dry-runs", "verify", "report"))
    p.add_argument("--sub", default=".", help="the layer directory inside the worktree")
    p.add_argument("--app", type=Path, required=True, help="the application checkout the layer wraps")
    p.add_argument("--default-branch", default="main", help="the branch the change is based on")


