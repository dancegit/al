def _sandbox_ir(layer: Path) -> dict:
    """The IR of a generated layer that declares a toolchain (`al sandbox LAYER update`, `build --toolchain`)."""
    if not (layer / "agentic-layer.json").is_file():
        raise AlError(f"{layer} is not a generated layer: run `al gen {layer}` first")
