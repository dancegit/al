def compile_layer(layer: Path) -> dict:
    src = layer if layer.suffix == ".rkt" else layer / "agentic.rkt"
    if not src.exists():
        raise AlError(f"{src} not found")
    env = dict(os.environ, PLTCOLLECTS=f"{ROOT / 'racket'}:{os.environ.get('PLTCOLLECTS', '')}")
    cp = run(["racket", str(src)], check=False, env=env)
    if cp.returncode != 0:
        raise AlError("agentic.rkt does not compile:\n" + cp.stderr.strip())
    ir = json.loads(cp.stdout)
    import jsonschema
    errors = sorted(jsonschema.Draft202012Validator(json.loads(SCHEMA.read_text())).iter_errors(ir), key=lambda e: list(e.path))
    if errors:
        raise AlError("IR does not match the schema (compiler/schema drift):\n" + "\n".join(
            f"  {'/'.join(map(str, e.path))}: {e.message}" for e in errors[:10]))
    return ir


