    return sandbox, ir_module, errors, envs


def _sandbox_stack(loaded, env_id: str | None, workflow: str | None) -> tuple[dict, dict | None, list[str]]:
    """(podman option, ADW or None, environment ids) that `al sandbox LAYER doctor|shell` starts: the
    workflow's own stack; by default the first workflow whose stack holds the chosen podman option."""
    podman = [e for e in loaded.ir.get("environments") or [] if e.get("kind") == "podman"]
    if not podman:
        raise SandboxUsage(f"layer {loaded.name} declares no (environment podman …): there is no sandbox")
    ids = [str(e["id"]) for e in podman]
    if env_id is not None and env_id not in ids:
        raise SandboxUsage(f"no podman environment `{env_id}`; podman environments: {', '.join(ids)}")
    adws = loaded.ir.get("adws") or []
    if workflow is not None:
        adw = next((x for x in adws if x["name"] == workflow), None)
        if adw is None:
            raise SandboxUsage(f"no workflow `{workflow}`; workflows: {', '.join(x['name'] for x in adws)}")
        mine = [i for i in adw.get("environment", []) if i in ids]
        if not mine or (env_id is not None and env_id not in mine):
            raise SandboxUsage(f"workflow `{workflow}` does not run in "
                               f"{'podman environment `' + env_id + '`' if env_id else 'a podman environment'}")
        return next(e for e in podman if e["id"] == mine[0]), adw, list(adw["environment"])
    chosen = env_id or ids[0]
    adw = next((x for x in adws if chosen in x.get("environment", [])), None)
    option = next(e for e in podman if e["id"] == chosen)
    if adw is not None:
        return option, adw, list(adw["environment"])
    worktree = next((e["id"] for e in loaded.ir.get("environments") or [] if e.get("kind") == "worktree"), None)
    if worktree is None:
        raise SandboxUsage(f"no workflow runs in podman environment `{chosen}` and the layer declares no worktree "
                           "environment to start it on")
    return option, None, [worktree, chosen]


def _sandbox_build_toolchain(a: argparse.Namespace, layer: Path, loaded, sandbox, tid: str) -> int:
    """`al sandbox LAYER build` when the recipe's podman option has a toolchain: pin nixpkgs if there
    is no lock yet, then build the recipe image (al-<layer>:<recipe hash>) unless it exists."""
    images = getattr(sandbox, "images", None)
    if images is None:
        raise AlError(f"{layer} was generated before toolchains: run `al gen {layer}`")
    if not (layer / "env/flake.lock").is_file():
        try:
            way = images.choose_way()
            images.lock(layer / "env", way=way)
        except images.BuildError as exc:
            raise AlError(f"sandbox: {exc}") from exc
        print(f"lock: env/flake.lock written ({images.way_sentence(way)})")
    ref = sandbox.image_ref(loaded)   # after the lock: it is part of the recipe
    if not a.no_cache and sandbox.image_exists(ref):
        sandbox.ensure_image(loaded)   # re-points :latest
        print(f"sandbox: {ref} is up to date (toolchain {tid}, lock and declaration unchanged)")
        return 0
    built = sandbox.build_image(loaded, no_cache=a.no_cache, say=lambda line: print(line, file=sys.stderr, flush=True))
    report = built.get("report") or {}
    print(f"sandbox: {ref} from toolchain `{tid}` ({images.way_sentence(report.get('way') or images.choose_way())})")
    for name, size in [*report.get("sizes", {}).items(), ("image", report.get("imageSize"))]:
        print(f"  {name:<11} {images.human_size(size)}")
    if report.get("sizeNote"):
        print(f"note: sizes per feature not measured: {report['sizeNote']}")
    print(f"report: agents/sandbox/{tid}.json")
    return 0


class SandboxUsage(AlError):
    """`al sandbox` asked for something the layer does not have: exit 2."""


def sandbox_cli(a: argparse.Namespace) -> int:
    """al sandbox LAYER build|update|doctor|shell|prune|status|push|pull."""
    if a.action == "update":   # needs a toolchain and images.py only: no podman environment, no stack
        return cmd_sandbox_update(a)
    layer = a.layer.resolve()
    sandbox, ir_module, errors, envs = layer_sandbox_module(layer)
    say = lambda line: print(line, flush=True)  # noqa: E731
    try:
        loaded = ir_module.load(layer)
    except errors.LayerError as exc:
        raise AlError(str(exc)) from exc
    if a.action in ("push", "pull"):
        return sandbox_module().main(a, sys.modules[__name__])
    try:
        option, adw, env_ids = _sandbox_stack(loaded, getattr(a, "env", None),
                                              getattr(a, "workflow", None))
    except SandboxUsage as exc:
        print(f"al sandbox: {exc}", file=sys.stderr)
        return 2
    try:
        if a.action == "status":
            rows = sandbox.image_status(loaded)
            current = [r for r in rows if not r["old"]]
            width = max(len(r["env"]) for r in current)
            for r in current:
                print(f"{r['env']:<{width}}  recipe {r['recipe']}  {'built' if r['built'] else 'not built':<9}  "
                      f"{sandbox.human_size(r['size']):>8}  {r['age']:>4}  {r['image']}")
            if len(current) > 1:
                print(f"(one image for every podman environment: built from env/Containerfile, "
                      f"which comes from `{current[0]['recipe_from']}`)")
            for r in rows:
                if r["old"]:
                    print(f"old  recipe {r['recipe']}  {sandbox.human_size(r['size']):>8}  {r['age']:>4}  {r['image']}"
                          + ("  (in use)" if r["in_use"] else ""))
            return 0
        if a.action == "prune":
            removed = sandbox.prune_images(loaded)
            for ref in removed:
                print(f"removed {ref}")
            print(f"pruned {len(removed)} image(s)")
            engine = getattr(sandbox, "nested_engine", None)   # a layer generated before #:nested-engine has none
            if engine is not None:
                volumes = engine.collect_stale_volumes(loaded)
                for name in volumes:
                    print(f"removed volume {name}")
                if volumes:
                    print(f"pruned {len(volumes)} nested-engine volume(s)")
            if a.tests:   # what al's test suites left (labelled al.test), never this layer's current image
                runner = podman_runner()
                leftovers = diskuse_module().remove_labelled(
                    runner, keep={sandbox.image_ref(loaded), f"al-{loaded.name}:latest"}) if runner else []
                for ref in leftovers:
                    print(f"removed {ref}")
                print(f"pruned {len(leftovers)} test leftover(s)")
            return 0
        if a.action == "build":
            wanted = getattr(a, "toolchain", None)
            recipe_from = sandbox.recipe_option(loaded) or {}
            if wanted:
                declared = [t["id"] for t in _sandbox_ir(layer)["toolchains"]]
                if wanted not in declared:
                    raise AlError(f"no toolchain `{wanted}`; declared: {', '.join(declared)}")
                users = [o for o in loaded.ir["environments"] if o["kind"] == "podman" and o.get("toolchain") == wanted]
                if not users:
                    raise AlError(f"no podman environment uses toolchain `{wanted}`: the sandbox image is built for "
                                  "(environment podman #:toolchain ID)")
                if recipe_from.get("toolchain") != wanted:
                    raise AlError(f"toolchain `{wanted}` is used by podman environment `{users[0]['id']}`, but a layer has "
                                  f"one image, built for its first podman environment (`{recipe_from.get('id')}`)")
            if recipe_from.get("toolchain"):
                return _sandbox_build_toolchain(a, layer, loaded, sandbox, str(recipe_from["toolchain"]))
            ref = sandbox.image_ref(loaded)
            if not a.no_cache and sandbox.image_exists(ref):
                sandbox.ensure_image(loaded, say=say)   # re-points :latest
                print(f"image {ref} is current (recipe {sandbox.recipe_hash(loaded)})")
                return 0
            built = sandbox.build_image(loaded, no_cache=a.no_cache, say=say)
            print(f"built {built['image']} in {built['seconds']:.0f}s, {sandbox.human_size(built['size'])}")
            return 0
        sandbox.ensure_image(loaded, say=say)
        if a.action == "doctor":
            with contextlib.redirect_stdout(sys.stderr):   # the runtime's progress lines; the table goes to stdout
                with sandbox.throwaway(loaded, env_ids, "doctor") as stack:
                    checks = sandbox.doctor(loaded, stack, adw)
            print(f"doctor: workflow {adw['name'] if adw else '(none)'}, stack {' → '.join(env_ids)}, "
                  f"image {sandbox.image_ref(loaded)}")
            print(sandbox.format_table(checks))
            # testing lines, then the coverage lines, before the summary: that stays the last line
            for line in testing_lines(layer) + coverage_lines(layer, getattr(a, "workflow", None)):
                print(line)
            print(f"doctor: {sandbox.summary(checks)}")
            return 1 if any(c.status == "miss" for c in checks) else 0
        if a.action == "shell":
            with sandbox.throwaway(loaded, env_ids, "shell") as stack:
                print(f"shell in {sandbox.image_ref(loaded)} (stack {' → '.join(env_ids)}), worktree {stack.cwd}; "
                      "the worktree and the container are removed when the shell exits", flush=True)
                code = subprocess.call(sandbox.shell_argv(stack))
            print(f"removed the worktree {stack.cwd}")
            return code
    except errors.StepFailed as exc:
        print(f"al sandbox: {exc}", file=sys.stderr)
        return 1
    except errors.LayerError as exc:
        raise AlError(str(exc)) from exc
    return 0


def _voice_service_module(serve: Path):
    """The layer's adws/voice/serve.py as a module: its file checks are standard library only (the speech
    packages are imported lazily), so `al voice` reads the model files' state without them."""
    import importlib.util
    spec = importlib.util.spec_from_file_location("al_layer_voice_serve", serve)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def voice_cli(a: argparse.Namespace) -> int:
    """al voice LAYER setup|doctor [--json]: the layer's own adws/voice/serve.py. `setup` (downloads and
    checksums, standard library only) and a `doctor` that finds files missing run with this Python, so nothing
    but the recorded model files is fetched; a full `doctor` loads the engines with `uv run --script`."""
    layer = a.layer.absolute()
    ir_path = layer / "agentic-layer.json"
    if not ir_path.is_file():
        raise AlError(f"{layer} is not a generated layer: run `al gen {layer}` first")
    try:
        ir = json.loads(ir_path.read_text())
    except ValueError as exc:
        raise AlError(f"{ir_path}: {exc}") from exc
    if not ir.get("voice"):
        print(f"al voice: layer {ir.get('name', layer.name)} declares no (voice …): there is no voice helper "
              "(add (voice kokoro) to agentic.rkt and run `al gen`)", file=sys.stderr)
        return 2
    serve = layer / "adws/voice/serve.py"
    if not serve.is_file() or not (layer / "adws/voice/models.json").is_file():
        raise AlError(f"{layer} was generated before `al voice`: run `al gen {layer}`")
    args = ["--layer", str(layer)]
    if a.action == "setup":
        return subprocess.call([sys.executable, str(serve), "setup", *args])
    args += ["--json"] if a.json else []
    module = _voice_service_module(serve)
    try:
        paths = module.cache_paths(module.load_manifest(), module.stt_model_of(str(layer), None))
        ready = not module.missing_files(module.verify(paths, checksum=False))
    except module.NotRecorded:
        ready = False                   # the service's own doctor names the recorded models (exit 2)
    if not ready:                       # it reports the files and exits before importing any engine
        return subprocess.call([sys.executable, str(serve), "doctor", *args])
    uv = tools_module().need(("uv",), layer)["uv"]
    return subprocess.call([uv, "run", "--quiet", "--script", str(serve), "doctor", *args])


def run_cli(a: argparse.Namespace) -> int:
    """al run LAYER /NAME [ARGS …]: one start through the layer's launch.start, attached by default."""
    layer = a.layer.resolve()
    if a.restart or a.follow:
        return run_again_cli(a)
    if not a.target:
        print("al run: name what to start: /NAME (a workflow, command or hop of the layer)", file=sys.stderr)
        return 2
    launch, ir_module, errors = layer_launch_module(layer)
    try:
        loaded = ir_module.load(layer)
    except errors.LayerError as exc:
        raise AlError(str(exc)) from exc
    try:
        target = launch.resolve_target(loaded, a.target)
    except errors.LayerError as exc:
        print(f"al run: {exc}", file=sys.stderr)
        return 2
    if a.testing and "testing" not in inspect.signature(launch.start).parameters:
        raise AlError(f"{layer} was generated before targeted testing (--testing): run `al gen {layer}`")
    words = list(a.args or [])
    if target.prompt:   # `al run L "/plan-chore tidy the readme"` (one quoted argument)
        words.insert(0, target.prompt)
    if words in ([], ["-"]) and (words == ["-"] or not sys.stdin.isatty()):
        prompt = sys.stdin.read()
    else:
        prompt = " ".join(words)
    shown = f"(layer: {loaded.name}, {target.kind} {target.name})"

    def spawn(argv: list[str], **popen):
        run_id = argv[argv.index("--adw-id") + 1]
        print(f"run {run_id} started {shown}", flush=True)
        return subprocess.Popen(argv, **popen)

    try:
        result = launch.start(loaded, target, prompt, request_key=a.request_key or secrets.token_hex(16),
                              klass=a.klass, model_set=a.model_set, models=a.model, confirm_duplicate=a.yes,
                              confirm_ships=a.yes, dry_run=a.dry_run, detach=a.detach, spawn=spawn,
                              replaces=a.replaces or "", **({"testing": a.testing} if a.testing else {}),
                              **({"approvals": list(a.approve), "approved_by": a.who or _login_name()}
                                 if a.approve else {}),
                              **({"on": a.on} if a.on else {}))
    except KeyboardInterrupt:
        return 130
    status = result["status"]
    if status == "started":
        if result.get("existing"):
            print(f"run {result['run_id']} was already started for this request key {shown}")
            return 0
        if result.get("queued"):
            print(f"note: {result['queued']}", flush=True)
        return int(result.get("exit", 0)) if not a.detach else 0
    if status in ("confirm-duplicate", "confirm-ships"):
        print(f"al run: {result['message']}; pass --yes to start it anyway", file=sys.stderr)
        return 4
    if status == "refused":
        print(f"al run: refused: {result['message']}", file=sys.stderr)
        return 3
    if status == "invalid":
        print(f"al run: {result['error']}", file=sys.stderr)
        return 2
    print(f"al run: {result.get('error') or status}", file=sys.stderr)
    return 1


def models_cli(a: argparse.Namespace) -> int:
    layer = a.layer.resolve()
    models, ir_module, errors = layer_models_module(layer)
    try:
        loaded = ir_module.load(layer)
    except errors.LayerError as exc:
        raise AlError(str(exc)) from exc
    known = models.declared_tiers(loaded)
    try:
        current = models.read_settings(layer)
    except errors.LayerError as exc:
        if a.reset != "*":   # a broken file can always be removed with a bare --reset
            raise AlError(str(exc)) from exc
        current = {}
    notes: list[str] = []
    if a.set:
        changes: dict[str, str] = {}
        for item in a.set:
            try:
                parsed = models.parse_models(item, "--set")
                if not parsed:
                    raise ValueError(f"--set: expected TIER=MODEL_ID (e.g. heavy=claude-fable-5-2), got {item!r}")
                for tier, model in parsed.items():
                    note = models.check_setting(tier, model, known)
                    if note:
                        notes.append(note)
                changes.update(parsed)
            except ValueError as exc:
                raise AlError(str(exc)) from exc
        models.write_settings(layer, {**current, **changes})
    elif a.reset == "*":
        models.write_settings(layer, {})
    elif a.reset:
        if a.reset not in known:
            raise AlError(f"no agent of this layer has a tier `{a.reset}`; declared: {', '.join(known)}")
        models.write_settings(layer, {k: v for k, v in current.items() if k != a.reset})
    for note in notes:
        print(f"note: {note}")
    try:
        valid, ignored = models.local_settings(loaded)
        over = models.overrides(None, None, None, settings=valid)
    except (errors.LayerError, ValueError) as exc:
        raise AlError(str(exc)) from exc
    for line in ignored:
        print(f"note: {line}")
    agents = [x for x in loaded.ir.get("agents") or [] if x.get("kind") != "mock"]
    for tier in known:
        row = {"model": "?", "source": "no agent states a model"}
        for agent in agents:
            resolved = models.resolve_tiers(loaded, str(agent.get("id")), over)
            if tier in resolved:
                row = resolved[tier]
                break
        else:
            if tier in (over.get("models") or {}):
                row = {"model": over["models"][tier], "source": over["models_from"][tier]}
        print(f"{tier:<8} {row['model']:<20} ({row['source']})")
    print(f"settings: {layer / models.SETTINGS_FILE} (local to this machine, never committed); "
          "applies to runs started from now on")
    return 0


