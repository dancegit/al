    @property
    def dash(self) -> dict:
        """The (dashboard …) option; an IR compiled before dashboards existed gets the default."""
        return self.ir.get("dashboard") or DEFAULT_DASHBOARD

    def run_prefix(self) -> str:
        return f"{self.ir['layer']['dir']}/" if self.in_repo else ""

    def dashboard_url(self) -> str:
        return dashboard_url_of(self.dash)

    def dashboard(self) -> None:
        """adws/dashboard/ (the kit's dashboard: server and page, plus the container recipe for
        `podman`), the launcher adws/dashboard.py with this layer's settings, and with #:systemd a
        user unit. All but the unit are identical on every machine."""
        d = self.dash
        if d["kind"] == "none":
            return
        files = DASHBOARD_FILES + (DASHBOARD_PODMAN_FILES if d["kind"] == "podman" else ())
        for rel in files:
            src = DASHBOARD_KIT / rel
            self.write(f"adws/dashboard/{rel}", src.read_text(), 0o755 if os.access(src, os.X_OK) else 0o644)
        parts = [f"(dashboard {d['kind']}", f"#:port {d['port']}"]
        if d["bind"] != "127.0.0.1":
            parts.append(f"#:bind {json.dumps(d['bind'])}")
        if d["also"]:
            parts.append("#:also (" + " ".join(json.dumps(x) for x in d["also"]) + ")")
        if d["pollMs"] != 750:
            parts.append(f"#:poll-ms {d['pollMs']}")
        if d["tokenEnv"]:
            parts.append(f"#:token-env {json.dumps(d['tokenEnv'])}")
        if d.get("podmanSocket"):
            parts.append("#:podman-socket #t")
        if d["systemd"]:
            parts.append("#:systemd #t")
        clause = " ".join(parts) + ")"
        header = "#!/usr/bin/env -S uv run --quiet --script\n# /// script\n# requires-python = \">=3.11\"\n# dependencies = []\n# ///\n"
        self.write("adws/dashboard.py", header + DASHBOARD_LAUNCHER.format(
            name=self.ir["name"], run_prefix=self.run_prefix(), url=self.dashboard_url(), clause=clause,
            kind=d["kind"], port=int(d["port"]), bind=str(d["bind"]), poll=round(int(d["pollMs"]) / 1000, 3),
            also=list(d["also"]), token_env=str(d["tokenEnv"]), podman_socket=bool(d.get("podmanSocket"))), 0o755)
        if d["systemd"]:
            name = self.ir["name"]
            self.write(f"systemd/al-{name}-dashboard.service", systemd_unit("dashboard", name, self.layer, self.ir), local=True)
        if (self.ir.get("standIn") or {}).get("systemd"):   # the compiler made sure the dashboard is local
            name = self.ir["name"]
            self.write(f"systemd/al-{name}-stand-in.service", systemd_unit("stand-in", name, self.layer, self.ir), local=True)

    def models_section(self, run_prefix: str) -> str:
        """Model tiers, how to override them for one run, and the spending limits."""
        lines = ["## Models and spending", ""]
        for agent in self.ir["agents"]:
            tiers = agent.get("models")
            if tiers is None:
                lines.append(f"- Agent `{agent['id']}` ({agent['kind']}): takes any tier, runs no model.")
                continue
            shown = ", ".join(f"`{t['tier']}` = `{t['model'] or '(the CLI default)'}`"
                              + (f" (effort {t['effort']})" if t.get("effort", "default") != "default" else "")
                              for t in tiers)
            lines.append(f"- Agent `{agent['id']}` ({agent['kind']}): {shown}.")
        adw = self.ir["adws"][0]["name"]
        lines += ["",
                  "Every command and hop runs on a tier (its `#:model-set`); a run step may name its own. For one run,",
                  "without changing `agentic.rkt`:", "",
                  "```bash",
                  f"uv run {run_prefix}adws/adw_{adw}.py \"…\" --model-set heavy               # every agent step on one tier",
                  f"uv run {run_prefix}adws/adw_{adw}.py \"…\" --model heavy=MODEL_ID          # another model for a tier (repeatable)",
                  f"uv run {run_prefix}adws/adw_{adw}.py \"…\" --max-cost 3                    # hand over once the run costs more than $3",
                  "```", "",
                  "The same as environment variables, which the triggers and `al improve` pass on: `AL_MODEL_SET=TIER`,",
                  "`AL_MODELS=\"heavy=…,base=…\"`, `AL_MAX_COST=USD`. Flags win. A task-file tag (`{heavy}`) or an issue",
                  "keyword (`adw: <workflow> heavy`) naming any declared tier selects it for the steps that do not set their",
                  "own. Which tier wins: `--model-set`, then the step's own `#:model-set`, then the request's tier, then the",
                  "command's; `--model` then picks that tier's model id. `state.json` (`agent_calls`) and the run's events",
                  "record the tier, model and reason of every agent call; `--help` of any workflow script says the same.", ""]
        b = self.ir.get("budget")
        if isinstance(b, dict):
            parts = [f"{label} ${b[key]:g}" for key, label in (("runUsd", "per run"), ("stepUsd", "per agent call"),
                                                                ("dayUsd", "per day in this layer")) if b.get(key) is not None]
            lines.append("Spending limits (`budget limits`): " + (", ".join(parts) or "none") + ". A run that goes over is "
                         "stopped after the agent call that crossed the limit and handed to a person (`budget:<limit>` "
                         "is the reason); once the day's limit is reached no run or agent step starts (exit code 3). "
                         "Costs are what the agents report; codex and custom agents report none and count as $0.")
        else:
            lines.append("Spending limits: none declared (add `(budget limits #:run-usd … #:day-usd …)`); `--max-cost` "
                         "still limits one run.")
        return "\n".join(lines) + "\n"

    def watch_section(self) -> str:
        d = self.dash
        if d["kind"] == "none":
            return ("## Watch the work\n\nNo dashboard: `(dashboard none)` in `agentic.rkt`. `al dashboard <this directory>` "
                    "still shows the runs on demand.\n")
        cmd = f"uv run {self.run_prefix()}adws/dashboard.py"
        lines = [f"## Watch the work\n\nA live dashboard of every run of this layer"
                 + (f" and of {', '.join('`' + x + '`' for x in d['also'])}" if d["also"] else "")
                 + (", in its own locked-down podman container" if d["kind"] == "podman" else "")
                 + (" (it only watches there: starting work is off in the container)" if d["kind"] == "podman"
                    else "; work can be started from its Layers view, or with `al run <this directory> /NAME …`")
                 + ":\n",
                 "```bash", f"{cmd}                 # then open {self.dashboard_url()}",
                 f"{cmd} --port 9000 --open   # flags override the declared ones", "```", ""]
        if d["kind"] == "podman":
