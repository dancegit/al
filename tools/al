    def ignore_lists(self) -> tuple[str, str]:
        ignored = ("run state (worktrees, run logs, artefacts, plans, run documents, the task list and spec inbox, "
                   "`al improve` runs), files that name this machine's paths (`bin/al`, systemd units, the Home Manager "
                   "module" + ("" if self.in_repo else ", the forge workflow") + ") and caches")
        committed = ("`agentic.rkt`, `LLM.txt`, `templates/`, `mock/`, `adopted/` (what `al adopt` wrote), expert `expertise.yaml` files and "
                     "`conditional_docs.md` (source); `agentic-layer.json`, `commands/`, `hops/`, `experts/`, `adws/`, "
                     "`env/`, `fabric/`, " + ("`forge/`, " if self.in_repo else "") +
                     "`AL-DSL.llms.txt`, this README, `.gitignore` and `.al-manifest.json` (generated; the manifest "
                     "lets `al gen` notice hand edits)")
        return ignored, committed

    def protection_note(self) -> str:
        if not self.in_repo:
            return ""
        d = self.ir["layer"]["dir"]
        return (f"\nAn ordinary workflow that changes anything under `{d}/` in its worktree is stopped at the gate with a\n"
                f"`protected-path:` reason and goes to a person: only a workflow with `#:changes layer` (the one\n"
                f"`al improve` runs) may change the layer.\n")

    def gitignore(self) -> str:
        ir = self.ir
        state = {"trees", "agents", "artefacts", "specs", "docs", IMPROVE_DIR}
        state |= {str(o.get("dir") or "trees") for o in ir["environments"] if o["kind"] == "worktree"}
        storage = ir["storage"] or {}
        state.add(str(storage.get("localDir") or storage.get("dir") or "artefacts"))
        queues = sorted({str(o["path"]) for o in ir["promptInputs"] if o["kind"] == "tasklist"}
                        | {str(o["dir"]) for o in ir["promptInputs"] if o["kind"] == "spec-file"
                           and not str(o["dir"]).split("/")[0] in state})
        local = sorted(rel for rel, (_c, _m, _k, is_local) in self.outputs.items() if is_local)
        lines = ["# Written by `al gen`. Run state, work queues and machine-specific files: never source.",
                 "# The definition, the layer-local templates and the generated files are committed.",
                 "# run state", *[f"/{d.strip('/')}/" for d in sorted(state)],
                 "# work queues of whoever runs the layer", *[f"/{q.strip('/')}" for q in queues],
                 "# generated with this machine's paths; `al gen` writes them on every machine",
                 *[f"/{rel}" for rel in local], f"/{LOCAL_MANIFEST}",
                 "# caches and lock files", "__pycache__/", "*.pyc", "*.lock", ".cache/", ".*_cache/"]
        return "\n".join(lines) + "\n"

    def check_placement(self) -> None:
        app = app_root_of(self.layer, self.ir)
        here = self.layer.resolve()
        if self.in_repo:
            expected = (app / self.ir["layer"]["dir"]).resolve()
            if here != expected:
                raise AlError(f"(layer in-repo #:dir \"{self.ir['layer']['dir']}\") puts the layer at {expected}, but its "
                              f"agentic.rkt is in {here}: move the layer, or fix #:dir and (codebase #:root …)")
            if not (app / ".git").exists():
                raise AlError(f"an in-repo layer lives in a git repository, but {app} (the codebase root) is not one")
        elif here == app or app in here.parents:
            raise AlError(f"the layer ({self.layer}) must not live inside the application tree ({app}); "
                          "to check the layer in with the application, declare (layer in-repo #:dir \"agentic\")")

    def hand_edits(self, old: dict[str, str | None]) -> list[str]:
        """Generated files whose content is neither what the last `al gen` wrote nor what this one
        would write: regenerating would lose a hand edit. Unknown hashes (al 0.1) never count."""
        edited = []
        for rel, recorded in sorted(old.items()):
            path = self.layer / rel
            if not recorded or not path.is_file():
                continue
            actual = sha256_file(path)
            if actual == recorded:
                continue
            new = self.outputs.get(rel)
            if new is not None and not new[2] and sha256_text(new[0]) == actual:
                continue
            edited.append(rel)
        return edited

    def hand_edit_message(self, edited: list[str]) -> str:
        templates = {f"commands/{c['name']}.md": f"templates/commands/{c['template']}.md"
                     for c in self.ir["commands"] if c["template"] != "custom"}
        templates |= {f"hops/{h['name']}.md": f"templates/hops/{h['template']}.md" for h in self.ir["hops"]}
        width = max(len(rel) for rel in edited)
        rows = []
        for rel in edited:
            hint = eject_hint(self.layer, rel)
            if rel in templates:
                hint += f"   (copies its template to {templates[rel]})"
            rows.append(f"  {rel.ljust(width)}   {hint}")
        return (f"{len(edited)} generated file(s) in {self.layer} were edited by hand since the last `al gen`.\n"
                "Generating now would overwrite those edits, so nothing was written:\n\n" + "\n".join(rows) + "\n\n"
                "Two ways forward:\n"
                "  1. Keep the change: make it in a layer-local template, which every `al gen` uses from then on.\n"
                "     Run the `al eject` command shown above, make your edit in the copy under templates/ (keep its\n"
                "     {{placeholders}}), then run `al gen` again. A one-line instruction is simpler as a #:focus line\n"
                "     on the command in agentic.rkt. Files with no template come from agentic.rkt: change that.\n"
                f"  2. Throw the edit away:  al gen {self.layer} --discard-edits")

    def generate(self, discard_edits: bool = False) -> list[str]:
        planned = [f"{k}:{o['id']}" for k in ("promptInputs", "triggers", "environments", "reviews", "agents", "artefacts")
                   for o in self.ir[k] if o["status"] == "planned"]
        planned += [f"{k}:{self.ir[k]['kind']}" for k in ("forge", "storage", "layer") if self.ir[k]["status"] == "planned"]
        if planned:
            raise AlError("these options are declared `planned` in the vocabulary and have no runtime yet: " + ", ".join(planned))
        self.check_placement()
        self.write("agentic-layer.json", json.dumps(self.ir, indent=2, sort_keys=True) + "\n")
        self.commands()
        self.experts()
        self.adws()
        self.environments()
        self.triggers_and_forge()
        self.dashboard()
        self.scaffolding()
        old = load_manifest(self.layer)
        edited = self.hand_edits(old)
        if edited and not discard_edits:
            raise HandEditError(self.hand_edit_message(edited), edited)
        self.flush(old)
        if self.ir["layer"].get("git") and not (self.layer / ".git").exists():
            run(["git", "init", "-q", "-b", "main", str(self.layer)], check=False)
        return self.written

    def flush(self, old: dict[str, str | None]) -> None:
        """Write what differs from the disk, remove files the definition no longer produces, and
        record a sha256 per generated file. Identical content is not rewritten, so a second
        `al gen` changes nothing (self.changed is empty)."""
        changed: list[str] = []
        self.scaffolded = []
        for rel, (content, mode, keep, _local) in sorted(self.outputs.items()):
            path = self.layer / rel
            if keep and path.exists():
                continue
            if keep:  # scaffolding written once (task list, expertise seed, .gitkeep): yours from now on
                path.parent.mkdir(parents=True, exist_ok=True)
                path.write_text(content, encoding="utf-8")
                path.chmod(mode)
                self.scaffolded.append(rel)
                continue
            if path.is_file() and not path.is_symlink() and path.read_bytes() == content.encode("utf-8"):
                if path.stat().st_mode & 0o777 != mode:
                    path.chmod(mode)
                    changed.append(rel)
                continue
            path.parent.mkdir(parents=True, exist_ok=True)
            if path.is_symlink():
                path.unlink()
            path.write_text(content, encoding="utf-8")
            path.chmod(mode)
            changed.append(rel)
        for stale in sorted(set(old) - set(self.written)):
            if (self.layer / stale).is_file():
                (self.layer / stale).unlink()
                changed.append(stale)
        for name, local in ((MANIFEST, False), (LOCAL_MANIFEST, True)):
            files = {rel: sha256_text(content) for rel, (content, _m, keep, is_local) in sorted(self.outputs.items())
                     if not keep and is_local == local}
            text = json.dumps({"generator": GENERATOR, "files": files}, indent=1) + "\n"
            path = self.layer / name
            if not path.is_file() or path.read_text() != text:
                path.write_text(text)
                changed.append(name)
        self.changed = changed


