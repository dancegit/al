# cli
# ------------------------------------------------------------------------------------------

def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(prog="al", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("init"); p.add_argument("app", type=Path); p.add_argument("--layer", type=Path)
    p = sub.add_parser("scout"); p.add_argument("app", type=Path); p.add_argument("-o", "--out", type=Path); p.add_argument("--json", action="store_true")
    for name in ("compile", "gen", "check"):
        p = sub.add_parser(name); p.add_argument("layer", type=Path)
    a = ap.parse_args(argv)
    try:
        if a.cmd == "scout":
            facts = scout(a.app)
            text = json.dumps(facts, indent=2) if a.json else render_llm_txt(facts)
            a.out.write_text(text) if a.out else print(text)
        elif a.cmd == "init":
            app = a.app.resolve()
            layer = (a.layer or app.with_name(app.name + ".al")).resolve()
            if layer == app or app in layer.parents:
                raise AlError("the layer must not live inside the application tree")
            layer.mkdir(parents=True, exist_ok=True)
            if not (layer / "LLM.txt").exists():
                (layer / "LLM.txt").write_text(render_llm_txt(scout(app)))
            shutil.copy(REFERENCE, layer / "AL-DSL.llms.txt")
            print(f"layer: {layer}\n  LLM.txt          draft — complete it with meta/commands/scout-codebase.md\n"
                  f"  AL-DSL.llms.txt  language reference\nnext: author {layer}/agentic.rkt (meta/commands/author-layer.md), then `al gen {layer}`\n"
                  f"codebase root to use in agentic.rkt: {os.path.relpath(app, layer)}")
        elif a.cmd == "compile":
            ir = compile_layer(a.layer.resolve())
            print(json.dumps(ir, indent=2, sort_keys=True))
        elif a.cmd == "gen":
            layer = a.layer.resolve()
            written = Generator(layer, compile_layer(layer)).generate()
            print(f"generated {len(written)} files in {layer}")
        elif a.cmd == "check":
            problems = check_layer(a.layer.resolve())
            for pr in problems:
                print(f"PROBLEM: {pr}")
            print("check: " + ("FAILED" if problems else "ok"))
            return 1 if problems else 0
    except AlError as e:
        print(f"al: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
