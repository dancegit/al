            for a in ir["adws"])
        if self.in_repo:
            where = (f"This directory is the agentic layer of the repository it sits in (`{ir['layer']['dir']}/`, placement "
                     f"`in-repo`) and is committed with the code. It changes how agents work on that repository; it is "
                     f"not application code, and ordinary runs may not change it (see below).")
            gen_cmd, run_prefix = f"al gen {ir['layer']['dir']}", f"{ir['layer']['dir']}/"
        else:
            where = (f"This directory wraps the application at `{self.cb['root']}`; it is not part of it.")
            gen_cmd, run_prefix = "al gen <this directory>", ""
        ignored, committed = self.ignore_lists()
        self.write("README.md", f"""# Agentic layer — {ir['name']}

{ir['description']}

Generated by `al gen` from `agentic.rkt` (derived from `{ir['llmTxt']}`). {where} Agents work in
