def systemd_unit(kind: str, name: str, layer: Path | str, ir: dict, *, header: str | None = None,
                 path_env: str = "", env_file: str = "", extra_args: str = "") -> str:
    """The text of one systemd user unit (kind: cron | webhook | dashboard) that keeps a part of the
    layer at `layer` running, built from unit_spec(). The one source of unit text: `al gen` calls it
    with the defaults (the unit names this machine's paths, so it is never committed), `al deploy`
    with the paths of the host it deploys to (header, the host's login PATH, an EnvironmentFile for
    secrets, extra arguments for ExecStart) and writes the result only on that host."""
    spec = unit_spec(kind, name, ir)
    first = header if header is not None else (
        f"# Generated by al. Install: cp to ~/.config/systemd/user/ && systemctl --user enable --now al-{name}-{kind}")
    service = (f"Environment=PATH={path_env}\n" if path_env else "") + (f"EnvironmentFile=-{env_file}\n" if env_file else "")
    args = f" {extra_args}" if extra_args else ""
    restart_sec = f"RestartSec={spec['restart_sec']}\n" if spec["restart_sec"] else ""
    return f"""{first}
[Unit]
Description={spec['description']}

[Service]
{service}ExecStart=/usr/bin/env uv run {layer}/{spec['script']}{args}
{spec['env_file']}Restart={spec['restart']}
{restart_sec}
[Install]
WantedBy=default.target
"""


