        elif d["tokenEnv"]:
            lines.append(f"Every request needs the token in `${d['tokenEnv']}` (open the page once with `?token=…`).\n")
        if d["systemd"]:
            lines.append(f"A user unit keeps it running: `systemd/al-{self.ir['name']}-dashboard.service` (install line at its top).\n")
        return "\n".join(lines).rstrip("\n") + "\n"

    def notify_section(self) -> str:
        """The README's section on notifications; empty when the layer declares no notifier."""
        declared = [n for n in self.ir.get("notifiers") or [] if n["kind"] != "none"]
        if not declared:
            return ""
        rows = []
        for n in declared:
            if n["kind"] == "email":
                variables = (f"`{n['toEnv']}` (recipient), `{n['fromEnv']}` (sender), `{n['smtpUrlEnv']}` (SMTP URL)")
            else:
                variables = "whatever `" + str(n["run"]).replace("|", "\\|") + "` refers to"
            rows.append(f"| `{n['id']}` | {n['kind']} | {', '.join(n['events'])} | {variables} |")
        where = self.ir["layer"]["dir"] if self.in_repo else "<this directory>"
        return "\n".join([
            "## Notifications", "",
            "This layer tells a person when a run ends or needs them. Nothing private is in the layer: the values",
            "of the variables below come from the environment, from `local.env` in this directory (ignored by git;",
            f"`al check` fails if it is ever tracked) or from `~/.config/al/{self.ir['name']}.env`. The environment wins.", "",
            "| Notifier | Kind | Reports | Variables |", "|---|---|---|---|", *rows, "",
            "`AL_DASHBOARD_URL` (optional) adds a link to the dashboard to every message.",
            f"Check the setup without running a workflow: `al notify-test {where}`.", "", ""])

    def scaffolding(self) -> None:
        ir = self.ir
        for pi in ir["promptInputs"]:
            if pi["kind"] == "tasklist":
                first = ir["adws"][0]["name"]
                self.write(pi["path"], f"""# Tasks — {ir['name']}

<!-- One `## section` per unit of work (it names the worktree/branch). One line per task.
     {pi['openMarker']} open · {pi['runningMarker']} running · {pi['doneMarker']} done · {pi['failedMarker']} failed · {pi['blockedMarker']} waits for the tasks above it
     Tags at the end of a line pick the workflow, model set and class, e.g. {{{first}, heavy, class: bug}} -->
""", keep_existing=True)
            if pi["kind"] == "spec-file":
                self.write(f"{pi['dir']}/.gitkeep", "")
        for rel in ("specs/.gitkeep", "mock/.gitkeep", "docs/.gitkeep"):
            self.write(rel, "", keep_existing=True)
        self.write("templates/README.md", TEMPLATES_README, keep_existing=True)
        # generated from the (conditional-doc …) clauses: a run that edits it is a hand edit `al check` reports
        self.write("conditional_docs.md", "# Conditional documentation\n\nRead a document below before working when its condition holds.\n"
                   + CONDITIONAL_DOCS_SOURCE + "\n"
                   + bullets([f"`{d['path']}` — {d['when']}" for d in self.cb["conditionalDocs"]]) + "\n")
        self.write("bin/al", f"#!/bin/sh\n# Generated by al: the layer's handle on the generator and compiler.\nexec {ROOT / 'tools' / 'al'} \"$@\"\n",
                   0o755, local=True)
        self.write("AL-DSL.llms.txt", REFERENCE.read_text())
        by_id = lambda key: {o["id"]: o for o in ir[key]}  # noqa: E731
        pi, tr, en, rv = by_id("promptInputs"), by_id("triggers"), by_id("environments"), by_id("reviews")
        rows = "\n".join(
            f"| `{a['name']}` | {', '.join(pi[i]['kind'] for i in a['input'])} | {', '.join(tr[i]['kind'] for i in a['trigger'])} | "
            f"{' → '.join(en[i]['kind'] for i in a['environment'])} | "
            f"{' | '.join(runs_in(a, en))} | {rv[a['review']]['kind']}"
            f"{' → ' + rv[a['review']]['ship'] if rv[a['review']]['kind'] == 'auto' else ''} | {' → '.join(s['name'] for s in a['steps'])} |"
            for a in ir["adws"])
        if self.in_repo:
            where = (f"This directory is the agentic layer of the repository it sits in (`{ir['layer']['dir']}/`, placement "
                     f"`in-repo`) and is committed with the code. It changes how agents work on that repository; it is "
                     f"not application code, and ordinary runs may not change it (see below).")
            gen_cmd, run_prefix = f"al gen {ir['layer']['dir']}", f"{ir['layer']['dir']}/"
        else:
            where = (f"This directory wraps the application at `{self.cb['root']}`; it is not part of it.")
            gen_cmd, run_prefix = "al gen <this directory>", ""
        ignored, committed = self.ignore_lists()
        self.write("README.md", f"""# Agentic layer — {ir['name']}

{ir['description']}

Generated by `al gen` from `agentic.rkt` (derived from `{ir['llmTxt']}`). {where} Agents work in
git worktrees under `trees/`, plans land in `specs/`, run state and logs in `agents/<adw-id>/`, proof in
`artefacts/<adw-id>/`.

## Workflows

| ADW | Prompt input | Trigger | Environment | Agent runs in | Checks run in | Review | Steps |
|---|---|---|---|---|---|---|---|
{rows}

## Run

```bash
uv run {run_prefix}adws/adw_{ir['adws'][0]['name']}.py "your high-level prompt"          # manual trigger
uv run {run_prefix}adws/adw_{ir['adws'][0]['name']}.py "…" --dry-run                     # mock agent, no LLM
uv run {run_prefix}adws/dispatch.py --source tasklist:<line>                             # from a prompt input
```

{self.models_section(run_prefix)}
{self.watch_section()}
{self.notify_section()}## Change the layer

The layer has two kinds of source: `agentic.rkt` (language reference: `AL-DSL.llms.txt`) and the
layer-local templates under `templates/`. Everything else here is generated by `{gen_cmd}`.

- A short, permanent instruction for one prompt: a `#:focus` line on that command in `agentic.rkt`.
- A bigger change to a prompt: `al eject <layer> command NAME` copies the kit template it uses into
  `templates/commands/`; edit the copy there (its `{{{{placeholders}}}}` stay). `al eject <layer> --list`
  shows which templates are yours and whether the kit has changed since.
- A reviewed change, made by al's own workflow and ending in a pull request:
  `al improve <layer> "what to change, in plain words"`.
- Never edit a generated file. `al gen` notices a hand edit, writes nothing, and says how to keep it
  (`al eject …`) or drop it (`al gen <layer> --discard-edits`).
{self.protection_note()}
## What is committed

Committed: {committed}.

Not committed (`.gitignore`, written by `al gen`): {ignored}.
""")
        self.write(".gitignore", self.gitignore())

    def ignore_lists(self) -> tuple[str, str]:
        ignored = ("run state (worktrees, run logs, artefacts, plans, run documents, the task list and spec inbox, "
                   "`al improve` runs), files that name this machine's paths (`bin/al`, systemd units, the Home Manager "
                   "module" + ("" if self.in_repo else ", the forge workflow") + "), private values (`local.env`) and caches")
        committed = ("`agentic.rkt`, `LLM.txt`, `templates/`, `mock/`, `adopted/` (what `al adopt` wrote), and expert `expertise.yaml` files "
                     "(source); `promotions/` (acceptance and sign-off records); `agentic-layer.json`, `conditional_docs.md`, `commands/`, `hops/`, `experts/`, `adws/`, "
                     "`env/`, `fabric/`, " + ("`forge/`, " if self.in_repo else "") +
                     "`AL-DSL.llms.txt`, this README, `.gitignore` and `.al-manifest.json` (generated; the manifest "
                     "lets `al gen` notice hand edits)")
        return ignored, committed

    def protection_note(self) -> str:
        if not self.in_repo:
            return ""
        d = self.ir["layer"]["dir"]
        return (f"\nAn ordinary workflow that changes anything under `{d}/` in its worktree is stopped at the gate with a\n"
                f"`protected-path:` reason and goes to a person: only a workflow with `#:changes layer` (the one\n"
                f"`al improve` runs) may change the layer.\n")

    def gitignore(self) -> str:
        ir = self.ir
        state = {"trees", "agents", "artefacts", "specs", "docs", IMPROVE_DIR}
        state |= {str(o.get("dir") or "trees") for o in ir["environments"] if o["kind"] == "worktree"}
        storage = ir["storage"] or {}
        state.add(str(storage.get("localDir") or storage.get("dir") or "artefacts"))
        queues = sorted({str(o["path"]) for o in ir["promptInputs"] if o["kind"] == "tasklist"}
                        | {str(o["dir"]) for o in ir["promptInputs"] if o["kind"] == "spec-file"
                           and not str(o["dir"]).split("/")[0] in state})
        local = sorted(rel for rel, (_c, _m, _k, is_local) in self.outputs.items() if is_local)
        lines = ["# Written by `al gen`. Run state, work queues and machine-specific files: never source.",
                 "# The definition, the layer-local templates and the generated files are committed.",
                 "# run state", *[f"/{d.strip('/')}/" for d in sorted(state)],
                 "# work queues of whoever runs the layer", *[f"/{q.strip('/')}" for q in queues],
                 "# private values of whoever runs the layer (addresses, servers, passwords): never committed", "/local.env",
                 "# generated with this machine's paths; `al gen` writes them on every machine",
                 *[f"/{rel}" for rel in local], f"/{LOCAL_MANIFEST}",
                 "# caches and lock files", "__pycache__/", "*.pyc", "*.lock", ".cache/", ".*_cache/"]
        return "\n".join(lines) + "\n"

    def check_placement(self) -> None:
        app = app_root_of(self.layer, self.ir)
        here = self.layer.resolve()
        if self.in_repo:
            expected = (app / self.ir["layer"]["dir"]).resolve()
            if here != expected:
                raise AlError(f"(layer in-repo #:dir \"{self.ir['layer']['dir']}\") puts the layer at {expected}, but its "
                              f"agentic.rkt is in {here}: move the layer, or fix #:dir and (codebase #:root …)")
            if not (app / ".git").exists():
                raise AlError(f"an in-repo layer lives in a git repository, but {app} (the codebase root) is not one")
        elif here == app or app in here.parents:
            raise AlError(f"the layer ({self.layer}) must not live inside the application tree ({app}); "
                          "to check the layer in with the application, declare (layer in-repo #:dir \"agentic\")")

    def hand_edits(self, old: dict[str, str | None]) -> list[str]:
        """Generated files whose content is neither what the last `al gen` wrote nor what this one
        would write: regenerating would lose a hand edit. Unknown hashes (al 0.1) never count."""
        edited = []
        for rel, recorded in sorted(old.items()):
            path = self.layer / rel
            if not recorded or not path.is_file():
                continue
            actual = sha256_file(path)
            if actual == recorded:
                continue
            new = self.outputs.get(rel)
            if new is not None and not new[2] and sha256_text(new[0]) == actual:
                continue
            edited.append(rel)
        for rel, unchanged in FORMERLY_SCAFFOLDED.items():  # written once by older versions: maybe extended by hand
            path, new = self.layer / rel, self.outputs.get(rel)
            if rel in old or new is None or not path.is_file():
                continue
            if sha256_file(path) not in (sha256_text(new[0]), sha256_text(unchanged(new[0]))):
                edited.append(rel)
        return edited

    def hand_edit_message(self, edited: list[str]) -> str:
        templates = {f"commands/{c['name']}.md": f"templates/commands/{c['template']}.md"
                     for c in self.ir["commands"] if c["template"] != "custom"}
        templates |= {f"hops/{h['name']}.md": f"templates/hops/{h['template']}.md" for h in self.ir["hops"]}
        width = max(len(rel) for rel in edited)
        rows = []
        for rel in edited:
            hint = eject_hint(self.layer, rel)
            if rel in templates:
                hint += f"   (copies its template to {templates[rel]})"
            rows.append(f"  {rel.ljust(width)}   {hint}")
        return (f"{len(edited)} generated file(s) in {self.layer} were edited by hand since the last `al gen`.\n"
                "Generating now would overwrite those edits, so nothing was written:\n\n" + "\n".join(rows) + "\n\n"
                "Two ways forward:\n"
                "  1. Keep the change: make it in a layer-local template, which every `al gen` uses from then on.\n"
                "     Run the `al eject` command shown above, make your edit in the copy under templates/ (keep its\n"
                "     {{placeholders}}), then run `al gen` again. A one-line instruction is simpler as a #:focus line\n"
                "     on the command in agentic.rkt. Files with no template come from agentic.rkt: change that.\n"
                f"  2. Throw the edit away:  al gen {self.layer} --discard-edits")

    def generate(self, discard_edits: bool = False) -> list[str]:
        planned = [f"{k}:{o['id']}" for k in ("promptInputs", "triggers", "environments", "reviews", "agents", "artefacts")
                   for o in self.ir[k] if o["status"] == "planned"]
        planned += [f"{k}:{self.ir[k]['kind']}" for k in ("forge", "storage", "layer") if self.ir[k]["status"] == "planned"]
        if planned:
            raise AlError("these options are declared `planned` in the vocabulary and have no runtime yet: " + ", ".join(planned))
        self.check_placement()
        self.write("agentic-layer.json", json.dumps(self.ir, indent=2, sort_keys=True) + "\n")
        self.commands()
        self.experts()
        self.adws()
        self.environments()
        self.hosts()
        self.triggers_and_forge()
        self.dashboard()
        self.scaffolding()
        old = load_manifest(self.layer)
        edited = self.hand_edits(old)
        if edited and not discard_edits:
            raise HandEditError(self.hand_edit_message(edited), edited)
        self.flush(old)
        if self.ir["layer"].get("git") and not (self.layer / ".git").exists():
            run(["git", "init", "-q", "-b", "main", str(self.layer)], check=False)
        return self.written

    def flush(self, old: dict[str, str | None]) -> None:
        """Write what differs from the disk, remove files the definition no longer produces, and
        record a sha256 per generated file. Identical content is not rewritten, so a second
        `al gen` changes nothing (self.changed is empty)."""
        changed: list[str] = []
        self.scaffolded = []
        for rel, (content, mode, keep, _local) in sorted(self.outputs.items()):
            path = self.layer / rel
            if keep and path.exists():
                continue
            if keep:  # scaffolding written once (task list, expertise seed, .gitkeep): yours from now on
                path.parent.mkdir(parents=True, exist_ok=True)
                path.write_text(content, encoding="utf-8")
                path.chmod(mode)
                self.scaffolded.append(rel)
                continue
            if path.is_file() and not path.is_symlink() and path.read_bytes() == content.encode("utf-8"):
                if path.stat().st_mode & 0o777 != mode:
                    path.chmod(mode)
                    changed.append(rel)
                continue
            path.parent.mkdir(parents=True, exist_ok=True)
            if path.is_symlink():
                path.unlink()
            path.write_text(content, encoding="utf-8")
            path.chmod(mode)
            changed.append(rel)
        for stale in sorted(set(old) - set(self.written)):
            if (self.layer / stale).is_file():
                (self.layer / stale).unlink()
                changed.append(stale)
        for name, local in ((MANIFEST, False), (LOCAL_MANIFEST, True)):
            files = {rel: sha256_text(content) for rel, (content, _m, keep, is_local) in sorted(self.outputs.items())
                     if not keep and is_local == local}
            text = json.dumps({"generator": GENERATOR, "files": files}, indent=1) + "\n"
            path = self.layer / name
            if not path.is_file() or path.read_text() != text:
                path.write_text(text)
                changed.append(name)
        self.changed = changed


