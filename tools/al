def improve_main(a: argparse.Namespace) -> int:
    """`al improve` lives in tools/al_improve.py; it uses this module's compiler and generator."""
    sys.path.insert(0, str(ROOT / "tools"))
    import al_improve
    return al_improve.main(a, sys.modules[__name__])


def init_in_repo(app: Path, directory: str, layer_arg: Path | None) -> None:
    if layer_arg:
        raise AlError("--layer and --in-repo exclude each other: an in-repo layer is <repository>/<--dir>")
    top = git(app, "rev-parse", "--show-toplevel")
    if not top or Path(top).resolve() != app:
        raise AlError(f"{app} is not the top directory of a git repository")
    parts = [x for x in directory.split("/") if x not in ("", ".")]
    if not parts or ".." in parts or directory.startswith("/"):
        raise AlError(f"--dir must be a relative directory inside the repository without `..` (got {directory!r})")
    rel = "/".join(parts)
    layer = app / rel
    layer.mkdir(parents=True, exist_ok=True)
    if not (layer / "LLM.txt").exists():
        (layer / "LLM.txt").write_text(render_llm_txt(scout(app)))
    shutil.copy(REFERENCE, layer / "AL-DSL.llms.txt")
    if not (layer / ".gitignore").exists():  # `al gen` replaces it with the full list
        (layer / ".gitignore").write_text(f"/trees/\n/agents/\n/artefacts/\n/specs/\n/docs/\n/{IMPROVE_DIR}/\n/tasks.md\n__pycache__/\n*.lock\n")
    up = "/".join([".."] * len(parts))
    print(f"layer: {layer}   (in-repo: committed with the application)\n"
          f"  LLM.txt          draft — complete it with meta/commands/scout-codebase.md\n"
          f"  AL-DSL.llms.txt  language reference\n"
          f"next: author {rel}/agentic.rkt (meta/commands/author-layer.md) with\n"
          f"        (codebase #:root \"{up}\" …)\n        (layer in-repo #:dir \"{rel}\")\n"
          f"      then `al gen {layer}` and commit the directory: git add {rel} && git commit")


def dashboard_command(a: argparse.Namespace) -> tuple[list[str], dict[str, str]]:
    """The kit's dashboard over the given layers and directories (no layer needs to declare one)."""
    dirs = [d.resolve() for d in (a.dirs or [Path(".")])]
    for d in dirs:
        if not d.is_dir():
            raise AlError(f"not a directory: {d}")
    env = dict(os.environ)
    if a.podman:
        if a.bind or a.token or a.open:
            raise AlError("--podman publishes on 127.0.0.1 with its own token; --bind, --token and --open do not apply")
        return [str(DASHBOARD_KIT / "run-in-podman.sh"), "--port", str(a.port), *map(str, dirs)], env
    argv = [sys.executable, str(DASHBOARD_KIT / "dashboard.py"), "--port", str(a.port)]
    for d in dirs:
        argv += ["--layer" if (d / "agentic-layer.json").is_file() else "--scan", str(d)]
    argv += ["--bind", a.bind] if a.bind else []
    argv += ["--open"] if a.open else []
    if a.token:
        env["AL_DASHBOARD_TOKEN"] = a.token   # not on argv, where `ps` would show it
    return argv, env


def dashboard_cli(a: argparse.Namespace) -> int:
    argv, env = dashboard_command(a)
    if os.environ.get("AL_DASHBOARD_DRY_RUN"):
        print(json.dumps({"argv": argv, "token": bool(env.get("AL_DASHBOARD_TOKEN"))}))
        return 0
    try:
        return subprocess.call(argv, env=env)
    except KeyboardInterrupt:
        return 130


def eject_cli(a: argparse.Namespace) -> int:
    layer = a.layer.resolve()
    if a.list:
        rows = template_rows(layer, compile_layer(layer))
        width = max([len(f"{r['kind']}/{r['template']}") for r in rows] + [8])
        print(f"{'template'.ljust(width)}  from   used by / status")
        for r in rows:
            print(f"{(r['kind'] + '/' + r['template']).ljust(width)}  {r['from'].ljust(5)}  "
                  f"{', '.join(r['used_by']) or '-'}  [{r['status']}]")
            if r["from"] == "layer" and r["differs"] and (KIT / "templates" / r["kind"] / r["template"]).is_file():
                print(f"{''.ljust(width)}         compare: diff -u {KIT / 'templates' / r['kind'] / r['template']} {r['path']}")
        return 0
    if not a.kind or not a.name:
        raise AlError("usage: al eject LAYER (command|hop|expert) NAME [--force]   or   al eject LAYER --list")
    for src, dst, users in eject(layer, a.kind, a.name, a.force):
        print(f"ejected {dst.relative_to(layer)}  (the kit's {src.name}, unrendered; used by {', '.join(users)})")
    print(f"next:\n  1. edit the copy under {layer / 'templates'}; keep its {{{{placeholders}}}} (an unknown one is an error)\n"
          f"  2. al gen {layer}    every {a.kind} using this template now renders from your copy\n"
          f"  3. al eject {layer} --list   shows when the kit's own version changes, so you can take its improvements")
    return 0


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(prog="al", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("init"); p.add_argument("app", type=Path); p.add_argument("--layer", type=Path)
    p.add_argument("--in-repo", action="store_true", help="put the layer inside the application repository (committed with it)")
    p.add_argument("--dir", default="agentic", help="with --in-repo: the layer directory, relative to the repository root")
    p = sub.add_parser("scout"); p.add_argument("app", type=Path); p.add_argument("-o", "--out", type=Path); p.add_argument("--json", action="store_true")
    p = sub.add_parser("explain", help="explain a layer definition in plain language, block by block")
    p.add_argument("layer", type=Path); p.add_argument("--md", type=Path); p.add_argument("--gif", type=Path)
    for name in ("compile", "check"):
        p = sub.add_parser(name); p.add_argument("layer", type=Path)
    p = sub.add_parser("gen"); p.add_argument("layer", type=Path)
    p.add_argument("--discard-edits", action="store_true", help="overwrite generated files that were edited by hand")
    p = sub.add_parser("eject", help="copy a kit template into the layer so changes to it survive `al gen`")
    p.add_argument("layer", type=Path); p.add_argument("kind", nargs="?", choices=("command", "hop", "expert"))
    p.add_argument("name", nargs="?"); p.add_argument("--list", action="store_true", help="every template and where it resolves from")
    p.add_argument("--force", action="store_true", help="replace an existing layer copy with the kit's version")
    improve_parsers(sub)
    p = sub.add_parser("dashboard", help="watch the runs of any layers live in a browser (read-only)")
    p.add_argument("dirs", nargs="*", type=Path, metavar="LAYER_OR_DIR",
                   help="a layer (has agentic-layer.json) or a directory to scan for layers; default: .")
    p.add_argument("--port", type=int, default=8765); p.add_argument("--bind")
    p.add_argument("--token", help="access token (needed for a non-loopback --bind; also AL_DASHBOARD_TOKEN)")
    p.add_argument("--open", action="store_true", help="open the page in a browser")
    p.add_argument("--podman", action="store_true", help="run it in its own locked-down podman container")
    p = sub.add_parser("verify", help="run the layer's codebase cmds on a throwaway worktree")
    p.add_argument("layer", type=Path)
    p.add_argument("--cmd", dest="names", action="append", default=[], metavar="NAME", help="verify only this cmd (repeatable)")
    p.add_argument("--timeout", type=int, metavar="S", help="seconds per cmd (default: each cmd's own #:timeout)")
    p.add_argument("--json", action="store_true", help="print the report as JSON on stdout (progress goes to stderr)")
    a = ap.parse_args(argv)
    try:
        if a.cmd == "explain":
            extra = (["--md", str(a.md)] if a.md else []) + (["--gif", str(a.gif)] if a.gif else [])
            return subprocess.call([str(ROOT / "tools" / "explain.py"), str(a.layer), *extra])
        if a.cmd == "scout":
            facts = scout(a.app)
            text = json.dumps(facts, indent=2) if a.json else render_llm_txt(facts)
            a.out.write_text(text) if a.out else print(text)
        elif a.cmd == "init" and a.in_repo:
            init_in_repo(a.app.resolve(), a.dir, a.layer)
        elif a.cmd == "init":
            app = a.app.resolve()
            layer = (a.layer or app.with_name(app.name + ".al")).resolve()
            if layer == app or app in layer.parents:
                raise AlError("the layer must not live inside the application tree")
            layer.mkdir(parents=True, exist_ok=True)
            if not (layer / "LLM.txt").exists():
                (layer / "LLM.txt").write_text(render_llm_txt(scout(app)))
            shutil.copy(REFERENCE, layer / "AL-DSL.llms.txt")
            print(f"layer: {layer}\n  LLM.txt          draft — complete it with meta/commands/scout-codebase.md\n"
                  f"  AL-DSL.llms.txt  language reference\nnext: author {layer}/agentic.rkt (meta/commands/author-layer.md), then `al gen {layer}`\n"
                  f"codebase root to use in agentic.rkt: {os.path.relpath(app, layer)}")
        elif a.cmd == "compile":
            ir = compile_layer(a.layer.resolve())
            print(json.dumps(ir, indent=2, sort_keys=True))
        elif a.cmd == "gen":
            layer = a.layer.resolve()
            gen = Generator(layer, compile_layer(layer))
            try:
                written = gen.generate(discard_edits=a.discard_edits)
            except HandEditError as exc:
                print(f"al gen: {exc}", file=sys.stderr)
                return 3
            shown = (": " + ", ".join(gen.changed)) if 0 < len(gen.changed) <= 8 else ""
            new = [rel for rel in gen.scaffolded if not rel.endswith(".gitkeep")]
            print((f"scaffolded (written once, yours from now on): {', '.join(new)}\n" if new else "")
                  + f"generated {len(written)} files in {layer} ({len(gen.changed)} changed{shown})")
        elif a.cmd == "check":
            layer = a.layer.resolve()
            problems = check_layer(layer)
            for pr in problems:
                print(f"PROBLEM: {pr}")
            if (layer / "agentic-layer.json").is_file():
                for row in template_rows(layer, json.loads((layer / "agentic-layer.json").read_text())):
                    if row["from"] == "layer":
                        print(f"note: template overridden by the layer: templates/{row['kind']}/{row['template']} "
                              f"(used by {', '.join(row['used_by']) or 'nothing'}; {row['status']})")
            for line in died_runs(layer):
                print(f"note: {line}")
            print("check: " + ("FAILED" if problems else "ok"))
            return 1 if problems else 0
        elif a.cmd == "eject":
            return eject_cli(a)
        elif a.cmd == "dashboard":
            return dashboard_cli(a)
        elif a.cmd in IMPROVE_COMMANDS:
            return improve_main(a)
        elif a.cmd == "verify":
            say = (lambda line: print(line, file=sys.stderr, flush=True)) if a.json else (lambda line: print(line, flush=True))
            report, _ = verify_layer(a.layer.resolve(), a.names, a.timeout, say)
            failed = [r["name"] for r in report if r["exit"] != 0]
            if a.json:
                print(json.dumps(report, indent=2))
            say(f"verify: {len(report) - len(failed)}/{len(report)} ok" + (f"; failed: {', '.join(failed)}" if failed else "")
                + f"; report {a.layer.resolve() / 'agents/verify/report.json'}")
            return 1 if failed else 0
    except AlError as e:
        print(f"al: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
