    q.add_argument("--no-cache", action="store_true", help="rebuild every layer, e.g. to take a moved base image tag")
    q = actions.add_parser("doctor", help="start a throwaway container exactly as a run does and check it; "
                           "exit 1 when something is missing")
    q.add_argument("--env", metavar="ID", help="the podman environment (default: the first)")
    q.add_argument("--workflow", metavar="NAME", help="check what this workflow needs (default: the first workflow "
                   "that runs in the environment)")
    q = actions.add_parser("shell", help="open a shell in a throwaway container, as a run's commands see it")
    q.add_argument("--env", metavar="ID", help="the podman environment (default: the first)")
    actions.add_parser("prune", help="remove every old image of this layer that no run or container uses")
    actions.add_parser("status", help="the recipe hash and image of every podman environment, and the old images")
    q = actions.add_parser("push", help="build the image of the current recipe if needed and push it to the declared "
                           "(registry …)")
    q.add_argument("--dry-run", action="store_true", help="say what it would do; change nothing")
    q = actions.add_parser("pull", help="pull the image of this recipe from the registry, check its al.recipe label, tag it")
    q.add_argument("--dry-run", action="store_true", help="say what it would do; change nothing")
    p = sub.add_parser("notify-test", help="send one marked test message through every notifier of a layer")
    p.add_argument("layer", type=Path)
    p.add_argument("--event", default="needs-human", choices=("needs-human", "failed", "passed", "shipped"))
    a = ap.parse_args(argv)
    try:
        if a.cmd == "explain":
            extra = (["--md", str(a.md)] if a.md else []) + (["--gif", str(a.gif)] if a.gif else [])
            return subprocess.call([str(ROOT / "tools" / "explain.py"), str(a.layer), *extra])
        if a.cmd == "scout" and a.into:
            tools = tools_module()
            tools.need(tools.NEEDS["scout"] + tools.agent_bin(a.agent), a.into.resolve())
            module = scout_step_module()
            try:
                return module.complete(sys.modules[__name__], a.app, a.into, a.agent, a.scout_mock, a.timeout, a.network,
                                       say=lambda line: print(line, flush=True), raw=a.raw,
                                       kit=None if a.raw else dashboard_kit_module())
            except (module.ScoutError, author_module().AuthorError) as exc:
                raise AlError(f"scout: {exc}") from exc
        if a.cmd == "scout":
            if a.raw:
                raise AlError("scout: --raw goes with --into")
            facts = scout(a.app, layer=a.layer)
            text = json.dumps(facts, indent=2) if a.json else render_llm_txt(facts)
            a.out.write_text(text) if a.out else print(text)
        elif a.cmd == "init" and a.in_repo:
            init_in_repo(a.app.resolve(), a.dir, a.layer)
        elif a.cmd == "init":
            app = a.app.resolve()
            layer = (a.layer or app.with_name(app.name + ".al")).resolve()
            if layer == app or app in layer.parents:
                raise AlError("the layer must not live inside the application tree")
            layer.mkdir(parents=True, exist_ok=True)
            init_facts(app, layer)
            shutil.copy(REFERENCE, layer / "AL-DSL.llms.txt")
            print(f"layer: {layer}\n  LLM.txt          draft — complete it with meta/commands/scout-codebase.md\n"
                  f"  scout.json       the facts behind the draft (al scout {app} --into {layer} measures the commands)\n"
                  f"  AL-DSL.llms.txt  language reference\nnext: author {layer}/agentic.rkt (meta/commands/author-layer.md), then `al gen {layer}`\n"
                  f"codebase root to use in agentic.rkt: {os.path.relpath(app, layer)}")
        elif a.cmd == "doctor":
            return doctor_cli(a)
        elif a.cmd == "compile":
            tools_module().need(tools_module().NEEDS["compile"], a.layer.resolve())
            ir = compile_layer(a.layer.resolve())
            print(json.dumps(ir, indent=2, sort_keys=True))
        elif a.cmd == "gen":
            layer = a.layer.resolve()
            tools_module().need(tools_module().NEEDS["gen"], layer)
            gen = Generator(layer, compile_layer(layer))
            try:
                written = gen.generate(discard_edits=a.discard_edits)
            except HandEditError as exc:
                print(f"al gen: {exc}", file=sys.stderr)
                return 3
            shown = (": " + ", ".join(gen.changed)) if 0 < len(gen.changed) <= 8 else ""
            new = [rel for rel in gen.scaffolded if not rel.endswith(".gitkeep")]
            print((f"scaffolded (written once, yours from now on): {', '.join(new)}\n" if new else "")
                  + f"generated {len(written)} files in {layer} ({len(gen.changed)} changed{shown})")
        elif a.cmd == "check":
            layer = a.layer.resolve()
            problems = check_layer(layer)
            for pr in problems:
                print(f"PROBLEM: {pr}")
            if (layer / "agentic-layer.json").is_file():
                for row in template_rows(layer, json.loads((layer / "agentic-layer.json").read_text())):
                    if row["from"] == "layer":
                        print(f"note: template overridden by the layer: templates/{row['kind']}/{row['template']} "
                              f"(used by {', '.join(row['used_by']) or 'nothing'}; {row['status']})")
                for line in step_block_notes(layer, json.loads((layer / "agentic-layer.json").read_text())):
                    print(f"note: {line}")
            for line in died_runs(layer):
                print(f"note: {line}")
            if (layer / "agentic-layer.json").is_file():
                ir = json.loads((layer / "agentic-layer.json").read_text())
                app = app_root_of(layer, ir)
                if (ir.get("layer") or {}).get("kind") == "in-repo" and app.exists():
                    for line in in_repo_notes(layer, app):
                        print(f"note: {line}")
            if (layer / "agentic-layer.json").is_file():
                app = app_root_of(layer, json.loads((layer / "agentic-layer.json").read_text()))
                for line in (adopt_module().check(layer, app)[1] if app.exists() else []):
                    print(f"note: {line}")
            print("check: " + ("FAILED" if problems else "ok"))
            return 1 if problems else 0
        elif a.cmd == "eject":
            return eject_cli(a)
        elif a.cmd == "dashboard":
            return dashboard_cli(a)
        elif a.cmd == "models":
            return models_cli(a)
        elif a.cmd == "cycle":
            return cycle_cli(a)
        elif a.cmd == "promote":
            return promote_cli(a)
        elif a.cmd == "decide":
            return decide_cli(a)
        elif a.cmd == "decider":
            return decider_cli(a)
        elif a.cmd == "answer":
            return answer_cli(a)
        elif a.cmd == "run":
            return run_cli(a)
        elif a.cmd in ("runs", "settle"):
            return runs_module().main(a, sys.modules[__name__])
        elif a.cmd == "deploy":
            return deploy_module().main(a, sys.modules[__name__])
        elif a.cmd in IMPROVE_COMMANDS:
            return improve_main(a)
        elif a.cmd == "adopt":
            module = adopt_module()
            if a.diff and not a.dry_run:
                raise AlError("--diff goes with --dry-run")
            tools_module().need(tools_module().NEEDS["adopt"], a.layer.resolve())
            try:
                return module.adopt(sys.modules[__name__], a.layer, a.app, set(a.only or ("rules", "prompts", "workflows")),
                                    a.dry_run, a.force, diff=a.diff)
            except module.AdoptError as exc:
                raise AlError(f"adopt: {exc}") from exc
        elif a.cmd == "author":
            module = author_module()
            if a.agent == "mock" and a.mock is None:
                raise AlError("author: --agent mock needs --mock FILE")
            try:
                return module.author(sys.modules[__name__], a.layer, a.agent, a.mock, a.preferences,
                                     say=lambda line: print(line, flush=True), accept_existing=a.accept_existing,
                                     raw=a.raw, choices=module.parse_choices(a.choice))
            except module.AuthorError as exc:
                raise AlError(f"author: {exc}") from exc
        elif a.cmd in ("create", "adopt-all"):
            return create_cli(a)
        elif a.cmd == "result":
            module = create_module()
            card = module.result_card(a.layer)
            print(json.dumps(card, indent=2) if a.json else module.render_card(card))
        elif a.cmd == "verify":
            say = (lambda line: print(line, file=sys.stderr, flush=True)) if a.json else (lambda line: print(line, flush=True))
            report, _ = verify_layer(a.layer.resolve(), a.names, a.timeout, say, workflow=a.workflow)
            several = len({r.get("stack") for r in report}) > 1
            failed = [r["name"] + (f" [{r['stack']}]" if several else "") for r in report if r["exit"] != 0]
            if a.json:
                print(json.dumps(report, indent=2))
            say(f"verify: {len(report) - len(failed)}/{len(report)} ok" + (f"; failed: {', '.join(failed)}" if failed else "")
                + f"; report {a.layer.resolve() / 'agents/verify/report.json'}")
            return 1 if failed else 0
        elif a.cmd == "notify-test":
            return notify_test(a.layer.resolve(), a.event)
        elif a.cmd == "sandbox":
            return sandbox_cli(a)
    except tools_module().ToolMissing as e:
        return tool_missing(a.cmd, e)
    except CompilerUnavailable as e:
        print(f"al: {a.cmd}: {e}", file=sys.stderr)
        return 4
    except AlError as e:
        print(f"al: {e}", file=sys.stderr)
        return 1
    except FileNotFoundError as e:
        name = os.path.basename(str(e.filename or ""))
        if name not in tools_module().TOOLS:
            raise
        return tool_missing(a.cmd, tools_module().ToolMissing([tools_module().find(name)]))
    return 0


def create_module():
    """tools/al_create.py: `al create`, `al adopt-all` and `al result` (the dashboard runs the same sequence)."""
    if str(ROOT / "tools") not in sys.path:
        sys.path.insert(0, str(ROOT / "tools"))
    import al_create
    return al_create


def create_cli(a: argparse.Namespace) -> int:
    module, author = create_module(), author_module()
    try:
        choices = author.parse_choices(a.choice)
        if a.choices:
            detected = module.detect_choices(facts_for_layer(scout(a.app)))
            if a.json:
                print(json.dumps(detected, indent=2))
            else:
                for key, c in detected.items():
                    print(f"{key:12} {c['value'] or '-':20} {c['fact']}")
            return 0
        tools = tools_module()
        tools.need(tools.NEEDS[a.cmd] + tools.agent_bin(a.agent), a.app.resolve().with_name(a.app.resolve().name + ".al"))
        return module.create(sys.modules[__name__], a.app, a.cmd == "adopt-all", a.agent, a.mock, a.scout_mock, choices,
                             say=lambda line: print(line, flush=True))
    except (module.CreateError, author.AuthorError) as exc:
        raise AlError(f"{a.cmd}: {exc}") from exc


def tool_missing(cmd: str, e) -> int:
    """A missing prerequisite: one `al: CMD: sentence` line per tool (and the caller's hint), exit 4."""
    for sentence in e.sentences:
        print(f"al: {cmd}: {sentence}", file=sys.stderr)
    if e.hint:
        print(f"al: {cmd}: {e.hint}", file=sys.stderr)
    return 4


def doctor_cli(a: argparse.Namespace) -> int:
    """`al doctor [LAYER] [--for CMD,…] [--agent A] [--json]`: exit 0, or 4 when a tool is missing."""
    tools = tools_module()
    layer = a.layer.resolve() if a.layer else None
    if a.for_:
        names: list[str] = []
        for cmd in (c.strip() for c in a.for_.split(",")):
            if not cmd:
                continue
            if cmd not in tools.NEEDS:
                raise AlError(f"doctor: --for {cmd}: not one of {', '.join(sorted(tools.NEEDS))}")
            names += tools.NEEDS[cmd]
            if cmd in ("author", "improve", "scout", "create", "adopt-all"):
                names += tools.agent_bin(a.agent or "claude-code")
        try:
            tools.need(names, layer)
        except tools.ToolMissing as e:
            print("\n".join(e.sentences))
            return 4
        print("ok")
        return 0
    names = list(("racket", "raco", "uv", "git"))
    if a.agent:
        names += tools.agent_bin(a.agent)
    elif layer is not None and (layer / "agentic-layer.json").is_file():
        try:
            ir = json.loads((layer / "agentic-layer.json").read_text())
        except ValueError:
            ir = {}
        for agent in deploy_module().used_agents(ir):
            names += tools.agent_bin(agent.get("kind"))
    else:
        names.append("claude")
    rows = tools.doctor_rows(names, layer, versions=True)
    ok = all(row["found"] for row in rows)
    print(json.dumps({"ok": ok, "tools": rows}, indent=2) if a.json else tools.doctor_table(rows))
    return 0 if ok else 4


