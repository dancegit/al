OUTPUT_CONTRACT = {
    "text": "Finish with a concise report in plain markdown. No preamble.",
    "path": "Your final message must be ONLY the path of the file you created, on a single line, with no other text.",
    "json": "Your final message must be ONLY one JSON document in a ```json fenced block, with no other text.",
}


def bullets(items: list[str], empty: str = "- (none)") -> str:
    return "\n".join(f"- {i}" for i in items) or empty


def yaml_safe(text: str) -> str:
    """One-line text that is safe as an unquoted YAML scalar in template front matter."""
    text = re.sub(r"\s+", " ", text).replace(": ", " - ").replace(" #", " ").strip()
    return re.sub(r"^[^A-Za-z0-9]+", "", text) or "command"


def fill(text: str, values: dict[str, str]) -> str:
    def sub(m: re.Match) -> str:
        key = m.group(1)
        if key not in values:
            raise AlError(f"template uses unknown placeholder {{{{{key}}}}}")
        return values[key]
    return re.sub(r"\{\{([a-z_]+)\}\}", sub, text)


def fabric_pattern(name: str) -> Path:
    for d in FABRIC_DIRS:
        p = d / name / "system.md"
        if p.exists():
            return p
    raise AlError(f"fabric pattern `{name}` not found in {', '.join(map(str, FABRIC_DIRS))} (set AL_FABRIC_DIR)")


class Generator:
    def __init__(self, layer: Path, ir: dict):
        self.layer, self.ir, self.written = layer, ir, []
        self.cb = ir["codebase"]
        self.cmds = {c["name"]: c for c in self.cb["commands"]}

    def write(self, rel: str, content: str, mode: int = 0o644, keep_existing: bool = False) -> None:
        path = self.layer / rel
        if keep_existing and path.exists():
            return
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content)
        path.chmod(mode)
        if not keep_existing:
            self.written.append(rel)

    def copy_tree(self, src: Path, rel: str) -> None:
        for f in sorted(src.rglob("*")):
            if f.is_file() and "__pycache__" not in f.parts and f.suffix != ".pyc":
                target = f"{rel}/{f.relative_to(src)}"
                self.write(target, f.read_text(), 0o755 if os.access(f, os.X_OK) else 0o644)

    def cmd_line(self, name: str) -> str:
        c = self.cmds[name]
        return f"`{c['run']}`" + (f" — {c['description']}" if c["description"] else f" — codebase cmd `{name}`")

    def base_values(self) -> dict[str, str]:
        cb, p = self.cb, self.cb["paths"]
        return {
            "name": self.ir["name"],
            "codebase_description": cb["description"] or self.ir["description"] or self.ir["name"],
            "languages": ", ".join(cb["languages"]),
            "readme": cb["readme"],
            "package_manager": cb["packageManager"] or "(not specified — do not add dependencies without flagging it)",
            "default_branch": cb["defaultBranch"],
            "protected_paths": bullets([f"`{x}`" for x in p["protected"]]),
            "all_commands": bullets([f"**{n}**: {self.cmd_line(n)}" for n in self.cmds]),
            "conditional_docs": bullets([f"`{d['path']}` — {d['when']}" for d in cb["conditionalDocs"]]),
            "relevant_files": bullets([f"`{x}`" for x in [cb["readme"], *p["source"], *p["tests"]] if x]),
            "validation_commands": bullets([self.cmd_line(n) for n in self.cmds if n in ("lint", "typecheck", "test", "build")]),
            "focus": "", "fabric": "", "output_contract": OUTPUT_CONTRACT["text"],
            "command_name": "", "description": "",
            "expert_name": "", "expert_domain": "", "expert_paths": "", "expert_max_lines": "", "expertise_path": "",
        }

    def fabric_section(self, patterns: list[str]) -> str:
        if not patterns:
            return ""
        for pat in patterns:
            self.write(f"fabric/{pat}/system.md", fabric_pattern(pat).read_text())
        return ("## Method (Fabric patterns)\n\nBefore producing your output, read and apply the method in each of these "
                "pattern files. Where a pattern's output format differs from the Report section below, the Report section wins.\n\n"
                + bullets([f"`${{layer_dir}}/fabric/{pat}/system.md`" for pat in patterns]))

    def commands(self) -> None:
        base = self.base_values()
        for kind, items, src_dir in (("commands", self.ir["commands"], KIT / "templates/commands"),
                                     ("hops", self.ir["hops"], KIT / "templates/hops")):
            for c in items:
                v = dict(base, command_name=c["name"], description=yaml_safe(c["description"] or f"{c['template']} for {self.ir['name']}"))
                if kind == "commands":
                    src = self.layer / c["file"] if c["template"] == "custom" else src_dir / f"{c['template']}.md"
                    if c["relevant"]:
                        v["relevant_files"] = bullets([f"`{x}`" for x in c["relevant"]])
                    if c["validation"]:
                        v["validation_commands"] = bullets([self.cmd_line(n) for n in c["validation"]])
                    v["focus"] = bullets(c["focus"], "")
                    v["fabric"] = self.fabric_section(c["fabric"])
                    contract = OUTPUT_CONTRACT[c["output"]]
                    schema = KIT / "schemas" / f"{c['template']}.schema.json"
                    if c["output"] == "json" and schema.exists():
                        contract += f"\n\nIt must validate against this JSON Schema:\n\n```json\n{schema.read_text().strip()}\n```"
                    v["output_contract"] = contract
                else:
                    src = src_dir / f"{c['template']}.md"
                if not src.exists():
                    raise AlError(f"{kind[:-1]} `{c['name']}`: template file {src} is missing")
                self.write(f"{kind}/{c['name']}.md", fill(src.read_text(), v))

    def experts(self) -> None:
        base = self.base_values()
        for e in self.ir["experts"]:
            rel = f"experts/{e['name']}"
            v = dict(base, expert_name=e["name"], expert_domain=e["domain"],
                     expert_paths=bullets(e["paths"]), expert_max_lines=str(e["maxLines"]),
                     expertise_path=f"${{layer_dir}}/{rel}/expertise.yaml", command_name=e["name"], description=yaml_safe(e["domain"]))
            src = KIT / "templates/experts"
            self.write(f"{rel}/expertise.yaml", fill((src / "expertise.yaml").read_text(), v), keep_existing=True)
            for f in ("question.md", "self-improve.md"):
                self.write(f"{rel}/{f}", fill((src / f).read_text(), v))

    def adws(self) -> None:
        self.copy_tree(KIT / "runtime/adw_modules", "adws/adw_modules")
        deps = '["boto3>=1.34"]' if self.ir["storage"]["kind"] == "s3" else "[]"
        header = f"#!/usr/bin/env -S uv run --quiet --script\n# /// script\n# requires-python = \">=3.11\"\n# dependencies = {deps}\n# ///\n"
        for a in self.ir["adws"]:
            steps = " → ".join(s["name"] for s in a["steps"])
            self.write(f"adws/adw_{a['name']}.py", header + f'''"""ADW `{a['name']}` — {a['description'] or 'generated by al'}

Steps: {steps}
PITER: input={a['input']} trigger={a['trigger']} environment={a['environment']} review={a['review']}
Generated from agentic.rkt — edit that file and run `al gen`, not this one.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from adw_modules.runner import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(adw="{a['name']}", layer_dir=Path(__file__).resolve().parent.parent))
''', 0o755)
        self.write("adws/dispatch.py", header + (KIT / "runtime/dispatch.py").read_text(), 0o755)
        used = {t["kind"] for t in self.ir["triggers"]}
        for kind, script in (("cron", "trigger_cron.py"), ("webhook", "trigger_webhook.py"),
                             ("file-watch", "trigger_watch.py"), ("voice", "trigger_voice.py")):
            if kind in used and (KIT / "runtime/triggers" / script).exists():
                self.write(f"adws/triggers/{script}", (KIT / "runtime/triggers" / script).read_text(), 0o755)
        if self.ir["voice"]:
            self.copy_tree(KIT / "runtime/voice", "adws/voice")

    def environments(self) -> None:
        name = self.ir["name"]
        envs = {e["kind"]: e for e in reversed(self.ir["environments"])}  # first declared of each kind wins
        if "nix-devshell" in envs:
            e = envs["nix-devshell"]
            hook = e["shellHook"].replace("''", "'''")
            self.write("env/flake.nix", f'''# Generated by al from agentic.rkt — do not edit.
{{
  description = "Agentic layer toolchain for {name}";

  inputs.nixpkgs.url = "{e['nixpkgs']}";

  outputs = {{ self, nixpkgs }}:
    let
      systems = [ "x86_64-linux" "aarch64-linux" "x86_64-darwin" "aarch64-darwin" ];
      forAllSystems = nixpkgs.lib.genAttrs systems;
    in {{
      devShells = forAllSystems (system:
        let pkgs = import nixpkgs {{ inherit system; }};
        in {{
          default = pkgs.mkShell {{
            packages = with pkgs; [ {' '.join(e['packages'])} ];
            shellHook = \'\'
              export AL_LAYER="{name}"
              {hook}
            \'\';
          }};
        }});
    }};
}}
''')
        if "home-manager" in envs:
            e = envs["home-manager"]
            mod = e["moduleName"]
            cron = next((t for t in self.ir["triggers"] if t["kind"] == "cron"), None)
            service = f'''
    systemd.user.services."al-{name}-cron" = {{
      Unit.Description = "Agentic layer cron trigger for {name}";
      Service.ExecStart = "${{pkgs.uv}}/bin/uv run ${{cfg.layerDir}}/adws/triggers/trigger_cron.py";
      Service.Restart = "on-failure";
      Install.WantedBy = [ "default.target" ];
    }};''' if cron else ""
            self.write("env/home-manager.nix", f'''# Generated by al from agentic.rkt — do not edit.
# Import from your Home Manager configuration:
#   imports = [ {self.layer}/env/home-manager.nix ];
#   programs.{mod}.enable = true;
{{ config, lib, pkgs, ... }}:
let
  cfg = config.programs."{mod}";
  adw = pkgs.writeShellScriptBin "al-{name}" \'\'
    # al-{name} <adw> [args…]   run an ADW of the {name} agentic layer
    if [ $# -lt 1 ]; then ls "${{cfg.layerDir}}/adws" | sed -n 's/^adw_\\(.*\\)\\.py$/\\1/p'; exit 0; fi
    exec ${{pkgs.uv}}/bin/uv run "${{cfg.layerDir}}/adws/adw_$1.py" "''${{@:2}}"
  \'\';
in {{
  options.programs."{mod}" = {{
    enable = lib.mkEnableOption "the agentic layer for {name}";
    layerDir = lib.mkOption {{
      type = lib.types.str;
      default = "{self.layer}";
      description = "Directory of the generated agentic layer.";
    }};
  }};

  config = lib.mkIf cfg.enable {{
    home.packages = (with pkgs; [ {' '.join(e['packages'])} uv git ]) ++ [ adw ];
    home.sessionVariables.AL_{re.sub(r'[^A-Z0-9]', '_', name.upper())}_LAYER = cfg.layerDir;{service}
  }};
}}
''')
            self.write("env/home.example.nix", f'''# Standalone Home Manager example using the generated module.
{{ pkgs, ... }}: {{
  imports = [ ./home-manager.nix ];
  home.stateVersion = "{e['stateVersion']}";
  programs."{mod}".enable = true;
}}
''')
        if "podman" in envs:
            e = envs["podman"]
            lines = [f"# Generated by al from agentic.rkt — do not edit.\nFROM {e['baseImage']}"]
            if e["packages"]:
                lines.append("RUN apt-get update && apt-get install -y --no-install-recommends "
                             + " ".join(e["packages"]) + " && rm -rf /var/lib/apt/lists/*")
            lines += [f"RUN {s}" for s in e["setup"]]
            lines += ["ENV HOME=/tmp/home", "RUN mkdir -p /tmp/home && chmod 1777 /tmp/home", "WORKDIR /work", ""]
            self.write("env/Containerfile", "\n".join(lines))

    def triggers_and_forge(self) -> None:
        name, forge = self.ir["name"], self.ir["forge"]
        for t in self.ir["triggers"]:
            if t["kind"] == "cron" and t["systemd"]:
                self.write(f"systemd/al-{name}-cron.service", f"""# Generated by al. Install: cp to ~/.config/systemd/user/ && systemctl --user enable --now al-{name}-cron
[Unit]
Description=Agentic layer cron trigger for {name}

[Service]
ExecStart=/usr/bin/env uv run {self.layer}/adws/triggers/trigger_cron.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
""")
            if t["kind"] == "webhook":
                self.write(f"systemd/al-{name}-webhook.service", f"""# Generated by al. Install: cp to ~/.config/systemd/user/ && systemctl --user enable --now al-{name}-webhook
[Unit]
Description=Agentic layer webhook trigger for {name} ({t['bind']}:{t['port']}{t['path']})

[Service]
ExecStart=/usr/bin/env uv run {self.layer}/adws/triggers/trigger_webhook.py
Restart=on-failure

[Install]
WantedBy=default.target
""")
            if t["kind"] == "forge-actions" and forge["kind"] in ("github", "forgejo"):
                ctx = "github"  # Forgejo Actions keeps the `github` context for compatibility
                on: list[str] = []
                ev = t["events"]
                if "issue-opened" in ev or "issue-labeled" in ev:
                    types = [x for x, k in (("opened", "issue-opened"), ("labeled", "issue-labeled")) if k in ev]
                    on.append(f"  issues:\n    types: [{', '.join(types)}]")
                if "issue-comment" in ev:
                    on.append("  issue_comment:\n    types: [created]")
                if "schedule" in ev and t["schedule"]:
                    on.append(f"  schedule:\n    - cron: \"{t['schedule']}\"")
                if "workflow-dispatch" in ev:
                    on.append("  workflow_dispatch:\n    inputs:\n      prompt:\n        description: High-level prompt\n        required: true\n"
                              "      adw:\n        description: ADW name (empty = pick automatically)\n        required: false")
                marker = forge["botMarker"]
                label_cond = (f"contains({ctx}.event.issue.labels.*.name, '{t['label']}')" if t["label"] else "true")
                wf = f"""# Generated by al for the {name} agentic layer.
# This is the ONLY file that belongs in the application repository, and only if you want the
# forge's CI to be the trigger. It contains no logic: it calls into the layer, which lives on
# the runner at $AL_LAYER_DIR (default {self.layer}).
name: adw
on:
{chr(10).join(on)}

concurrency:
  group: adw-${{{{ {ctx}.event.issue.number || {ctx}.run_id }}}}
  cancel-in-progress: false

jobs:
  adw:
    runs-on: {t['runner']}
    if: >-
      {ctx}.event_name == 'workflow_dispatch' || {ctx}.event_name == 'schedule' ||
      (({label_cond}) && !startsWith({ctx}.event.comment.body || '', '{marker}'))
    env:
      AL_LAYER_DIR: ${{{{ vars.AL_LAYER_DIR || '{self.layer}' }}}}
      {forge['tokenEnv']}: ${{{{ secrets.{forge['tokenEnv']} }}}}
    steps:
      - name: Run the agentic layer
        env:
          ADW_PROMPT: ${{{{ inputs.prompt }}}}
          ADW_NAME: ${{{{ inputs.adw }}}}
          ADW_ISSUE: ${{{{ {ctx}.event.issue.number }}}}
        run: |
          if [ -n "$ADW_ISSUE" ]; then
            uv run "$AL_LAYER_DIR/adws/dispatch.py" --source "issue:$ADW_ISSUE"
          elif [ -n "$ADW_PROMPT" ]; then
            uv run "$AL_LAYER_DIR/adws/dispatch.py" ${{ADW_NAME:+--adw "$ADW_NAME"}} "$ADW_PROMPT"
          else
            uv run "$AL_LAYER_DIR/adws/triggers/trigger_cron.py" --once
          fi
"""
                d = ".github" if forge["kind"] == "github" else ".forgejo"
                self.write(f"forge/{d}/workflows/adw.yml", wf)

    def scaffolding(self) -> None:
        ir = self.ir
        for pi in ir["promptInputs"]:
            if pi["kind"] == "tasklist":
                first = ir["adws"][0]["name"]
                self.write(pi["path"], f"""# Tasks — {ir['name']}

<!-- One `## section` per unit of work (it names the worktree/branch). One line per task.
     {pi['openMarker']} open · {pi['runningMarker']} running · {pi['doneMarker']} done · {pi['failedMarker']} failed · {pi['blockedMarker']} waits for the tasks above it
     Tags at the end of a line pick the workflow, model set and class, e.g. {{{first}, heavy, class: bug}} -->
""", keep_existing=True)
            if pi["kind"] == "spec-file":
                self.write(f"{pi['dir']}/.gitkeep", "")
        for rel in ("specs/.gitkeep", "mock/.gitkeep", "docs/.gitkeep"):
            self.write(rel, "", keep_existing=True)
        self.write("conditional_docs.md", "# Conditional documentation\n\nRead a document below before working when its condition holds.\n\n"
                   + bullets([f"`{d['path']}` — {d['when']}" for d in self.cb["conditionalDocs"]]) + "\n", keep_existing=True)
        self.write("bin/al", f"#!/bin/sh\n# Generated by al: the layer's handle on the generator and compiler.\nexec {ROOT / 'tools' / 'al'} \"$@\"\n", 0o755)
        self.write(".gitignore", "trees/\nagents/\nartefacts/\n__pycache__/\nenv/flake.lock\n")
        self.write("AL-DSL.llms.txt", REFERENCE.read_text())
        by_id = lambda key: {o["id"]: o for o in ir[key]}  # noqa: E731
        pi, tr, en, rv = by_id("promptInputs"), by_id("triggers"), by_id("environments"), by_id("reviews")
        rows = "\n".join(
            f"| `{a['name']}` | {', '.join(pi[i]['kind'] for i in a['input'])} | {', '.join(tr[i]['kind'] for i in a['trigger'])} | "
            f"{' → '.join(en[i]['kind'] for i in a['environment'])} | {rv[a['review']]['kind']}"
            f"{' → ' + rv[a['review']]['ship'] if rv[a['review']]['kind'] == 'auto' else ''} | {' → '.join(s['name'] for s in a['steps'])} |"
            for a in ir["adws"])
        self.write("README.md", f"""# Agentic layer — {ir['name']}

{ir['description']}

Generated by `al gen` from `agentic.rkt` (derived from `{ir['llmTxt']}`). This directory wraps the
application at `{self.cb['root']}`; it is not part of it. Agents work in git worktrees under `trees/`,
plans land in `specs/`, run state and logs in `agents/<adw-id>/`, proof in `artefacts/<adw-id>/`.

## Workflows

| ADW | Prompt input | Trigger | Environment | Review | Steps |
|---|---|---|---|---|---|
{rows}

## Run

```bash
uv run adws/adw_{ir['adws'][0]['name']}.py "your high-level prompt"          # manual trigger
uv run adws/adw_{ir['adws'][0]['name']}.py "…" --dry-run                     # mock agent, no LLM
uv run adws/dispatch.py --source tasklist:<line>                             # from a prompt input
```

## Change the layer

Edit `agentic.rkt` (language reference: `AL-DSL.llms.txt`), then `al gen {self.layer}`. The compiler
rejects incoherent layers; generated files are overwritten, your `tasks.md`, `specs/`, `mock/` and
expert `expertise.yaml` files are kept.
""")

    def generate(self) -> list[str]:
        planned = [f"{k}:{o['id']}" for k in ("promptInputs", "triggers", "environments", "reviews", "agents", "artefacts")
                   for o in self.ir[k] if o["status"] == "planned"]
        planned += [f"{k}:{self.ir[k]['kind']}" for k in ("forge", "storage", "layer") if self.ir[k]["status"] == "planned"]
        if planned:
            raise AlError("these options are declared `planned` in the vocabulary and have no runtime yet: " + ", ".join(planned))
        app = (self.layer / self.cb["root"]).resolve()
        if self.layer.resolve() == app or app in self.layer.resolve().parents:
            raise AlError(f"the layer ({self.layer}) must not live inside the application tree ({app})")
        self.write("agentic-layer.json", json.dumps(self.ir, indent=2, sort_keys=True) + "\n")
        self.commands()
        self.experts()
        self.adws()
        self.environments()
        self.triggers_and_forge()
        self.scaffolding()
        manifest = self.layer / ".al-manifest.json"
        old = json.loads(manifest.read_text())["files"] if manifest.exists() else []
        for stale in sorted(set(old) - set(self.written)):
            (self.layer / stale).unlink(missing_ok=True)
        manifest.write_text(json.dumps({"generator": "al 0.1", "files": sorted(self.written)}, indent=1) + "\n")
        if self.ir["layer"].get("git") and not (self.layer / ".git").exists():
            run(["git", "init", "-q", "-b", "main", str(self.layer)], check=False)
        return self.written


