def bullets(items: list[str], empty: str = "- (none)") -> str:
    return "\n".join(f"- {i}" for i in items) or empty


def yaml_safe(text: str) -> str:
    """One-line text that is safe as an unquoted YAML scalar in template front matter."""
    text = re.sub(r"\s+", " ", text).replace(": ", " - ").replace(" #", " ").strip()
    return re.sub(r"^[^A-Za-z0-9]+", "", text) or "command"


def fill(text: str, values: dict[str, str]) -> str:
    def sub(m: re.Match) -> str:
        key = m.group(1)
        if key not in values:
            raise AlError(f"template uses unknown placeholder {{{{{key}}}}}")
        return values[key]
    return re.sub(r"\{\{([a-z_]+)\}\}", sub, text)


def fabric_pattern(name: str) -> Path:
