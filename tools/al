                  f"uv run {run_prefix}adws/adw_{adw}.py \"…\" --max-cost 3                    # hand over once the run costs more than $3",
                  "```", "",
                  "The same as environment variables, which the triggers and `al improve` pass on: `AL_MODEL_SET=TIER`,",
                  "`AL_MODELS=\"heavy=…,base=…\"`, `AL_MAX_COST=USD`. Flags win. A task-file tag (`{heavy}`) or an issue",
                  "keyword (`adw: <workflow> heavy`) naming any declared tier selects it for the steps that do not set their",
                  "own. Which tier wins: `--model-set`, then the step's own `#:model-set`, then the request's tier, then the",
                  "command's; `--model` then picks that tier's model id. `state.json` (`agent_calls`) and the run's events",
                  "record the tier, model and reason of every agent call; `--help` of any workflow script says the same.", ""]
        b = self.ir.get("budget")
        if isinstance(b, dict):
            parts = [f"{label} ${b[key]:g}" for key, label in (("runUsd", "per run"), ("stepUsd", "per agent call"),
                                                                ("dayUsd", "per day in this layer")) if b.get(key) is not None]
            lines.append("Spending limits (`budget limits`): " + (", ".join(parts) or "none") + ". A run that goes over is "
                         "stopped after the agent call that crossed the limit and handed to a person (`budget:<limit>` "
                         "is the reason); once the day's limit is reached no run or agent step starts (exit code 3). "
                         "Costs are what the agents report; codex and custom agents report none and count as $0.")
        else:
            lines.append("Spending limits: none declared (add `(budget limits #:run-usd … #:day-usd …)`); `--max-cost` "
                         "still limits one run.")
        return "\n".join(lines) + "\n"

    def watch_section(self) -> str:
        d = self.dash
        if d["kind"] == "none":
            return ("## Watch the work\n\nNo dashboard: `(dashboard none)` in `agentic.rkt`. `al dashboard <this directory>` "
                    "still shows the runs on demand.\n")
        cmd = f"uv run {self.run_prefix()}adws/dashboard.py"
        lines = [f"## Watch the work\n\nA live, read-only dashboard of every run of this layer"
                 + (f" and of {', '.join('`' + x + '`' for x in d['also'])}" if d["also"] else "")
                 + (", in its own locked-down podman container" if d["kind"] == "podman" else "") + ":\n",
                 "```bash", f"{cmd}                 # then open {self.dashboard_url()}",
                 f"{cmd} --port 9000 --open   # flags override the declared ones", "```", ""]
        if d["kind"] == "podman":
            lines.append("The container prints the URL with a fresh access token when it starts.\n")
        elif d["tokenEnv"]:
            lines.append(f"Every request needs the token in `${d['tokenEnv']}` (open the page once with `?token=…`).\n")
        if d["systemd"]:
            lines.append(f"A user unit keeps it running: `systemd/al-{self.ir['name']}-dashboard.service` (install line at its top).\n")
        return "\n".join(lines).rstrip("\n") + "\n"

    def scaffolding(self) -> None:
        ir = self.ir
        for pi in ir["promptInputs"]:
            if pi["kind"] == "tasklist":
