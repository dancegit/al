      "name": "pull-request",
      "output": "text",
      "relevant": [],
      "template": "pull-request",
      "validation": []
    }
  ],
  "concurrency": {
    "id": "slots",
    "kind": "slots",
    "maxAgents": 2,
    "maxChecks": 2,
    "maxRuns": 4,
    "status": "stable",
    "waitSeconds": 3600
  },
  "description": "Agentic layer for the webshop monorepo",
  "environments": [
    {
      "copyFiles": [
        ".env"
      ],
      "deleteMergedBranches": true,
      "dir": "trees",
      "gcDays": 7,
      "id": "worktree",
      "keep": "on-failure",
      "kind": "worktree",
      "portBase": 9100,
      "portsPerRun": 2,
      "sparse": [],
      "status": "stable"
    },
    {
      "id": "nix-devshell",
      "kind": "nix-devshell",
      "nixpkgs": "github:NixOS/nixpkgs/nixos-unstable",
      "packages": [
        "bun",
        "nodejs_22",
        "python312",
        "uv",
        "ffmpeg"
      ],
      "pure": false,
      "shellHook": "",
      "status": "stable"
    },
    {
      "agentInside": false,
      "baseImage": "docker.io/library/debian:stable-slim",
      "caches": [
        "npm",
        "uv"
      ],
      "cpus": "2",
      "credentials": [],
      "id": "sandbox",
      "kind": "podman",
      "memory": "4g",
      "network": "slirp",
      "packages": [
        "git",
        "curl"
      ],
      "scope": "run",
      "setup": [],
      "status": "stable"
    }
  ],
  "experts": [
    {
      "domain": "Payment provider integration and reconciliation",
      "maxLines": 1000,
      "name": "payments",
      "paths": [
        "api/app/payments"
      ]
    }
  ],
  "forge": {
    "botMarker": "[ADW-BOT]",
    "host": "https://forgejo.example.org",
    "id": "forgejo",
    "kind": "forgejo",
    "repo": "acme/webshop",
    "status": "stable",
    "tokenEnv": "FORGEJO_TOKEN"
  },
  "hops": [
    {
      "description": "",
      "modelSet": "heavy",
      "name": "implement",
      "produces": "changes",
      "takes": "plan",
      "template": "run-plan"
    },
    {
      "description": "",
      "modelSet": "heavy",
      "name": "new-command",
      "produces": "command",
      "takes": "prompt",
      "template": "meta-command"
    },
    {
      "description": "",
      "modelSet": "heavy",
      "name": "new-adw",
      "produces": "adw",
      "takes": "prompt",
      "template": "meta-adw"
    }
  ],
  "layer": {
    "dir": "",
    "git": true,
    "id": "sibling",
    "kind": "sibling",
    "status": "stable"
  },
  "llmTxt": "LLM.txt",
  "name": "webshop",
  "promptInputs": [
    {
      "classify": true,
      "id": "issue",
      "keyword": "adw",
      "kind": "issue",
      "labels": [
        "adw"
      ],
      "status": "stable"
    },
    {
      "blockedMarker": "[>]",
      "doneMarker": "[x]",
      "failedMarker": "[!]",
      "id": "tasklist",
      "kind": "tasklist",
      "openMarker": "[ ]",
      "path": "tasks.md",
      "runningMarker": "[~]",
      "status": "stable",
      "tagSyntax": "braces"
    },
    {
      "appendToTasklist": true,
      "confirm": true,
      "id": "voice",
      "kind": "voice",
      "route": "auto",
      "status": "stable"
    }
  ],
  "reviews": [
    {
      "draft": false,
      "id": "human",
      "kind": "human",
      "reviewers": [],
      "status": "stable"
    },
    {
      "allowedClasses": [
        "chore",
        "bug"
      ],
      "artefacts": [
        "log",
        "junit",
        "screenshots",
        "recordings"
      ],
      "blockProtectedPaths": true,
      "command": "review",
      "deployCmd": "deploy",
      "id": "zero-touch",
      "kind": "auto",
      "maxDiffLines": 300,
      "maxRetries": 3,
      "requireChecks": [
        "lint",
        "test",
        "e2e"
      ],
      "reviewers": 1,
      "ship": "deploy",
      "status": "stable"
    }
  ],
  "schemaVersion": "agentic-layer-v1",
  "storage": {
    "accessKeyEnv": "AWS_ACCESS_KEY_ID",
    "bucket": "webshop-adw",
    "endpoint": "https://s3.example.org",
    "id": "s3",
    "kind": "s3",
    "localDir": "artefacts",
    "prefix": "adw",
    "publicBaseUrl": "",
    "region": "us-east-1",
    "secretKeyEnv": "AWS_SECRET_ACCESS_KEY",
    "status": "stable"
  },
  "triggers": [
    {
      "bind": "127.0.0.1",
      "events": [
        "issue-opened",
        "issue-comment"
      ],
      "id": "webhook",
      "kind": "webhook",
      "path": "/webhook",
      "port": 8001,
      "secretEnv": "ADW_WEBHOOK_SECRET",
      "status": "stable"
    },
    {
      "id": "cron",
      "intervalSeconds": 15,
      "kind": "cron",
      "maxConcurrent": 3,
      "status": "stable",
      "systemd": true
    },
    {
      "hotkey": "enter",
      "id": "voice",
      "kind": "voice",
      "status": "stable"
    },
    {
      "confirm": false,
      "id": "manual",
      "kind": "manual",
      "status": "stable"
    }
  ],
  "voice": {
    "id": "kokoro",
    "kind": "kokoro",
    "recordSeconds": 8,
    "speakSummaries": true,
    "status": "stable",
    "sttDevice": "auto",
    "sttModel": "base.en",
    "ttsLang": "en-us",
    "ttsSpeed": 100,
    "ttsVoice": "af_heart"
  }
}
