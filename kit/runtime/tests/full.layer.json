  "agents": [
    {
      "allowedTools": [
        "Read",
        "Glob",
        "Grep",
        "Edit",
        "Write",
        "Bash"
      ],
      "id": "claude-code",
      "kind": "claude-code",
      "maxTurns": 600,
      "models": [
        {
          "effort": "default",
          "model": "claude-opus-5-5",
          "tier": "base"
        },
        {
          "effort": "default",
          "model": "claude-haiku-5-5",
          "tier": "fast"
        },
        {
          "effort": "high",
          "model": "claude-fable-5-2",
          "tier": "heavy"
        }
      ],
      "permissionMode": "acceptEdits",
      "safeMode": true,
      "status": "stable",
      "timeout": 9000
    },
    {
      "id": "second-opinion",
      "kind": "codex",
      "models": [
        {
          "effort": "default",
          "model": "gpt-5.4-mini",
          "tier": "base"
        },
        {
          "effort": "default",
          "model": "gpt-5.4",
          "tier": "heavy"
        }
      ],
      "sandbox": "workspace-write",
      "status": "stable",
      "timeout": 9000
