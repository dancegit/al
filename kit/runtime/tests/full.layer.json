{
  "adws": [
    {
      "agent": "claude-code",
      "classes": [],
      "description": "Plan and implement, nothing else",
      "environment": [
        "worktree"
      ],
      "input": [
        "issue",
        "tasklist",
        "voice"
      ],
      "name": "plan-build",
      "review": "human",
      "steps": [
        {
          "args": [
            "$prompt"
          ],
          "command": "classify",
          "kind": "run",
          "modelSet": "inherit",
          "name": "classify",
          "retries": 0,
          "when": "always"
        },
        {
          "args": [
            "$prompt"
          ],
          "command": "chore",
          "kind": "run",
          "modelSet": "inherit",
          "name": "plan-chore",
          "retries": 0,
          "when": "class-chore"
        },
        {
          "args": [
            "$prompt"
          ],
          "command": "bug",
          "kind": "run",
          "modelSet": "inherit",
          "name": "plan-bug",
          "retries": 0,
          "when": "class-bug"
        },
        {
          "args": [
            "$prompt"
          ],
          "command": "feature",
          "kind": "run",
          "modelSet": "inherit",
          "name": "plan-feature",
          "retries": 0,
          "when": "class-feature"
        },
        {
          "args": [
            "$plan"
          ],
          "command": "implement",
          "kind": "run",
          "modelSet": "inherit",
          "name": "build",
          "retries": 0,
          "when": "always"
        }
      ],
      "trigger": [
        "webhook"
      ]
    },
    {
      "agent": "claude-code",
      "classes": [],
      "description": "Plan, build, test, review; a human merges",
      "environment": [
        "worktree",
        "nix-devshell"
      ],
      "input": [
        "issue",
        "tasklist"
      ],
      "name": "sdlc",
      "review": "human",
      "steps": [
        {
          "args": [
            "$prompt"
          ],
          "command": "classify",
          "kind": "run",
          "modelSet": "inherit",
          "name": "classify",
          "retries": 0,
          "when": "always"
        },
        {
          "args": [
            "$prompt"
          ],
          "command": "chore",
          "kind": "run",
          "modelSet": "inherit",
          "name": "plan-chore",
          "retries": 0,
          "when": "class-chore"
        },
        {
          "args": [
            "$prompt"
          ],
          "command": "bug",
          "kind": "run",
          "modelSet": "inherit",
          "name": "plan-bug",
          "retries": 0,
          "when": "class-bug"
        },
        {
          "args": [
            "$prompt"
          ],
          "command": "feature",
          "kind": "run",
          "modelSet": "inherit",
          "name": "plan-feature",
          "retries": 0,
          "when": "class-feature"
        },
        {
          "args": [
            "$plan"
          ],
          "command": "implement",
          "kind": "run",
          "modelSet": "inherit",
          "name": "build",
          "retries": 0,
          "when": "always"
        },
        {
          "cmd": "lint",
          "collect": [],
          "kind": "check",
          "name": "lint",
          "resolve": "resolve-test",
          "retries": 3
        },
        {
          "cmd": "test",
          "collect": [
            "junit"
          ],
          "kind": "check",
          "name": "test",
          "resolve": "resolve-test",
          "retries": 3
        },
        {
          "args": [
            "$plan"
          ],
          "command": "document",
          "kind": "run",
          "modelSet": "inherit",
          "name": "document",
          "retries": 0,
          "when": "always"
        },
        {
          "args": [],
          "command": "commit",
          "kind": "run",
          "modelSet": "inherit",
          "name": "commit",
          "retries": 0,
          "when": "always"
        },
        {
          "implement": "",
          "kind": "review",
          "name": "review",
          "patch": ""
        },
        {
          "kind": "ship",
          "message": "",
          "name": "ship"
        }
      ],
      "trigger": [
        "webhook",
        "cron",
        "manual"
      ]
    },
    {
      "agent": "claude-code",
      "classes": [
        "chore",
        "bug"
      ],
      "description": "Zero-touch: ships chores and bugs when every gate passes",
      "environment": [
        "worktree",
        "nix-devshell",
        "sandbox"
      ],
      "input": [
        "issue",
        "tasklist"
      ],
      "name": "zte",
      "review": "zero-touch",
      "steps": [
        {
          "args": [
            "$prompt"
          ],
          "command": "classify",
          "kind": "run",
          "modelSet": "inherit",
          "name": "classify",
          "retries": 0,
          "when": "always"
        },
        {
          "args": [
            "$prompt"
          ],
          "command": "chore",
          "kind": "run",
          "modelSet": "inherit",
          "name": "plan-chore",
          "retries": 0,
          "when": "class-chore"
        },
        {
          "args": [
            "$prompt"
          ],
          "command": "bug",
          "kind": "run",
          "modelSet": "inherit",
          "name": "plan-bug",
          "retries": 0,
          "when": "class-bug"
        },
        {
          "args": [
            "$prompt"
          ],
          "command": "feature",
          "kind": "run",
          "modelSet": "inherit",
          "name": "plan-feature",
          "retries": 0,
          "when": "class-feature"
        },
        {
          "args": [
            "$plan"
          ],
          "command": "implement",
          "kind": "run",
          "modelSet": "inherit",
          "name": "build",
          "retries": 0,
          "when": "always"
        },
        {
          "cmd": "lint",
          "collect": [],
          "kind": "check",
          "name": "lint",
          "resolve": "resolve-test",
          "retries": 3
        },
        {
          "cmd": "test",
          "collect": [
            "junit"
          ],
          "kind": "check",
          "name": "test",
          "resolve": "resolve-test",
          "retries": 3
        },
        {
          "cmd": "e2e",
          "collect": [
            "screenshots",
            "recordings"
          ],
          "kind": "check",
          "name": "e2e",
          "resolve": "resolve-test",
          "retries": 2
        },
        {
          "args": [],
          "command": "commit",
          "kind": "run",
          "modelSet": "inherit",
          "name": "commit",
          "retries": 0,
          "when": "always"
        },
        {
          "implement": "implement",
          "kind": "review",
          "name": "review",
          "patch": "patch"
        },
        {
          "kind": "ship",
          "message": "",
          "name": "ship"
        }
      ],
      "trigger": [
        "webhook",
        "cron"
      ]
    }
  ],
  "agents": [
    {
      "id": "claude-code",
      "kind": "claude-code",
      "maxTurns": 60,
      "modelBase": "claude-sonnet-5-5",
      "modelHeavy": "claude-opus-5-5",
      "permissionMode": "acceptEdits",
      "safeMode": true,
      "status": "stable",
      "timeout": 1800
    }
  ],
  "artefacts": [
    {
      "id": "log",
      "kind": "log",
      "status": "stable",
      "tailLines": 200
    },
    {
      "glob": "reports/*.xml",
      "id": "junit",
      "kind": "junit",
      "status": "stable"
    },
    {
      "glob": "e2e-results/**/*.png",
      "id": "screenshots",
      "kind": "image",
      "maxFiles": 12,
      "status": "stable"
    },
    {
      "glob": "e2e-results/**/*.webm",
      "id": "recordings",
      "keyframes": 6,
      "kind": "video",
      "status": "stable"
    }
  ],
  "codebase": {
    "commands": [
      {
        "description": "",
        "name": "install",
        "run": "bun install && (cd api && uv sync)",
        "timeout": 1200
      },
      {
        "description": "",
        "name": "lint",
        "run": "bun run lint && (cd api && uv run ruff check)",
        "timeout": 900
      },
      {
        "description": "",
        "name": "test",
        "run": "bun run test -- --reporter=junit --outputFile=reports/unit.xml && (cd api && uv run pytest -q)",
        "timeout": 900
      },
      {
        "description": "Playwright; writes e2e-results/",
        "name": "e2e",
        "run": "bun run e2e",
        "timeout": 1800
      },
      {
        "description": "",
        "name": "deploy",
        "run": "./scripts/deploy.sh staging",
        "timeout": 900
      }
    ],
    "conditionalDocs": [
      {
        "path": "docs/payments.md",
        "when": "When touching anything under api/app/payments"
      }
    ],
    "defaultBranch": "main",
    "description": "Vue storefront + FastAPI backend",
    "languages": [
      "typescript",
      "python"
    ],
    "packageManager": "bun add / uv add",
    "paths": {
      "docs": [
        "docs"
      ],
      "protected": [
        ".github",
        "api/migrations",
        "scripts/deploy.sh"
      ],
      "source": [
        "web/src",
        "api/app"
      ],
      "tests": [
        "web/tests",
        "api/tests"
      ]
    },
    "readme": "README.md",
    "root": "../webshop"
  },
  "commands": [
    {
      "description": "",
      "fabric": [],
      "file": "",
      "focus": [],
      "modelSet": "base",
      "name": "prime",
      "output": "text",
      "relevant": [],
      "template": "prime",
      "validation": []
    },
    {
      "description": "",
      "fabric": [],
      "file": "",
      "focus": [],
      "modelSet": "base",
      "name": "classify",
      "output": "json",
      "relevant": [],
      "template": "classify",
      "validation": []
    },
    {
      "description": "",
      "fabric": [],
      "file": "",
      "focus": [],
      "modelSet": "heavy",
      "name": "chore",
      "output": "path",
      "relevant": [],
