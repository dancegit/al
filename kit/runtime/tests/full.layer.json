    },
    {
      "description": "",
      "fabric": [],
      "file": "",
      "focus": [],
      "modelSet": "heavy",
      "name": "bug",
      "output": "path",
      "relevant": [],
      "template": "plan-bug",
      "validation": [
        "lint",
