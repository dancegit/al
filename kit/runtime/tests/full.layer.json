      "name": "resolve-test",
      "output": "text",
      "relevant": [],
      "template": "resolve-test",
      "validation": []
    },
    {
      "description": "",
      "fabric": [
        "review_code"
      ],
      "file": "",
      "focus": [],
      "modelSet": "heavy",
      "name": "review",
      "output": "json",
      "relevant": [],
      "template": "review",
      "validation": []
    },
    {
      "description": "",
      "fabric": [],
      "file": "",
      "focus": [],
