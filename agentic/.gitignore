# Written by `al gen`. Run state, work queues and machine-specific files: never source.
# The definition, the layer-local templates and the generated files are committed.
# run state
/.al-improve/
/agents/
/artefacts/
/docs/
/specs/
/trees/
# work queues of whoever runs the layer
/tasks.md
# private values of whoever runs the layer (addresses, servers, passwords): never committed
/local.env
# generated with this machine's paths; `al gen` writes them on every machine
/bin/al
/.al-manifest.local.json
# caches and lock files
__pycache__/
*.pyc
*.lock
.cache/
.*_cache/
