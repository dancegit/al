  "agents": [
    {
      "allowedTools": [
        "Read",
        "Glob",
        "Grep",
        "Edit",
        "Write",
        "Bash"
      ],
      "id": "claude-code",
      "kind": "claude-code",
      "maxTurns": 600,
      "models": [
        {
          "effort": "default",
          "model": "claude-opus-5-5",
          "tier": "base"
        },
        {
          "effort": "default",
          "model": "claude-opus-5-5",
          "tier": "heavy"
        }
      ],
      "permissionMode": "acceptEdits",
      "safeMode": true,
      "status": "stable",
      "timeout": 9000
    }
  ],
