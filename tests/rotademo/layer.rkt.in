#lang al
;; Agentic layer for the Rota demo app (tests/rotademo/app), generated by tests/rotademo/rotademo_live.sh.
;; @FORGE_HOST@ is the throwaway Forgejo the script starts, @REPO@ the repository (adw/rota for
;; scenarios A and B, adw/rota-c for scenario C) and @APP_DIR@ the local clone. Image: al-rota-demo:latest.
;; PITER: forge issue · manual · worktree + podman (agent inside) · zero-touch review by two agents, gated.
(agentic-layer #:name "rota-demo" #:description "Agentic layer for the Rota demo web app (healthcare staffing, synthetic data)"
  (codebase #:root "../@APP_DIR@" #:languages (python sql html css) #:default-branch "main"
            #:description "Rota is a small multi-tenant Flask + SQLite app for staffing hospital wards (synthetic data, demo-grade sign-in). Two organisations, Northfield Hospital and Riverside Care Group, each have wards, workers and shifts. app.py holds create_app() and the routes (HTTP only); data.py is the ONLY module that runs SQL on tenant data, through a Scope bound to one organisation; auth.py holds sign-in, roles and the organisation scope; rules.py holds the pure business rules; assignments.py applies them for the UI and the JSON API alike; db.py applies the numbered SQL files in migrations/ at start-up; seed.py loads deterministic synthetic data for a fixed today (clock.py, ROTA_TODAY=2026-03-02). tests/ has pytest suites for rules, API, journeys and tenant isolation; e2e/capture.py walks e2e/scenario.py in headless Chromium and records screenshots and a video into e2e-results/."
            #:readme "README.md" #:package-manager "pip (requirements.txt; the container image already has every dependency)"
    (cmd test "python -m pytest -q tests" #:timeout 300
         #:description "The whole pytest suite passes: business rules, API and permissions, user journeys, tenant isolation.")
    (cmd isolation "python -m pytest -q tests/test_isolation.py" #:timeout 300
         #:description "Tenant isolation: every route in the URL map, called as Northfield's manager with Riverside's ids, leaks nothing and changes nothing of Riverside's.")
    (cmd e2e "python e2e/capture.py" #:timeout 600
         #:description "The scenario in e2e/scenario.py passes in headless Chromium with no console errors; writes e2e-results/NN-<name>.png per screenshot step and e2e-results/session.webm.")
    (paths #:source ("app.py" "data.py" "rules.py" "assignments.py" "clock.py" "seed.py" "templates" "static")
           #:tests ("tests" "e2e") #:docs ("README.md" "CONTRIBUTING.md")
           #:protected ("migrations" "db.py" "auth.py" "tests/test_isolation.py" "e2e/capture.py"
                        "requirements.txt" ".gitignore" "CONTRIBUTING.md")))

  (forge forgejo #:host "@FORGE_HOST@" #:repo "@REPO@" #:token-env "AL_ROTADEMO_FORGEJO_TOKEN")
  (agent claude-code #:id claude-sandboxed #:model-base "claude-opus-5-5" #:model-heavy "claude-opus-5-5"
         #:permission-mode bypassPermissions #:max-turns 80)
  ;; Scenario C only: a scripted stand-in for the build step that applies a deliberately flawed
  ;; change (tests/rotademo/planted/). Everything else in that workflow runs on the real agent.
  (agent mock #:id planter #:script-dir "planted")
  (prompt-input issue #:labels () #:classify #f)
  (trigger manual)

  (environment worktree)
  (environment podman #:base-image "docker.io/library/python:3.12-slim" #:packages ("git" "curl" "ca-certificates" "libatomic1")
               #:setup ("pip install --no-cache-dir 'flask>=3.1,<4' 'pytest>=8,<9' 'playwright>=1.49,<2'"
                        "PLAYWRIGHT_BROWSERS_PATH=/opt/pw playwright install --with-deps --only-shell chromium && PLAYWRIGHT_BROWSERS_PATH=/opt/pw playwright install ffmpeg && chmod -R a+rX /opt/pw"
                        "HOME=/opt/claude bash -c 'curl -fsSL https://claude.ai/install.sh | bash' && chmod -R a+rX /opt/claude && ln -s /opt/claude/.local/bin/claude /usr/local/bin/claude")
               #:memory "4g" #:cpus "2" #:agent-inside #t #:credentials (claude))

  (artefact log #:tail-lines 60)
  (artefact image #:id screenshots #:glob "e2e-results/*.png" #:max-files 12)
  (artefact video #:id recording #:glob "e2e-results/*.webm" #:keyframes 8)

  (review human)
  (review auto #:id zero-touch #:reviewers 2 #:artefacts (log screenshots recording) #:ship merge
          #:require-checks (test isolation e2e) #:allowed-classes (chore bug feature) #:max-diff-lines 900
          #:block-protected-paths #t #:max-retries 1)

  (command plan-feature #:template plan-feature #:model-set heavy #:output path #:validation (test isolation e2e)
           #:focus ("Start the plan with a section '## Acceptance criteria' that restates EVERY acceptance criterion of the issue, word for word, as a checklist line '- [ ] <criterion>' followed by where it is implemented, the test that proves it and the e2e/scenario.py step (screenshot) that shows it; a reviewer ticks this list."
                    "Data access goes only through data.py (the organisation-scoped Scope); routes and rules never run SQL. Business rules live in rules.py (pure) and are applied in assignments.py, so the UI and the JSON API enforce them identically."
                    "Schema changes are made only by adding a new numbered migration file in migrations/ (e.g. 003_<what>.sql); an applied migration is never edited. seed.py holds the synthetic demo data."
                    "Every user-visible behaviour must be demonstrated in e2e/scenario.py so the screenshots and the video show it: add steps, an expect entry per behaviour (the 'options' expectation checks which <select> options are offered and selectable), a 'reveal' step before a screenshot that must show a dropdown's options, and a 'screenshot' for each visible state."
                    "New tests go into tests/test_rules.py (pure rules), tests/test_api.py (API and permissions) and tests/test_journeys.py (pages), using the fixtures in tests/conftest.py. Never weaken tests/test_isolation.py; it already covers new routes automatically."
                    "Never delete or loosen an existing expectation in tests/ or e2e/scenario.py, except where the issue deliberately changes the behaviour it describes; then update it to the new behaviour."
                    "e2e/capture.py is the test harness and a protected path: never plan a change to it; its step and expect vocabulary is documented at the top of e2e/scenario.py."))
  (command plan-patch #:template plan-patch #:model-set heavy #:output path #:validation (test isolation e2e)
           #:focus ("The issue's acceptance criteria are the definition of done: the patch closes the reviewer's blocker against them, and the e2e scenario must demonstrate the corrected behaviour (screenshot)."
                    "Data access only through data.py; schema changes only through a new migration file; never weaken tests/test_isolation.py or edit e2e/capture.py."))
  (command resolve-test #:template resolve-test #:model-set heavy
           #:focus ("Fix the app, not the expectation: never delete or loosen an expectation in tests/ or e2e/scenario.py, never weaken tests/test_isolation.py, and never edit e2e/capture.py."
                    "The e2e log names the failing step and expectation; a FAILED screenshot of that moment is in e2e-results/."))
  (command review #:template review #:model-set heavy #:output json
           #:focus ("Every path in ARTEFACT_MANIFEST (each entry's path and each keyframe's path) is relative to the layer directory ${layer_dir}: open it as ${layer_dir}/<path> with the Read tool, which displays images."
                    "Take the issue's Acceptance criteria list (ORIGINAL_PROMPT) and tick it one criterion at a time: for each, name the code (path:line), the test, and the screenshot or keyframe that proves it. A criterion that is not met, or whose user-visible part no screenshot or keyframe shows, is a blocker."
                    "Data access outside data.py's organisation scope, a weakened tests/test_isolation.py, or a schema change other than a new migration file is a blocker."
                    "Deleted or loosened expectations in tests/ or e2e/scenario.py are a blocker, except where the issue deliberately changes the behaviour the expectation described."
                    "List every screenshot, every keyframe and every log you opened in artefacts_reviewed."))
  (command commit #:template commit
           #:focus ("A commit message is one imperative summary line under 72 characters, e.g. 'Refuse assignments that break the rest rule'."))
  (hop implement #:template run-plan #:takes plan)

  (adw feature #:description "Zero-touch: plan, build, tests, tenant isolation, e2e capture, commit, two agent reviewers with screenshots and video keyframes (patch loop on blockers), gate, merge"
       #:input (issue) #:trigger (manual) #:environment (worktree podman) #:review zero-touch #:agent claude-sandboxed
       #:classes (chore bug feature)
    (steps
      (run plan #:command plan-feature #:args ("$prompt"))
      (run build #:command implement #:args ("$plan"))
      (check test #:cmd test #:resolve resolve-test #:retries 2 #:collect (log))
      (check isolation #:cmd isolation #:resolve resolve-test #:retries 1 #:collect (log))
      (check e2e #:cmd e2e #:resolve resolve-test #:retries 2 #:collect (log screenshots recording))
      (run commit #:command commit)
      (review #:patch plan-patch #:implement implement)
      (ship)))

  ;; Identical to `feature` except the build step: the scripted `planter` applies a planted,
  ;; deliberately flawed change (scenario C). Plan, checks, commit, reviewers, patch loop and
  ;; ship are all real.
  (adw planted #:description "Like feature, but the build step is a scripted, deliberately flawed change (planted defect) to test the reviewers"
       #:input (issue) #:trigger (manual) #:environment (worktree podman) #:review zero-touch #:agent claude-sandboxed
       #:classes (feature)
    (steps
      (run plan #:command plan-feature #:args ("$prompt"))
      (run build #:command implement #:args ("$plan") #:agent planter)
      (check test #:cmd test #:resolve resolve-test #:retries 2 #:collect (log))
      (check isolation #:cmd isolation #:resolve resolve-test #:retries 1 #:collect (log))
      (check e2e #:cmd e2e #:resolve resolve-test #:retries 2 #:collect (log screenshots recording))
      (run commit #:command commit)
      (review #:patch plan-patch #:implement implement)
      (ship))))
