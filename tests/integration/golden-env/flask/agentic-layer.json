  "budget": null,
  "codebase": {
    "commands": [
      {
        "always": true,
        "covers": [],
        "description": "Every pre-commit hook passes on all files: ruff lint rules B, E, F, I, UP, W; ruff format; uv.lock matches pyproject.toml; codespell; whitespace and end-of-file hooks. Hooks rewrite files in place and exit non-zero when they changed something.",
        "name": "lint",
        "reuse": true,
        "run": "uv run --locked --no-default-groups --group pre-commit pre-commit run --show-diff-on-failure --color=always --all-files",
        "timeout": 1800
      },
      {
        "always": true,
        "covers": [],
        "description": "mypy in strict mode reports no errors for src and tests/type_check.",
        "name": "typecheck",
        "reuse": true,
        "run": "uv run --locked --no-default-groups --group dev tox run -e typing",
        "timeout": 1800
      },
      {
        "always": true,
        "covers": [],
        "description": "The pytest suite in tests passes on Python 3.12 against the locked dependency versions, with every warning treated as an error; writes a JUnit XML report.",
        "name": "test",
        "reuse": true,
        "run": "TOX_ENV=py3.12 uv run --locked --no-default-groups --group dev tox run -- --junitxml=.tox/reports/junit.xml",
        "timeout": 1800
      },
      {
        "always": true,
        "covers": [],
        "description": "The sdist and wheel build into dist/.",
        "name": "build",
        "reuse": true,
        "run": "uv build",
        "timeout": 1800
      },
      {
        "always": true,
        "covers": [],
        "description": "The Sphinx documentation builds to docs/_build/dirhtml with warnings treated as errors.",
        "name": "docs",
        "reuse": true,
        "run": "uv run --locked --no-default-groups --group dev tox run -e docs",
        "timeout": 1800
      }
    ],
    "conditionalDocs": [
      {
        "path": "src/flask/sansio/README.md",
        "when": "When changing any file under src/flask/sansio"
      },
      {
        "path": "docs/web-security.rst",
        "when": "When changing session, cookie, JSON or response header handling"
      },
      {
        "path": "docs/extensiondev.rst",
        "when": "When changing an API that extensions hook into (Flask.extensions, init_app patterns, signals, teardown callbacks)"
      },
      {
        "path": "docs/async-await.rst",
        "when": "When changing async view support or ensure_sync"
      },
      {
        "path": "docs/cli.rst",
        "when": "When changing src/flask/cli.py"
      },
      {
        "path": "docs/testing.rst",
        "when": "When changing src/flask/testing.py"
      },
      {
        "path": "docs/contributing.rst",
        "when": "When preparing a pull request"
      }
    ],
    "defaultBranch": "main",
    "description": "Flask is a Python WSGI web application framework distributed as the Flask package (requires Python >=3.11). It is used as a library and through its flask command line entry point, is built on Werkzeug, Jinja, Click, ItsDangerous, MarkupSafe and Blinker, is managed with uv and tox, and ships to PyPI.",
    "languages": [
      "python"
    ],
    "packageManager": "",
    "paths": {
      "docs": [
        "docs"
      ],
      "protected": [
        ".github",
        ".pre-commit-config.yaml",
        ".readthedocs.yaml",
        "uv.lock",
        "LICENSE.txt",
        "src/flask/sessions.py"
      ],
      "source": [
        "src/flask"
      ],
      "tests": [
        "tests"
      ]
    },
    "readme": "README.md",
    "root": "<APP>"
  },
