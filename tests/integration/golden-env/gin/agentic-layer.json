{
  "adws": [
    {
      "agent": "codex",
      "changes": "codebase",
      "classes": [],
      "description": "Classify the issue, plan by class, implement the plan",
      "environment": [
        "worktree"
      ],
      "input": [
        "issue"
      ],
      "name": "plan-build",
      "review": "human",
      "steps": [
        {
          "agent": "",
          "args": [
            "$prompt"
          ],
          "command": "classify",
          "kind": "run",
          "modelSet": "inherit",
          "name": "classify",
          "retries": 0,
          "when": "always"
        },
        {
          "agent": "",
          "args": [
            "$prompt"
          ],
          "command": "plan-chore",
          "kind": "run",
          "modelSet": "inherit",
          "name": "plan-chore",
          "retries": 0,
          "when": "class-chore"
        },
        {
          "agent": "",
          "args": [
            "$prompt"
          ],
          "command": "plan-bug",
          "kind": "run",
          "modelSet": "inherit",
          "name": "plan-bug",
          "retries": 0,
          "when": "class-bug"
        },
        {
          "agent": "",
          "args": [
            "$prompt"
          ],
          "command": "plan-feature",
          "kind": "run",
          "modelSet": "inherit",
          "name": "plan-feature",
          "retries": 0,
          "when": "class-feature"
        },
        {
          "agent": "",
          "args": [
            "$prompt"
          ],
          "command": "plan-patch",
          "kind": "run",
          "modelSet": "inherit",
          "name": "plan-patch",
          "retries": 0,
          "when": "class-patch"
        },
        {
          "agent": "",
          "args": [
            "$plan"
          ],
          "command": "run-plan",
          "kind": "run",
          "modelSet": "inherit",
          "name": "build",
          "retries": 0,
          "when": "always"
        }
      ],
      "trigger": [
        "forge-actions",
        "manual"
      ]
    },
    {
      "agent": "codex",
      "changes": "codebase",
      "classes": [],
      "description": "Plan, build, vet, test, document, commit; a human reviews the pull request",
      "environment": [
        "worktree",
        "podman"
      ],
      "input": [
        "issue"
      ],
      "name": "sdlc",
      "review": "human",
      "steps": [
        {
          "agent": "",
          "args": [
            "$prompt"
          ],
          "command": "classify",
          "kind": "run",
          "modelSet": "inherit",
          "name": "classify",
          "retries": 0,
          "when": "always"
        },
        {
          "agent": "",
          "args": [
            "$prompt"
          ],
          "command": "plan-chore",
          "kind": "run",
          "modelSet": "inherit",
          "name": "plan-chore",
          "retries": 0,
          "when": "class-chore"
        },
        {
          "agent": "",
          "args": [
            "$prompt"
          ],
          "command": "plan-bug",
          "kind": "run",
          "modelSet": "inherit",
          "name": "plan-bug",
          "retries": 0,
          "when": "class-bug"
        },
        {
          "agent": "",
          "args": [
            "$prompt"
          ],
          "command": "plan-feature",
          "kind": "run",
          "modelSet": "inherit",
          "name": "plan-feature",
          "retries": 0,
          "when": "class-feature"
        },
        {
          "agent": "",
          "args": [
            "$prompt"
          ],
          "command": "plan-patch",
          "kind": "run",
          "modelSet": "inherit",
          "name": "plan-patch",
          "retries": 0,
          "when": "class-patch"
        },
        {
          "agent": "",
          "args": [
            "$plan"
          ],
          "command": "run-plan",
          "kind": "run",
          "modelSet": "inherit",
          "name": "build",
          "retries": 0,
          "when": "always"
        },
        {
          "cmd": "lint",
          "collect": [],
          "forbidSkipReason": "",
          "in": "",
          "kind": "check",
          "maxSkipped": -1,
          "name": "lint",
          "resolve": "resolve-test",
          "retries": 3,
          "whenAffected": false
        },
        {
          "cmd": "test",
          "collect": [
            "coverage",
            "log"
          ],
          "forbidSkipReason": "",
          "in": "",
          "kind": "check",
          "maxSkipped": -1,
          "name": "test",
          "resolve": "resolve-test",
          "retries": 3,
          "whenAffected": false
        },
        {
          "agent": "",
          "args": [
            "$plan"
          ],
          "command": "document",
          "kind": "run",
          "modelSet": "inherit",
          "name": "document",
          "retries": 0,
          "when": "always"
        },
        {
          "agent": "",
          "args": [],
          "command": "commit",
          "kind": "run",
          "modelSet": "inherit",
          "name": "commit",
          "retries": 0,
          "when": "always"
        },
        {
          "implement": "",
          "kind": "review",
          "name": "review",
          "patch": ""
        },
        {
          "kind": "ship",
          "message": "",
          "name": "ship"
        }
      ],
      "trigger": [
        "forge-actions",
        "manual"
      ]
    }
  ],
  "agents": [
    {
      "id": "codex",
      "kind": "codex",
      "models": [
        {
          "effort": "default",
          "model": "gpt-5.4-mini",
          "tier": "base"
        },
        {
          "effort": "default",
          "model": "gpt-5.4",
          "tier": "heavy"
        }
      ],
      "sandbox": "workspace-write",
      "status": "stable",
      "timeout": 9000
    }
  ],
  "artefacts": [
    {
      "id": "log",
      "kind": "log",
      "status": "stable",
      "tailLines": 200
    },
    {
      "glob": "coverage.out",
      "id": "coverage",
      "kind": "coverage",
      "status": "stable"
    }
  ],
  "budget": null,
  "codebase": {
    "commands": [
      {
        "always": true,
        "covers": [],
        "description": "go vet reports nothing for all packages except /examples/",
        "name": "lint",
        "reuse": true,
        "run": "make vet",
        "timeout": 1800
      },
      {
        "always": true,
        "covers": [],
        "description": "rewrites every *.go file with gofmt -s -w; proves nothing, it changes files",
        "name": "format",
        "reuse": true,
        "run": "make fmt",
        "timeout": 1800
      },
      {
        "always": true,
        "covers": [],
        "description": "tests of packages gin, ginS, binding, render pass with go test -v -covermode=count; writes coverage.out",
        "name": "test",
        "reuse": true,
        "run": "make test",
        "timeout": 1800
      }
    ],
    "conditionalDocs": [
      {
        "path": "docs/doc.md",
        "when": "When adding or changing a feature (it must be documented there), or when working with the build tags jsoniter, go_json, sonic, nomsgpack"
      },
      {
        "path": "CONTRIBUTING.md",
        "when": "When preparing a pull request"
      },
      {
        "path": ".github/PULL_REQUEST_TEMPLATE.md",
        "when": "When writing a pull request description"
      },
      {
        "path": "ginS/README.md",
        "when": "When changing anything under ginS/"
      },
      {
        "path": "BENCHMARKS.md",
        "when": "When changing router performance in tree.go"
      },
      {
        "path": "CHANGELOG.md",
        "when": "When checking in which release a feature or fix shipped"
      }
    ],
    "defaultBranch": "master",
    "description": "Gin is an HTTP web framework written in Go, imported by other Go programs as the module github.com/gin-gonic/gin. Root package gin (router, context, middleware) plus sub-packages binding, render, codec/json, ginS and internal. Shipped by pushing a git tag, which runs GoReleaser in GitHub Actions.",
    "languages": [
      "go"
    ],
    "packageManager": "",
    "paths": {
      "docs": [
        "docs"
      ],
      "protected": [
        ".github",
        ".goreleaser.yaml",
        ".golangci.yml",
        "codecov.yml",
        "LICENSE",
        "auth.go",
        "testdata/certificate",
        "testdata/protoexample/test.pb.go"
      ],
      "source": [
        ".",
        "binding",
        "render",
        "codec/json",
        "internal/bytesconv",
        "internal/fs",
        "ginS"
      ],
      "tests": [
        ".",
        "binding",
        "render",
        "internal/bytesconv",
        "internal/fs",
        "ginS",
        "testdata"
      ]
    },
    "readme": "README.md",
    "root": "<APP>"
  },
