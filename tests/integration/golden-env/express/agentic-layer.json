{
  "adws": [
    {
      "agent": "claude-code",
      "changes": "codebase",
      "classes": [],
      "description": "Classify, plan by class and implement the plan",
      "environment": [
        "worktree",
        "home-manager"
      ],
      "input": [
        "tasklist",
        "voice"
      ],
      "name": "plan-build",
      "review": "agent",
      "steps": [
        {
          "agent": "",
          "args": [
            "$prompt"
          ],
          "command": "classify",
          "kind": "run",
          "modelSet": "inherit",
          "name": "classify",
          "retries": 0,
          "when": "always"
        },
        {
          "agent": "",
          "args": [
            "$prompt"
          ],
          "command": "plan-chore",
          "kind": "run",
          "modelSet": "inherit",
          "name": "plan-chore",
          "retries": 0,
          "when": "class-chore"
        },
        {
          "agent": "",
          "args": [
            "$prompt"
          ],
          "command": "plan-bug",
          "kind": "run",
          "modelSet": "inherit",
          "name": "plan-bug",
          "retries": 0,
          "when": "class-bug"
        },
        {
          "agent": "",
          "args": [
            "$prompt"
          ],
          "command": "plan-feature",
          "kind": "run",
          "modelSet": "inherit",
          "name": "plan-feature",
          "retries": 0,
          "when": "class-feature"
        },
        {
          "agent": "",
          "args": [
            "$plan"
          ],
          "command": "implement",
          "kind": "run",
          "modelSet": "inherit",
          "name": "build",
          "retries": 0,
          "when": "always"
        }
      ],
      "trigger": [
        "voice",
        "file-watch",
        "manual"
      ]
    },
    {
      "agent": "claude-code",
      "changes": "codebase",
      "classes": [],
      "description": "Plan, build, lint, test, document, commit, agent review; a human merges",
      "environment": [
        "worktree",
        "home-manager"
      ],
      "input": [
        "tasklist",
        "voice"
      ],
      "name": "sdlc",
      "review": "agent",
      "steps": [
        {
          "agent": "",
          "args": [
            "$prompt"
          ],
          "command": "classify",
          "kind": "run",
          "modelSet": "inherit",
          "name": "classify",
          "retries": 0,
          "when": "always"
        },
        {
          "agent": "",
          "args": [
            "$prompt"
          ],
          "command": "plan-chore",
          "kind": "run",
          "modelSet": "inherit",
          "name": "plan-chore",
          "retries": 0,
          "when": "class-chore"
        },
        {
          "agent": "",
          "args": [
            "$prompt"
          ],
          "command": "plan-bug",
          "kind": "run",
          "modelSet": "inherit",
          "name": "plan-bug",
          "retries": 0,
          "when": "class-bug"
        },
        {
          "agent": "",
          "args": [
            "$prompt"
          ],
          "command": "plan-feature",
          "kind": "run",
          "modelSet": "inherit",
          "name": "plan-feature",
          "retries": 0,
          "when": "class-feature"
        },
        {
          "agent": "",
          "args": [
            "$plan"
          ],
          "command": "implement",
          "kind": "run",
          "modelSet": "inherit",
          "name": "build",
          "retries": 0,
          "when": "always"
        },
        {
          "cmd": "lint",
          "collect": [],
          "forbidSkipReason": "",
          "in": "",
          "kind": "check",
          "maxSkipped": -1,
          "name": "lint",
          "resolve": "resolve-test",
          "retries": 3,
          "whenAffected": false
        },
        {
          "cmd": "test",
          "collect": [
            "log",
            "coverage"
          ],
          "forbidSkipReason": "",
          "in": "",
          "kind": "check",
          "maxSkipped": -1,
          "name": "test",
          "resolve": "resolve-test",
          "retries": 3,
          "whenAffected": false
        },
        {
          "agent": "",
          "args": [
            "$plan"
          ],
          "command": "document",
          "kind": "run",
          "modelSet": "inherit",
          "name": "document",
          "retries": 0,
          "when": "always"
        },
        {
          "agent": "",
          "args": [],
          "command": "commit",
          "kind": "run",
          "modelSet": "inherit",
          "name": "commit",
          "retries": 0,
          "when": "always"
        },
        {
          "implement": "implement",
          "kind": "review",
          "name": "review",
          "patch": "plan-patch"
        },
        {
          "kind": "ship",
          "message": "",
          "name": "ship"
        }
      ],
      "trigger": [
        "voice",
        "file-watch",
        "manual"
      ]
    },
    {
      "agent": "claude-code",
      "changes": "codebase",
      "classes": [],
      "description": "Read-only: answer a spoken question about the codebase",
      "environment": [
        "host"
      ],
      "input": [
        "voice"
      ],
      "name": "ask",
      "review": "agent",
      "steps": [
        {
          "agent": "",
          "args": [
            "$prompt"
          ],
          "command": "question",
          "kind": "run",
          "modelSet": "inherit",
          "name": "answer",
          "retries": 0,
          "when": "always"
        }
      ],
      "trigger": [
        "voice",
        "manual"
      ]
    }
  ],
  "agents": [
    {
      "allowedTools": [
        "Read",
        "Glob",
        "Grep",
        "Edit",
        "Write",
        "Bash"
      ],
      "id": "claude-code",
      "kind": "claude-code",
      "maxTurns": 600,
      "models": [
        {
          "effort": "default",
          "model": "claude-opus-5-5",
          "tier": "base"
        },
        {
          "effort": "default",
          "model": "claude-opus-5-5",
          "tier": "heavy"
        }
      ],
      "permissionMode": "acceptEdits",
      "safeMode": true,
      "status": "stable",
      "timeout": 9000
    }
  ],
  "artefacts": [
    {
      "id": "log",
      "kind": "log",
      "status": "stable",
      "tailLines": 200
    },
    {
      "glob": "coverage/lcov.info",
      "id": "coverage",
      "kind": "coverage",
      "status": "stable"
    }
  ],
  "budget": null,
  "codebase": {
    "commands": [
      {
        "always": true,
        "covers": [],
        "description": "dependencies and devDependencies resolve and install into node_modules",
        "name": "install",
        "reuse": true,
        "run": "npm install",
        "timeout": 1800
      },
      {
        "always": true,
        "covers": [],
        "description": "eslint reports no violation of .eslintrc.yml in any JavaScript file of the repository",
        "name": "lint",
        "reuse": true,
        "run": "npm run lint",
        "timeout": 1800
      },
      {
        "always": true,
        "covers": [],
        "description": "the whole mocha suite (test/ and test/acceptance/) passes with global-leak checking, under nyc, writing coverage/lcov.info and a text coverage table to stdout",
        "name": "test",
        "reuse": true,
        "run": "npm run test-ci",
        "timeout": 1800
      },
      {
        "always": true,
        "covers": [],
        "description": "the whole mocha suite (test/ and test/acceptance/) passes with global-leak checking, without coverage",
        "name": "test-fast",
        "reuse": true,
        "run": "npm test",
        "timeout": 1800
      }
    ],
    "conditionalDocs": [
      {
        "path": "examples/README.md",
        "when": "When adding, renaming or removing a directory under examples/"
      },
      {
        "path": "History.md",
        "when": "When a change alters behaviour that an earlier release entry describes"
      }
    ],
    "defaultBranch": "master",
    "description": "express is a web framework for Node.js, published to the npm registry as the package express and consumed through require('express'). CommonJS JavaScript with no build step: index.js re-exports lib/express.js. Tested with mocha and supertest, linted with eslint 8, published to npm by a GitHub Actions workflow when a GitHub release is published.",
    "languages": [
      "javascript"
    ],
    "packageManager": "npm install",
    "paths": {
      "docs": [],
      "protected": [
        ".github",
        "LICENSE",
        ".npmrc"
      ],
      "source": [
        "lib",
        "index.js"
      ],
      "tests": [
        "test"
      ]
    },
    "readme": "Readme.md",
    "root": "<APP>"
  },
  "commands": [
    {
      "description": "",
      "fabric": [],
      "file": "",
      "focus": [],
      "mayCommit": false,
      "modelSet": "base",
      "name": "prime",
      "output": "text",
      "relevant": [],
      "template": "prime",
      "validation": []
