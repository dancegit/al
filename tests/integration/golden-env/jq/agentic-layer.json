  "agents": [
    {
      "allowedTools": [
        "Read",
        "Glob",
        "Grep",
        "Edit",
        "Write",
        "Bash"
      ],
      "id": "claude-code",
      "kind": "claude-code",
      "maxTurns": 600,
      "models": [
        {
          "effort": "default",
          "model": "claude-opus-5-5",
          "tier": "base"
        },
        {
          "effort": "default",
          "model": "claude-opus-5-5",
          "tier": "heavy"
        }
      ],
      "permissionMode": "acceptEdits",
      "safeMode": true,
      "status": "stable",
      "timeout": 9000
    }
  ],
  "artefacts": [
    {
      "id": "log",
      "kind": "log",
      "status": "stable",
      "tailLines": 200
    },
    {
      "glob": "test-suite.log",
      "id": "test-suite-log",
      "kind": "file",
      "status": "stable"
    },
    {
      "glob": "tests/*.log",
      "id": "test-logs",
      "kind": "file",
      "status": "stable"
    }
  ],
  "budget": null,
  "codebase": {
    "commands": [
      {
        "always": true,
        "covers": [],
        "description": "The build system is generated and configured against the system Oniguruma (libonig-dev); the vendor/oniguruma submodule is not fetched, because a run's container mounts the repository's .git read-only and git submodule update cannot register it; must run once in a fresh checkout before build or test",
        "name": "install",
        "reuse": true,
        "run": "autoreconf -i && ./configure --disable-docs --with-oniguruma=yes --enable-static",
        "timeout": 1800
      },
      {
        "always": true,
        "covers": [],
        "description": "libjq and the jq binary compile and link with -Wextra -Wall",
        "name": "build",
        "reuse": true,
        "run": "make -j\"$(nproc)\"",
        "timeout": 1800
      },
      {
        "always": true,
        "covers": [],
        "description": "Every driver in TESTS of Makefile.am passes against the built ./jq; writes test-suite.log and tests/*.log",
        "name": "test",
        "reuse": true,
        "run": "make check VERBOSE=yes",
        "timeout": 1800
      },
      {
        "always": true,
        "covers": [],
        "description": "The website renders from docs/content into docs/output/",
        "name": "docs",
        "reuse": true,
        "run": "(cd docs && pipenv sync && pipenv run python3 build_website.py)",
        "timeout": 1800
      }
    ],
    "conditionalDocs": [
      {
        "path": "docs/README.md",
        "when": "When changing anything under docs/, or regenerating jq.1.prebuilt, tests/man.test or tests/manonig.test"
      },
      {
        "path": "docs/content/manual/dev/manual.yml",
        "when": "When adding or changing a builtin, operator or command-line option"
      },
      {
        "path": "docs/manual_schema.yml",
        "when": "When editing any manual.yml"
      },
      {
        "path": "tests/setup",
        "when": "When adding or changing a test driver script under tests/"
      },
      {
        "path": ".github/workflows/ci.yml",
        "when": "When changing configure options or cross-compilation behaviour"
      },
      {
        "path": "NEWS.md",
        "when": "When a change is user-visible and belongs in release notes"
      },
      {
        "path": "SECURITY.md",
        "when": "When the task concerns a security vulnerability"
      }
    ],
    "defaultBranch": "master",
    "description": "jq is a command-line JSON processor and the C library libjq, written in portable C with no runtime dependencies. It is built with GNU autotools (autoconf, automake, libtool) and optionally links the vendored Oniguruma regex library (git submodule). The manual and website are generated from YAML with Python.",
    "languages": [
      "c",
      "shell",
      "python"
    ],
    "packageManager": "",
    "paths": {
      "docs": [
        "docs",
        "README.md",
        "NEWS.md"
      ],
      "protected": [
        ".github",
        "Dockerfile",
        "COPYING",
        "SECURITY.md",
        "KEYS",
        "sig",
        "scripts/version",
        "jq.spec",
        "vendor",
        ".gitmodules",
        "src/lexer.c",
        "src/lexer.h",
        "src/parser.c",
        "src/parser.h",
        "tests/man.test",
        "tests/manonig.test",
        "jq.1.prebuilt",
        "docs/Pipfile.lock",
        "docs/public/CNAME"
      ],
      "source": [
        "src",
        "Makefile.am",
        "configure.ac",
        "config/m4",
        "m4",
        "scripts"
      ],
      "tests": [
        "tests"
      ]
    },
    "readme": "README.md",
    "root": "<APP>"
  },
