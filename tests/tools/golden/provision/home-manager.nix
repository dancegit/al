# Generated by al from agentic.rkt — do not edit.
# Home Manager module for a machine of kind `server` that runs the notes agentic layer.
# It holds no host name, user or path: `al deploy --as server --provision` writes a host-local
# ~/.config/al/notes/home.nix that imports this file and sets `checkout`; import that file from
# your Home Manager configuration.
#
# Prerequisites it cannot set for a user: subuid/subgid ranges, newuidmap/newgidmap and lingering.
# nixos.nix of this directory sets them on NixOS, provision.sh on Debian/Ubuntu, Fedora and Arch;
# lingering alone: sudo loginctl enable-linger "$USER".
{ config, lib, pkgs, ... }:
let
  cfg = config.services."al-notes";
in {
  options.services."al-notes" = {
    enable = lib.mkEnableOption "the notes agentic layer on this machine";
    checkout = lib.mkOption {
      type = lib.types.str;
      description = "The repository checkout al deploy keeps up to date on this machine.";
    };
    layerDir = lib.mkOption {
      type = lib.types.str;
      default = "${cfg.checkout}/agentic";
      description = "Directory of the agentic layer inside the checkout.";
    };
    envFile = lib.mkOption {
      type = lib.types.str;
      default = "%h/.config/al/notes.env";
      description = "KEY=VALUE file with the layer's secrets (names in agentic.rkt, values only on this machine).";
    };
    dashboardPort = lib.mkOption {
      type = lib.types.port;
      default = 8770;
      description = "Port of the dashboard on 127.0.0.1.";
    };
  };

  config = lib.mkIf cfg.enable {
    # claude-code is unfree: allow it, e.g. nixpkgs.config.allowUnfreePredicate = p: builtins.elem (lib.getName p) [ "claude-code" ];
    home.packages = with pkgs; [ git uv podman claude-code ];
    systemd.user.services."al-notes-cron" = {
      Unit.Description = "Agentic layer cron trigger for notes";
      Service.ExecStart = "${pkgs.uv}/bin/uv run ${cfg.layerDir}/adws/triggers/trigger_cron.py";
      Service.Environment = "PATH=${config.home.profileDirectory}/bin:/run/wrappers/bin:/usr/bin:/bin";
      Service.EnvironmentFile = "-${cfg.envFile}";
      Service.Restart = "on-failure";
      Service.RestartSec = 10;
      Install.WantedBy = [ "default.target" ];
    };
    systemd.user.services."al-notes-dashboard" = {
      Unit.Description = "Work dashboard of the notes agentic layer (127.0.0.1:8770/)";
      Service.ExecStart = "${pkgs.uv}/bin/uv run ${cfg.layerDir}/adws/dashboard.py --bind 127.0.0.1 --port ${toString cfg.dashboardPort}";
      Service.Environment = "PATH=${config.home.profileDirectory}/bin:/run/wrappers/bin:/usr/bin:/bin";
      Service.EnvironmentFile = "-${cfg.envFile}";
      Service.Restart = "on-failure";
      Service.RestartSec = 5;
      Install.WantedBy = [ "default.target" ];
    };
  };
}
