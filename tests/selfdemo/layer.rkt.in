#lang al
;; Agentic layer for the Notes demo app, CHECKED IN with it: <repo>/agentic/agentic.rkt.
;; tests/selfdemo/selfdemo_live.sh fills in @FORGE_HOST@ (the throwaway Forgejo), commits this
;; directory with the app and pushes both. It is tests/webdemo/layer.rkt.in with two differences:
;; the placement (layer in-repo) and the codebase root (".." = the repository root).
;; The container image is the one the web demo builds: al-notes-demo:latest.
(agentic-layer #:name "notes-demo" #:description "Agentic layer for the Notes demo web app"
  (codebase #:root ".." #:languages (python html css javascript) #:default-branch "main"
            #:description "Notes is a one-page Flask web app: a list of notes kept in memory and a form to add one. app.py holds create_app() and the routes, templates/index.html is the only page, static/style.css holds all styling. tests/test_app.py has pytest unit tests using the Flask test client; e2e/capture.py walks the user scenario in e2e/scenario.py in headless Chromium and records screenshots and a video into e2e-results/."
            #:readme "README.md" #:package-manager "pip (requirements.txt; the container image already has every dependency)"
    (cmd test "python -m pytest -q tests" #:timeout 300
         #:description "The pytest unit tests in tests/ pass (Flask test client, no browser).")
    (cmd e2e "python e2e/capture.py" #:timeout 600
         #:description "The scenario in e2e/scenario.py passes in headless Chromium with no console errors; writes e2e-results/NN-<name>.png per screenshot step and e2e-results/session.webm.")
    (paths #:source ("app.py" "templates" "static") #:tests ("tests" "e2e") #:docs ("README.md")
           #:protected ("e2e/capture.py" "requirements.txt" ".gitignore")))

  (layer in-repo #:dir "agentic")
  (forge forgejo #:host "@FORGE_HOST@" #:repo "adw/notes" #:token-env "AL_WEBDEMO_FORGEJO_TOKEN")
  (agent claude-code #:id claude-sandboxed #:model-base "claude-opus-5-5" #:model-heavy "claude-opus-5-5"
         #:permission-mode bypassPermissions #:max-turns 80)
  (prompt-input issue #:labels () #:classify #f)
  (trigger manual)

  (environment worktree)
  (environment podman #:base-image "docker.io/library/python:3.12-slim" #:packages ("git" "curl" "ca-certificates" "libatomic1")
               #:setup ("pip install --no-cache-dir 'flask>=3.1,<4' 'pytest>=8,<9' 'playwright>=1.49,<2'"
                        "PLAYWRIGHT_BROWSERS_PATH=/opt/pw playwright install --with-deps --only-shell chromium && PLAYWRIGHT_BROWSERS_PATH=/opt/pw playwright install ffmpeg && chmod -R a+rX /opt/pw"
                        "HOME=/opt/claude bash -c 'curl -fsSL https://claude.ai/install.sh | bash' && chmod -R a+rX /opt/claude && ln -s /opt/claude/.local/bin/claude /usr/local/bin/claude")
               #:memory "4g" #:cpus "2" #:agent-inside #t #:credentials (claude))

  (artefact log #:tail-lines 60)
  (artefact image #:id screenshots #:glob "e2e-results/*.png" #:max-files 12)
  (artefact video #:id recording #:glob "e2e-results/*.webm" #:keyframes 8)

  (review human)
  (review auto #:id zero-touch #:reviewers 2 #:artefacts (log screenshots recording) #:ship merge
          #:require-checks (test e2e) #:allowed-classes (chore bug feature) #:max-diff-lines 600
          #:block-protected-paths #t)

  (command plan-chore #:template plan-chore #:model-set heavy #:output path #:validation (test e2e)
           #:focus ("Colours, spacing and layout live in static/style.css only; the markup is templates/index.html; routes are in app.py."
                    "Every user-visible change must be demonstrated in e2e/scenario.py so the screenshots and the video show it: plan the scenario steps and their expect entries (a visual change gets a 'style' expectation on the computed CSS value, e.g. background-color as rgb(...))."
                    "When an existing expectation in e2e/scenario.py or tests/ describes the old behaviour that the request deliberately changes, update it to the new behaviour; never delete or loosen an expectation for anything else."
                    "e2e/capture.py is the test harness and a protected path: never plan a change to it; its step and expect vocabulary is documented at the top of e2e/scenario.py."
                    "Keep text readable: every text colour on a changed background must keep a contrast ratio of at least 4.5:1."))
  (command plan-feature #:template plan-feature #:model-set heavy #:output path #:validation (test e2e)
           #:focus ("Routes are in app.py, the page is templates/index.html, styling is static/style.css; a small amount of JavaScript goes in static/app.js loaded by the template with defer; no build step and no new dependency."
                    "Every user-visible behaviour of the feature must be demonstrated in e2e/scenario.py so the screenshots and the video show it: add steps (use 'type' so typing is visible in the video), an expect entry per behaviour, and a 'screenshot' for each visible state, including empty and edge states."
                    "New unit tests go into tests/test_app.py, using the client fixture."
                    "Never delete or loosen an existing expectation in tests/ or e2e/scenario.py."
                    "e2e/capture.py is the test harness and a protected path: never plan a change to it; its step and expect vocabulary is documented at the top of e2e/scenario.py."
                    "The page must log no console errors: e2e/capture.py fails on any."))
  (command resolve-test #:template resolve-test #:model-set heavy
           #:focus ("Fix the app, not the expectation: never delete or loosen an expectation in tests/ or e2e/scenario.py, and never edit e2e/capture.py."
                    "The e2e log names the failing step and expectation; a FAILED screenshot of that moment is in e2e-results/."))
  (command review #:template review #:model-set heavy #:output json
           #:focus ("Every path in ARTEFACT_MANIFEST (each entry's path and each keyframe's path) is relative to the layer directory ${layer_dir}: open it as ${layer_dir}/<path> with the Read tool, which displays images."
                    "Every user-visible requirement must be visible in an e2e screenshot (screenshots) or in a keyframe of the session video (recording); name the file that shows it. A user-visible change that e2e/scenario.py does not demonstrate is a blocker."
                    "Deleted or loosened expectations in tests/ or e2e/scenario.py are a blocker, except where the request deliberately changes the behaviour the expectation described."
                    "List every screenshot, every keyframe and every log you opened in artefacts_reviewed."))
  (command commit #:template commit
           #:focus ("A commit message is one imperative summary line under 72 characters, e.g. 'Add a search box that filters the notes'."))
  (hop implement #:template run-plan #:takes plan)

  (adw ui-change #:description "Plan, build, unit tests, e2e capture, commit; a human reviews the pull request with the screenshots"
       #:input (issue) #:trigger (manual) #:environment (worktree podman) #:review human #:agent claude-sandboxed
    (steps
      (run plan-chore #:command plan-chore #:args ("$prompt") #:when class-chore)
      (run plan-feature #:command plan-feature #:args ("$prompt") #:when class-feature)
      (run build #:command implement #:args ("$plan"))
      (check test #:cmd test #:resolve resolve-test #:retries 2 #:collect (log))
      (check e2e #:cmd e2e #:resolve resolve-test #:retries 2 #:collect (log screenshots recording))
      (run commit #:command commit)
      (review)
      (ship)))

  (adw feature #:description "Zero-touch: plan, build, unit tests, e2e capture, two agent reviewers with screenshots and video keyframes, merge"
       #:input (issue) #:trigger (manual) #:environment (worktree podman) #:review zero-touch #:agent claude-sandboxed
       #:classes (chore bug feature)
    (steps
      (run plan-chore #:command plan-chore #:args ("$prompt") #:when class-chore)
      (run plan-feature #:command plan-feature #:args ("$prompt") #:when class-feature)
      (run build #:command implement #:args ("$plan"))
      (check test #:cmd test #:resolve resolve-test #:retries 2 #:collect (log))
      (check e2e #:cmd e2e #:resolve resolve-test #:retries 2 #:collect (log screenshots recording))
      (run commit #:command commit)
      (review)
      (ship))))
