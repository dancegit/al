+def test_workers_page_marks_expired_registrations(manager):
+    text = page(manager.get("/workers"))
+    assert text.count('<span class="badge badge-expired">Expired</span>') == 1
+    row = text.split('id="worker-3"', 1)[1].split("</tr>", 1)[0]
+    assert "Expired" in row   # Chloe Martin, registration expired 2026-02-14
+    for worker_id in (1, 2, 4, 5):
+        assert "Expired" not in text.split(f'id="worker-{worker_id}"', 1)[1].split("</tr>", 1)[0]
+
+
 def test_worker_sees_my_shifts_and_cannot_open_workers(worker):
