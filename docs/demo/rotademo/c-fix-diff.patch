+def with_registration_status(workers: list[dict[str, Any]], today: date) -> list[dict[str, Any]]:
+    """Copies of the workers with a registration_expired flag, for the pages (not part of the API)."""
+    return [{**worker, "registration_expired": rules.registration_expired(to_rule_worker(worker), today)}
+            for worker in workers]
+
+
+def candidates(scope: Scope, shift: dict[str, Any], today: date) -> list[dict[str, Any]]:
+    """Workers offered in the shift's assign dropdown: the organisation's workers with the right role.
+
+    Expired workers are still listed, marked registration_expired, so the page can show them as unavailable.
+    """
+    return with_registration_status(scope.workers_with_role(shift["role_required"]), today)
 
 
