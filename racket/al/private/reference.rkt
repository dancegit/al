#lang racket/base

;; Registry → the LLM-facing reference for #lang al (docs/AL-DSL.llms.txt).
;; This file is what an LLM reads, together with a codebase's LLM.txt, to author agentic.rkt.

(require racket/list racket/string racket/port racket/runtime-path "meta.rkt" "vocab.rkt")
(provide reference-text)

(define-runtime-path examples-dir "../examples")

(define (show-type t)
  (cond [(symbol? t) (symbol->string t)]
        [(eq? (car t) 'enum) (string-join (map symbol->string (cdr t)) " | ")]
        [(eq? (car t) 'list-of) (format "list of ~a" (show-type (cadr t)))]
        [(eq? (car t) 'ref) (format "name of a declared ~a" (cadr t))]
        [(eq? (car t) 'optional-ref) (format "name of a declared ~a, or \"\"" (cadr t))]))

(define (show-default f)
  (cond [(field-required? f) "REQUIRED"]
        [(eq? (field-default f) '#:first) "the first declared option of that family"]
        [else (format "~s" (field-default f))]))

(define (field-lines fields)
  (for/list ([f (in-list fields)])
    (format "  - `~a` (~a; default ~a) — ~a"
            (field-keyword f) (show-type (field-type f)) (show-default f) (field-doc f))))

(define (reference-text)
  (define out (open-output-string))
  (define (p . xs) (for ([x xs]) (write-string x out)) (newline out))
  (p "# #lang al — agentic layer DSL reference")
  (p)
  (p "> Generated from racket/al/private/vocab.rkt. Do not edit. This is the complete language:")
  (p "> anything not listed here does not exist and will be rejected by the compiler.")
  (p)
  (p "## Shape of a file")
  (p)
  (p "```racket")
  (p "#lang al")
  (p "(agentic-layer #:name \"repo-name\" #:description \"…\" #:llm-txt \"LLM.txt\"")
  (p "  (codebase #:root \"…\" #:languages (…) (cmd NAME \"shell\") … (paths …) (conditional-doc \"path\" \"when\") …)")
  (p "  (FAMILY KIND #:id ID #:field value …) …   ; options, see families below")
  (p "  (command NAME #:template T …) …")
  (p "  (hop NAME #:template T …) …")
  (p "  (expert NAME …) …")
  (p "  (adw NAME #:input (…) #:trigger (…) #:environment (…) #:review ID #:agent ID")
  (p "    (steps (run NAME …) (check NAME …) (review) (ship) (compose ADW) …)) …)")
  (p "```")
  (p)
  (p "Syntax notes: strings use double quotes; names are bare symbols; lists are parenthesised without")
  (p "quotes or commas, e.g. `(python rust)` or `(\"src\" \"tests\")`; booleans are `#t` / `#f`; exactly one")
  (p "`(agentic-layer …)` form per file. Every field is `#:keyword value`. Omitted fields take the default.")
  (p "Families with a default kind may be omitted entirely. `(cmd NAME \"shell\" …)` and")
  (p "`(conditional-doc \"path\" \"when\")` take their first values positionally, exactly as shown.")
  (p)
  (p "## Rules the compiler enforces")
  (p)
  (for ([r (in-list semantic-rules)]) (p "- " r))
  (p)
  (p "## Option families")
  (for ([fam (in-list (all-families))])
    (p)
    (p (format "### `~a`~a" (family-name fam)
               (if (string=? (family-letter fam) "") "" (format " — PITER letter ~a" (family-letter fam)))))
    (p)
    (p (family-doc fam))
    (p (format "~a Default when omitted: ~a."
               (if (memq (family-name fam) singleton-families) "Declare at most one." "Declare any number.")
               (if (family-default-kind fam) (format "`(~a ~a)`" (family-name fam) (family-default-kind fam)) "none")))
    (for ([k (in-list (family-kinds fam))])
      (p)
      (p (format "- **`(~a ~a …)`**~a — ~a" (family-name fam) (kind-name k)
                 (if (eq? (kind-status k) 'stable) "" (format " [~a]" (kind-status k)))
                 (kind-doc k)))
      (for ([l (field-lines (kind-fields k))]) (p l))))
  (p)
  (p "## Records")
  (for ([r (in-list (all-records))])
    (p)
    (p (format "### `~a`" (record-name r)))
    (p)
    (p (record-doc r))
    (for ([l (field-lines (record-fields r))]) (p l)))
  (p)
  (p "## Examples (both compile)")
  (for ([f (in-list '("minimal.rkt" "full.rkt"))])
    (define path (build-path examples-dir f))
    (when (file-exists? path)
      (p)
      (p (format "### ~a" f))
      (p)
      (p "```racket")
      (write-string (string-trim (call-with-input-file path port->string) #:left? #f) out)
      (newline out)
      (p "```")))
  (get-output-string out))
